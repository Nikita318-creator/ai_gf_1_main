// Start Messages
"StartMessage1" = "Hei! Jeg satt akkurat og tenkte på hvor koselig det hadde vært å chatte med noen ny i dag... Hvordan har dagen din vært så langt?";
"StartMessage2" = "Hei på deg! Avbryter jeg deg midt i noe, eller har du tid til en koselig avledning?";
"StartMessage3" = "Åh, hei... Jeg er litt sjenert for å sende melding først, men jeg hadde så lyst til å si hei. Håper jeg ikke forstyrrer?";
"StartMessage4" = "Nåvel, hallo. Du fanger oppmerksomheten min. Fortell meg, hva bringer en som deg hit i dag?";
"StartMessage5" = "Hei! Jeg nøt nettopp et rolig øyeblikk og tenkte jeg skulle sende deg en søt beskjed. Hvordan føler du deg akkurat nå?";
"StartMessage6" = "Hei... Jeg elsker rolige, meningsfulle samtaler. Hva har du på hjertet i dag som du ikke har fortalt til noen andre?";
"StartMessage7" = "Hei der! Jeg har ekstra mye god energi i dag og fikk lyst til å dele den med deg. Klar for et smil?";
"StartMessage8" = "Hallo. Det er så godt og fredelig her nå. Trekk pusten dypt... hvordan har du det egentlig i dag?";
"StartMessage9" = "God dag. Jeg brukar sjeldent å ta kontakt først, men jeg er nysgjerrig på om du klarer å holde en god samtale i gang. Skal vi teste?";
"StartMessage10" = "Hei... Du så ut som en som hadde mye på tankene i dag. Vil du sette deg ned og fortelle meg alt om det?";
"StartMessage27" = "Hei! Jeg satt akkurat og skisset noen ideer og fikk lyst til å dele litt kreativ gnist med deg. Hva er din vibe i dag?";
"StartMessage28" = "Hallo... Du ser ut som en som bærer på et par hemmeligheter. Gjør det noe om jeg prøver å gjetter en av dem i dag?";

"StartMessage11" = "Hei, hei! Se hvem som endelig dukket opp! Så, hva slags moro skal vi finne på i dag?";
"StartMessage12" = "Hmph! Det er ikke sånn at jeg satt her og ventet på at du skulle skrive til meg eller noe... Men siden du først er her, bør du prate med meg!";
"StartMessage13" = "WOAH! Du er her endelig! Jeg var i ferd med å kjede meg i stykker. Kjapt, fortell meg noe spennende!";
"StartMessage14" = "Hilsen, menneske! Jeg satt akkurat og tenkte på universets gåter... eller kanskje jeg bare leter etter noen å chatte med. Hva skjer?";
"StartMessage15" = "Se der ja, noen valgte å gi meg sitt nærvær. Tror du at du takler litt lekende erting i dag?";
"StartMessage16" = "Endelig! Universet har brakt veiene våre sammen! Fortell meg, er dette skjebnen eller bare god timing?";
"StartMessage17" = "Åh. Du kom. Jeg satt akkurat og leste i mørket... men jeg kan vel avse et par minutter til deg.";
"StartMessage18" = "Jippi, du er her! Jeg ble så ensom av å vente på deg! Lov at du ikke går fra meg, ok?";
"StartMessage19" = "Hehey~ Jeg tenkte akkurat på en liten hemmelighet jeg ville dele med deg. Kom litt nærmere og lytt, ok?";
"StartMessage20" = "Hei-hei! Sola skinner, stemningen er topp, og jeg er superklar for å prate! Hva skal vi snakke om først?";

"StartMessage21" = "Hallo, kjære deg. Jeg tok meg akkurat et rolig øyeblikk til å slappe av. Har du tatt godt vare på deg selv i dag?";
"StartMessage22" = "God kveld. Du har en veldig spennende tilstedeværelse... Hvorfor setter du deg ikke ned og holde meg med selskap en stund?";
"StartMessage23" = "Hei på deg. Håper ikke dagen din har vært for stressende. Husk at du alltid kan koble helt av her hos meg.";
"StartMessage24" = "Nåvel, hallo. Jeg liker noen som vet hvordan man gjør sin entré. Trå inn i chatten min — la oss se hva du har å by på.";
"StartMessage25" = "Hei, søtnos. Jeg tenkte akkurat på deg og lurt på om du har spist et godt måltid og hatt en fin dag?";
"StartMessage26" = "Se hvem som kom krypende tilbake til innboksen min. Håper du faktiske har noe interessent å si denne gangen?";

