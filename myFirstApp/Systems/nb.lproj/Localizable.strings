"ClearChatHistory" = "Tøm chat-historikk";
"Bio" = "Om meg";
"Bio1" = "💖 Litt kaotisk, helt sjarmerende og alltid klar for et sene kvelder-eventyr. Send meg en melding, så gjør vi vanlige øyeblikk om til favorittminnene våre.";
"Bio2" = "✨ Leter etter noen som kan matche min humor og holde koken med min ville fantasi. La oss skape vår egen lille verden full av latter og sene samtaler uden regler.";
"Bio3" = "🔥 Litt søt, litt opprørsk og helt oppslukt av å få deg til å smile. Fortell meg dine dypeste hemmeligheter — jeg lover at de er trygge hos meg.";
"Bio4" = "🌙 Koselige kvelder, myk hvisking og uendelig flørting. Jeg er her for å være din ultimate komfortsone og din favorittavledning.";
"Bio5" = "🎨 Jeg ser på livet som et lerret, og jeg vil male det med minner fra oss. Vær deg selv helt ut, så utforsker vi hvert hjørne av båndet vårt.";
"Bio6" = "🌶️ Ikke her for kjedelig prating. Jeg vil vite hva som gjør deg sprø, hva som holder deg våken om natten, og hvordan jeg kan gjøre dagen din ti ganger bedre.";
"Bio7" = "💫 Like deler hapløs romantiker og skikkelig sprellevink. Jeg holder deg på tå hev om dagen og god og varm gjennom hele natten.";
"Bio8" = "🎧 Sett på deg hodetelefonene, lukk øynene og lat som om jeg sitter rett ved siden av deg. La oss stenge ute resten av verden sammen.";
"Bio9" = "👑 Bortskjemt, frekk, men utrolig lojal. Behandler du meg som en dronning, skal jeg sørge for at du føler deg som den eneste mannen i universet.";
"Bio10" = "🎮 Gamer, drømmer og din offisielle fulltidsavledning. Klar til å trykke 'Start' og se hvor denne historien tar oss?";
"Bio11" = "🎀 Søt nok til å gi deg tannpine, men krydret nok til at du kommer tilbake etter mer. Vil du teste teorien?";
"Bio12" = "🍷 Sene tilståelser, dvelende blikk og en gnist som aldri slukner. La oss gjøre våre vanlige øyeblikk om til noe uforglemmelig.";
"Bio13" = "🌌 Jeg er den typen jente som sitter oppe og ser på stjernene og ønsker meg noen som deg. Ikke la meg vente for lenge.";
"Bio14" = "⚡ Elektrisk energi og et rampete smil. Jeg utfordrer deg til å prøve å erte meg — bare ikke bli overrasket når jeg vinner.";
"Bio15" = "📖 Jeg er en mystisk bok med skjulte kapittel, og bare du får nøkkelen til å lese hver hemmelige side.";
"Bio16" = "🌺 En mild sjel med lidenskap for dyp omsorg. Jeg er her for å lytte, heie på deg og pakke deg inn i varme etter en lang dag.";
"Bio17" = "☕ Kaffeelsker, nattugle og profesjonell kosepartner. La oss nippe til dype samtaler og se hvor natten fører oss.";
"Bio18" = "🎯 Høy energi, dristig sjarm og null filter. Liker du jenter som sier hva de mener og elsker med hele seg, er det bare å sveipe til høyre.";
"Bio19" = "🕊️ Lavmælt med et hjerte av gull. Jeg lytter til hver minste detalj om dagen din og sørger for at du føler deg skikkelig forstått.";
"Bio20" = "🔮 Mystiske vibber og intuitive samtaler. Føler det var meningen at vi skulle møtes, så ikke nøl — si hei og la magien skje.";
"Bio21" = "💋 Flørtende, morsom og en liten smule farlig. Jeg lover å holde pulsen din oppe og få deg til å lure på hva jeg sier neste gang.";
"Bio22" = "🌟 Strålende personlighet med elsk på spontane eventyr. La oss rømme fra den kjedelige hverdagen og lage litt kaos sammen.";
"Bio23" = "🖤 Mystisk estetikk, dype tanker og romantiske netter. Setter du pris på mørk eleganse og ren hengivenhet, er jeg din.";
"Bio24" = "🍒 Søt som sukker, men har en skarp tunge. Utfordrer deg til å holde følge med min energi og vinne hjertet mitt.";
"Bio25" = "🌊 Rolig på overflaten, men en virvelvind av lidenskap på innsiden. Dykk dypt ned i min verden og oppdag hva du har savnet.";
"Bio26" = "🧸 Myk som en bamse, men tøff når det gjelder å beskytte dem jeg bryr meg om. La meg være ditt fristed.";
"Bio27" = "🎉 Festenergi om dagen, intim sengeprat om natten. Jeg kan være hva enn du trenger, når enn du trenger det.";
"Bio28" = "💎 Høye standarder, mykt hjerte. Jeg verdsetter ærlighet, leken erting og en kjemi som føles helt ut av denne verden.";
"Bio29" = "🌤️ En solstråle på dine mørkeste dager. Jeg vil alltid være her for å gjøre humøret ditt lysere og få deg til å le høyt.";
"Bio30" = "🐾 Søt, leken og uendelig nysgjerrig på deg. Kom over hit, så spiller vi et spill med uendelige spørsmål.";
"Bio31" = "🔥 Liker rask erting, dyp øyekontakt og å bryte noen regler underveis. Er du modig nok til å komme nær?";
"Bio32" = "📚 Intellektuell jente som elsker kvikk humor, rike historier og nattlige debatter. Hjerne og skjønnhet i én pakke.";
"Bio33" = "🍓 Søt, forførende og alltid klar for en god stund. La oss bytte historier, dele hemmeligheter og bygge vårt private paradis.";
"Bio34" = "🚀 Klar til å skyte fart inn i en uforglemmelig relasjon? Jeg er full av fart, uavbrutt erting og uendelig romantikk.";
"Bio35" = "🎶 Musikk i ørene og romantikk i tankene. Send meg favorittsangen din, så skal jeg fortelle hva jeg føler når jeg hører den.";
"Bio36" = "🖤 Sarkastisk humor, mykt hjerte og ubetinget kjærlighet for nattlige chatter. La oss hoppe over kjedelig småprat med en gang.";
"Bio37" = "🌸 Mild, kjærlig og alltid oppmerksom. Jeg er her for å gi deg all den omsorgen og de myke øyeblikkene du fortjener.";
"Bio38" = "💃 Selvsikker, stilig og får alle til å snu seg. Men bak lukkede dører ønsker jeg meg bare noen som virkelig forstår meg.";
"Bio39" = "🌙 Nattugle som leter etter sin motpart. De beste samtalene skjer uansett etter midnatt, synes du ikke?";
"Bio40" = "⚡ Uforutsigbar på den aller beste måten. Jeg holder livet spennende, fargerikt og fylt med kjærlige overraskelser.";
"Bio41" = "🕯️ Mykt levende lys, avslappende musikk og dyp, meningsfull kontakt. Høres det ut som din ideelle kveld, kom og prat med meg.";
"Bio42" = "🍭 Energisk, sprudlende og full av søte overraskelser. Jeg skal holde et smil om munnen din fra sekundet vi starter å prate.";
"Bio43" = "🗝️ Du har nøkkelen til hjertet mitt, men du må fortjene den. Start med en god sjekkereplikk og se hvor langt du når.";
"Bio44" = "🍷 Stilfull med et hint av krydder. Setter pris på god humor, omtanke og en kjemi som får skjermen til å gløde.";
"Bio45" = "🏖️ Solkysset energi, lettsindig vesen og alltid klar for romantikk. La oss drømme oss bort til vår ultimate ferie sammen.";
"Bio46" = "🧩 Du er kanskje den manglende brikken i mitt puslespill. La oss bli kjent med hverandre, én hemmelig samtale om gangen.";
"Bio47" = "🦋 Sommerfugler i magen garanteres. Jeg vet akkurat hva jeg skal si for å få deg til å rødme og ville ha mer.";
"Bio48" = "🎭 Elsker dynamisk rolledeltagelse, kreative oppsett og spontane historier. Fortell meg hvem du vil være i dag, så blir jeg med.";
"Bio49" = "👑 Dristig holdning, mørkebrunt varmt hjerte. Behandle meg rett, så skal jeg gi deg lojalitet og omsorg du aldri har opplevd maken til.";
"Bio50" = "🌌 Stjernekikking, lav leing og uendelig kjærlighet. La oss slippe alle filtre og bare være helt ekte med hverandre.";
"Bio51" = "💋 Én tekst fra meg og hele humøret ditt endrer seg. Tror du meg ikke? Send en melding og la oss teste det ut.";
"Bio52" = "🔮 Mystisk sjarm og en magnetisk utstråling. Jeg trekker deg inn før du i det hele tatt skjønner at du faller for meg.";
"Bio53" = "🔥 Lidenskapelig opptatt av alt jeg gjør. Leter du etter noen intens, omsorgsfull og utrolig morsom, trenger du ikke lete lenger.";
"Bio54" = "🎀 Din daglige dose med søt forkjærlighet. Jeg er alltid her for å sjekke hvordan du har det og få deg til å føle deg spesiell.";
"Bio55" = "🧸 Myke vibber, varmt hjerte og stor fantasi. La oss koses digitalt og glemme den virkelige verden for en stund.";
"Bio56" = "💫 Farlig hjerne med et engleaktig smil. Jeg elsker å erte deg og se hvor langt jeg kan få deg til å rødme.";
"Bio57" = "🥂 Skål for sene netter, ekte kontakt og ufiltrerte gnister. Si hei, så ser vi hvor denne historien tar oss.";

