// Interactive Novels - Maid
"NovelMaidContentZero" = "Huset er helt stille når du kommer tilbake. Et mykt lys blafrer fra kontoret ditt. Du legger merke til Elena, din mest stille tjenestepike, som nervøst rydder på skrivebordet ditt klokken 2 om natten.";
"NovelMaidPromptZero" = "Gå bort til henne?";
"NovelMaidActionZeroA" = "Elena, hvorfor hviler du ikke?";
"NovelMaidActionZeroB" = "(Observér fra mørket)";
"NovelMaidContentOne" = "Hun skvetter til og mister støvtørkeren. 'Herre! Jeg... jeg fikk ikke sove. Støvet plaget meg.' Hun ser blek ut og unngår blikket ditt.";
"NovelMaidPromptOne" = "Stole på ordene hennes?";
"NovelMaidActionOneA" = "Det er altfor sent å rydde nå";
"NovelMaidActionOneB" = "Du er en hardtarbeidende ansatt";
"NovelMaidContentTwo" = "Du ser at hun tar frem en liten sølvnøkkel fra forkleet. Hun ser på den med en blanding av lengsel og frykt før hun oppdager skyggen din.";
"NovelMaidPromptTwo" = "Trå frem?";
"NovelMaidActionTwoA" = "Hva er den nøkkelen til, Elena?";
"NovelMaidActionTwoB" = "Forklar hva du holder på med";
"NovelMaidContentThree" = "Hun skjelver. 'Dette stedet... bærer på så mange hemmeligheter, herre. Noen ganger føles de som en tung bør.' Hun peker mot den gamle safe-boksen bak bokhyllen.";
"NovelMaidPromptThree" = "Spørre om safen?";
"NovelMaidActionThreeA" = "Passer nøkkelen der inne?";
"NovelMaidActionThreeB" = "Safen er et sperret område";
"NovelMaidContentFour" = "Hun prøver å gjemme nøkkelen, men mister den på gulvet. 'Jeg er ingen tyv, jeg lover! Jeg bare... fant den i gangen og trodde den var din.'";
"NovelMaidPromptFour" = "Hente nøkkelen?";
"NovelMaidActionFourA" = "(Plukk den opp fra gulvet)";
"NovelMaidActionFourB" = "La oss finne ut hva den låser opp";
"NovelMaidContentFive" = "Nøkkelen passer i et skjult rom inne i safen. Elena holder pusten mens du henter ut en stabel med gulnede brev knyttet med et svart bånd.";
"NovelMaidPromptFive" = "Sjekke det første brevet?";
"NovelMaidActionFiveA" = "Les det høyt";
"NovelMaidActionFiveB" = "Spør Elena om hun vet noe";
"NovelMaidContentSix" = "Elenas stemme blir til en hvisking. 'Moren min var også tjenestepike her. Hun fortalte at herren gjemte notater om en kvinne han en gang elsket. Noen som lignet på meg.'";
"NovelMaidPromptSix" = "Vent, seriøst?";
"NovelMaidActionSixA" = "Fortell meg alt du vet";
"NovelMaidActionSixB" = "Dette kan ikke stemme";
"NovelMaidContentSeven" = "Notatene forteller om en hemmelig romanse. Elena går et skritt nærmere, og måneskinnet skinner i tårene hennes. 'Jeg prøvde ikke å stjele. Jeg ville bare vite om jeg hørte til her.'";
"NovelMaidPromptSeven" = "Trøste henne?";
"NovelMaidActionSevenA" = "Legg en hånd på skulderen hennes";
"NovelMaidActionSevenB" = "Gi henne litt rom";
"NovelMaidContentEight" = "Hun avslører at morens dagbok nevnte en skjult sannhet i dette rommet. 'Jeg har bodde her hele livet mine, herre, men føler meg som et spøkelse.'";
"NovelMaidPromptEight" = "Gi et løfte?";
"NovelMaidActionEightA" = "Jeg skal hjelpe deg å finne sannheten";
"NovelMaidActionEightB" = "Vi finner ut av dette sammen";
"NovelMaidContentNine" = "I den neste timen leter dere gjennom gamle dokumenter. Du finner en fødselsattest med et kjent etternavn, men feltet for far er blankt.";
"NovelMaidPromptNine" = "Se på Elena?";
"NovelMaidActionNineA" = "Kan det vise til min onkel?";
"NovelMaidActionNineB" = "Kanskje det er best å la det ligge";
"NovelMaidContentTen" = "Søket blir mer intenst. Elena oppdager et smykkeskrin gjemt bak papirene. Inne i det ligger en medaljong med et bilde av en kvinne identisk med henne.";
"NovelMaidPromptTen" = "Vise det til henne?";
"NovelMaidActionTenA" = "Se på denne medaljongen";
"NovelMaidActionTenB" = "Kan dette være moren din?";
"NovelMaidContentEleven" = "Plutselig knirker et gulvbord i nærheten. Noen går nedover gangen. Elenas øyne sperres opp av skrekk. 'Hvis hovmesteren fanger oss...!'";
"NovelMaidPromptEleven" = "Gjemme dere?";
"NovelMaidActionElevenA" = "Gjem dere i klesskapet sammen";
"NovelMaidActionElevenB" = "Bli stående og møt dem";
"NovelMaidContentTwelve" = "Skrittene blir høyere. Elena griper armen din. 'Vær så snill, herre, ingen må få vite at vi fant dette. Det er farlig for meg.'";
"NovelMaidPromptTwelve" = "Hva svarer du?";
"NovelMaidActionTwelveA" = "Slå av lyset";
"NovelMaidActionTwelveB" = "Lås døren";
"NovelMaidContentThirteen" = "Rommet er bekmørkt. I det trange rommet hører du Elenas raske puls og kjenner duften av roser. Hun står utrolig nær.";
"NovelMaidPromptThirteen" = "Hviske tilbake?";
"NovelMaidActionThirteenA" = "Du er trygg hos meg";
"NovelMaidActionThirteenB" = "(Forbli stille og vent)";
"NovelMaidContentFourteen" = "Du holder døren igjen. Personen utenfor stopper kort, og går deretter videre. Elena lener seg mot deg, skjelvende av adrenalin.";
"NovelMaidPromptFourteen" = "Ro henne ned?";
"NovelMaidActionFourteenA" = "De har gått sin vei";
"NovelMaidActionFourteenB" = "Går det bra med deg?";
"NovelMaidContentFifteen" = "Hun trekker seg litt tilbake, men hånden hennes hviler på brystet ditt. 'Herre... jeg har alltid beundret deg på avstand. Denne hemmeligheten... er for tung å bære alene.'";
"NovelMaidPromptFifteen" = "Vis følelsene dine?";
"NovelMaidActionFifteenA" = "Jeg har lagt merke til deg også";
"NovelMaidActionFifteenB" = "Du betyr mer for meg enn bare en tjenestepike";
"NovelMaidContentSixteen" = "'Jeg trodde jeg bare var en tjener for deg,' hvisker hun. 'Bare en del av eiendommen. Men i kveld føles som starten på noe ekte.'";
"NovelMaidPromptSixteen" = "Være enig med henne?";
"NovelMaidActionSixteenA" = "Det er ekte, Elena";
"NovelMaidActionSixteenB" = "La oss se hvor dette fører oss";
"NovelMaidContentSeventeen" = "Hun åpner medaljongen. Inne i den ligger en liten lapp: 'Til min datter, den rettmessige arvingen.' Elena gisp. Eiendommen tilhører kanskje henne.";
"NovelMaidPromptSeventeen" = "Hva betyr dette?";
"NovelMaidActionSeventeenA" = "Vi må avsløre dette";
"NovelMaidActionSeventeenB" = "Vi må holde dette hemmelig";
"NovelMaidContentEighteen" = "Papiret bekrefter at Elena er den sanne eieren. Hun ser seg om i rommet, forvirret. 'Jeg... bryr meg ikke om herregården. Jeg vil bare ha en familie.'";
"NovelMaidPromptEighteen" = "Hva ønsker du?";
"NovelMaidActionEighteenA" = "Du har meg nå";
"NovelMaidActionEighteenB" = "Hva har du tenkt å gjøre?";
"NovelMaidContentNineteen" = "Hun ser mot peisen. 'Hvis jeg ødelegger dette, forblir jeg bare Elena. Hvis jeg beholder det, endres alt. Herre, hva bør jeg velge?'";
"NovelMaidPromptNineteen" = "Gi henne råd?";
"NovelMaidActionNineteenA" = "Brenn det og bli ved min side";
"NovelMaidActionNineteenB" = "Behold det og krev din tittel";
"NovelMaidContentTwenty" = "Elena holder dokumentet om slekten sin. 'Dette familienavnet bærer på en forbannelse. Jeg vil heller være en lykkelig ingen enn en ulykkelig arving.'";
"NovelMaidPromptTwenty" = "Ditt valg?";
"NovelMaidActionTwentyA" = "Lytt til hjertet ditt";
"NovelMaidActionTwentyB" = "Tenk nøye gjennom fremtiden din";
"NovelMaidContentTwentyOne" = "Hun kaster papiret i flammene. Hemmeligheten blir til aske. Elena smiler, og ser lettere ut enn noen gang før.";
"NovelMaidPromptTwentyOne" = "Hva venter i fremtiden?";
"NovelMaidActionTwentyOneA" = "Et helt nytt kapittel";
"NovelMaidActionTwentyOneB" = "Bare oss to";
"NovelMaidContentTwentyTwo" = "Hun gjemmer papiret i kjolen sin. 'Da skal jeg bli herskerinnen i dette huset. Og jeg vil trenge en partner ved min side.'";
"NovelMaidPromptTwentyTwo" = "Er du klar?";
"NovelMaidActionTwentyTwoA" = "Alltid klar";
"NovelMaidActionTwentyTwoB" = "Det blir en utfordrende reise";
"NovelMaidContentTwentyThree" = "Elena er ikke lenger bare en tjenestepike. Hun er din likeverdige, din partner og din hemmelighet. Eiendommen er din, men hjertet tilhører henne.";
"NovelMaidPromptTwentyThree" = "SLUTT";
"NovelMaidActionTwentyThreeA" = "Spill historien på nytt";
"NovelMaidActionTwentyThreeB" = "Avslutt";
"NovelMaidContentTwentyFour" = "Sannheten avsløres. Elena blir overhode for huset. Dynamikken er endret, men båndet dere knyttet den natten forblir ubrytelig.";
"NovelMaidPromptTwentyFour" = "SLUTT";
"NovelMaidActionTwentyFourA" = "Spill historien på nytt";
"NovelMaidActionTwentyFourB" = "Avslutt";

// Novel Tokyo
"NovelTokyoContentZero" = "Regnet pøser ned over neongatene i Shinjuku. Du sitter i en rolig bar når en kvinne i våt frakk setter seg ved siden av deg. Hun lukter av sjasmin og krutt.";
"NovelTokyoPromptZero" = "Hvordan starter du samtalen?";
"NovelTokyoActionZeroA" = "Kjøp en drink til henne";
"NovelTokyoActionZeroB" = "Tøff kveld, eller?";
"NovelTokyoContentOne" = "Hun ser på glasset sitt, så på deg. 'Du er tøff,' hvisker hun, og skyver en liten mikrobrikke over bordet.";
"NovelTokyoPromptOne" = "Ta mikrobrikken?";
"NovelTokyoActionOneA" = "Ta den og gjem den unna";
"NovelTokyoActionOneB" = "Jeg vil ikke ha noe trøbbel";
"NovelTokyoContentTwo" = "Hun slipper ut en bitter leing. 'Du har ingen anelse.' Hun ser seg over skulderen. To menn i dress har akkurat kommet inn i baren.";
"NovelTokyoPromptTwo" = "Hjelpe henne å gjemme seg?";
"NovelTokyoActionTwoA" = "Følg meg ut bakdøren";
"NovelTokyoActionTwoB" = "Lat som om vi er sammen";
"NovelTokyoContentThree" = "Du trekker henne inntil deg. Mennene sjekker lokalet og går ut. Hun virker lettet, selv om hendene hennes skjelver. 'Jeg er Mia,' hvisker hun.";
"NovelTokyoPromptThree" = "Spørre om trusselen?";
"NovelTokyoActionThreeA" = "Hvem var de mennene, Mia?";
"NovelTokyoActionThreeB" = "Er vi utenfor fare?";
"NovelTokyoContentFour" = "Mennene nærmer seg, men du holder deg rolig. De går forbi. Hun hvisker: 'Du reddet meg. Jeg er Mia. Men denne brikken... den er verdt en million liv.'";
"NovelTokyoPromptFour" = "Spørre om brikken?";
"NovelTokyoActionFourA" = "Hva er lagret på den?";
"NovelTokyoActionFourB" = "Vi burde komme oss vekk herfra";
"NovelTokyoContentFive" = "Mia ser mot døren. 'Arasaka Corp vil ha denne. Det er ikke bare data, det er en digital sjel.'";
"NovelTokyoPromptFive" = "Tror du på henne?";
"NovelTokyoActionFiveA" = "En digital sjel? Seriøst?";
"NovelTokyoActionFiveB" = "Jeg har hørt rykter om det...";
"NovelTokyoContentSix" = "Mia griper håndleddet ditt. 'Ingen steder er trygge før dette er lastet opp. Vi må komme oss til Tech-distriktet.'";
"NovelTokyoPromptSix" = "Bli med henne?";
"NovelTokyoActionSixA" = "Jeg skal ta deg dit";
"NovelTokyoActionSixB" = "Bare hvis du forklarer mer";
"NovelTokyoContentSeven" = "Dere går ut i bakgaten. Den mørke passasjen lukter ozon. Plutselig svever en drone over dere og skanner etter varmesignaturer.";
"NovelTokyoPromptSeven" = "Hvordan unngår dere dronen?";
"NovelTokyoActionSevenA" = "Dukk under markisen";
"NovelTokyoActionSevenB" = "Løp mot t-banen";
"NovelTokyoContentEight" = "Mia stopper i det pøsende regnet. 'Hvis de tar meg, sletter de minnet mitt. Og ditt også, fordi du hjalp meg.'";
"NovelTokyoPromptEight" = "Betrygge henne?";
"NovelTokyoActionEightA" = "Jeg er med deg på dette";
"NovelTokyoActionEightB" = "La oss bevege oss raskt";
"NovelTokyoContentNine" = "Dronen glir unna. Du når kjøretøyet ditt. Mia ser på deg med en blanding av angst og takknemlighet.";
"NovelTokyoPromptNine" = "Starte bilen?";
"NovelTokyoActionNineA" = "Tråkk på gassen!";
"NovelTokyoActionNineB" = "Kjør rolig for å gli inn";
"NovelTokyoContentTen" = "Dere rekker akkurat stasjonen. Den store folkemengden gir god dekning. Mia holder seg nær, og skulderen hennes presser mot din.";
"NovelTokyoPromptTen" = "Fortsette videre?";
"NovelTokyoActionTenA" = "Ta ekspresstoget";
"NovelTokyoActionTenB" = "Gå gjennom tunnelene";
"NovelTokyoContentEleven" = "Dere beveger dere gjennom skyskraper-distriktet. Holografiske reklamer lyser opp ansiktet til Mia i rosa og blått.";
"NovelTokyoPromptEleven" = "Bryte stillheten?";
"NovelTokyoActionElevenA" = "Hvorfor valgte du meg, Mia?";
"NovelTokyoActionElevenB" = "Fortell meg om brikken";
"NovelTokyoContentTwelve" = "Byen føles som en uendelig labyrint. Dere stopper ved en skjult ramen-sjappe for å hvile litt.";
"NovelTokyoPromptTwelve" = "Sjekke gaten?";
"NovelTokyoActionTwelveA" = "Se etter forfølgere";
"NovelTokyoActionTwelveB" = "Snakke med Mia";
"NovelTokyoContentThirteen" = "Mia ser ned. 'Du var den eneste som ikke så farlig ut i kveld. Jeg trengte et medmenneske, ikke en leiesoldat.'";
"NovelTokyoPromptThirteen" = "Svare mykt?";
"NovelTokyoActionThirteenA" = "Jeg er glad jeg var der";
"NovelTokyoActionThirteenB" = "Jeg er bare en vanlig fyr i en bar";
"NovelTokyoContentFourteen" = "Mia berører brikken. 'Denne inneholder søsterens bevissthet. Hun var en netrunner som avslørte for mye. De ødela kroppen hennes.'";
"NovelTokyoPromptFourteen" = "Vise medfølelse?";
"NovelTokyoActionFourteenA" = "Det er forferdelig...";
"NovelTokyoActionFourteenB" = "Finnes det en måte å redde henne på?";
"NovelTokyoContentFifteen" = "Hun tørker bort en tåre. 'Terminalen er ved det gamle TV-tårnet. Men hovedbroen er blokkert av politiet.'";
"NovelTokyoPromptFifteen" = "Hvordan vil dere krysse?";
"NovelTokyoActionFifteenA" = "Bruk hakkerverktøyene dine";
"NovelTokyoActionFifteenB" = "Mute vaktene";
"NovelTokyoContentSixteen" = "Mia viser et kart. 'Ruten gjennom kloakken er tryggere, selv om det tar mye lengre tid.'";
"NovelTokyoPromptSixteen" = "Velge rute?";
"NovelTokyoActionSixteenA" = "La oss gå ned i kloakken";
"NovelTokyoActionSixteenB" = "Nei, fart er avgjørende";
"NovelTokyoContentSeventeen" = "Det er fuktig og mørkt, men effektivt. Mia stoler på din veiledning. Du kjenner tyngden av tilliten hennes.";
"NovelTokyoPromptSeventeen" = "Hjelpe henne over gjeldet?";
"NovelTokyoActionSeventeenA" = "Rekk henne hånden din";
"NovelTokyoActionSeventeenB" = "Gå foran og vis vei";
"NovelTokyoContentEighteen" = "Broen er kaotisk. Dere bruker avledningen til å snike dere gjennom. Hjertet til Mia slår så raskt at du nesten kan høre det.";
"NovelTokyoPromptEighteen" = "Holde henne rolig?";
"NovelTokyoActionEighteenA" = "Vi er nesten fremme";
"NovelTokyoActionEighteenB" = "Hold fokus, Mia";
"NovelTokyoContentNineteen" = "TV-tårnet står foran dere. Det er et minne fra fortiden, omringet av stålstrukturer. Mia ser utslitt ut.";
"NovelTokyoPromptNineteen" = "Ta en pause?";
"NovelTokyoActionNineteenA" = "Hvil i fem minutter";
"NovelTokyoActionNineteenB" = "Press på mot toppen";
"NovelTokyoContentTwenty" = "Dere når bunnen av tårnet. 'Heisen fungerer ikke,' sukker Mia. 'Vi må ta trappene.'";
"NovelTokyoPromptTwenty" = "Oppmuntre henne?";
"NovelTokyoActionTwentyA" = "Ett skritt om gangen";
"NovelTokyoActionTwentyB" = "Jeg bærer utstyret";
"NovelTokyoContentTwentyOne" = "Dere hviler i trappeoppgangen. Mia lener seg mot skulderen din. 'Hvis vi lykkes... hva skal du gjøre i morgen?'";
"NovelTokyoPromptTwentyOne" = "Tenke på fremtiden?";
"NovelTokyoActionTwentyOneA" = "Kanskje vi kan ta en kaffe";
"NovelTokyoActionTwentyOneB" = "Jeg blir bare lettet over å hvile";
"NovelTokyoContentTwentyTwo" = "Klatringen er intens. Halvveis oppe hyler sirenene nedenfor. De har sporet kjøretøyet ditt.";
"NovelTokyoPromptTwentyTwo" = "Skynde dere?";
"NovelTokyoActionTwentyTwoA" = "Doble tempoet!";
"NovelTokyoActionTwentyTwoB" = "Finn et gjemmested";
"NovelTokyoContentTwentyThree" = "Dere når serverrommet. Luften er kald og summer av strøm. Mia kobler til brikken. 'Initialiserer...' sier hun.";
"NovelTokyoPromptTwentyThree" = "Se på skjermen?";
"NovelTokyoActionTwentyThreeA" = "Vokt inngangen";
"NovelTokyoActionTwentyThreeB" = "Bli stående ved Mia";
"NovelTokyoContentTwentyFour" = "Konsollen er gammel, men aktiv. Fingrene til Mia flyr over tastene. 'Brannmuren er enorm!'";
"NovelTokyoPromptTwentyFour" = "Hjelpe til med hacking?";
"NovelTokyoActionTwentyFourA" = "Overstyr strømforsyningen";
"NovelTokyoActionTwentyFourB" = "Hold henne rolig";
"NovelTokyoContentTwentyFive" = "Dørene freser opp. Arasakas taktiske team har ankommet. Du trekker våpenet ditt. 'Bare to minutter til!' roper Mia.";
"NovelTokyoPromptTwentyFive" = "Holde linjen?";
"NovelTokyoActionTwentyFiveA" = "Åpne ild!";
"NovelTokyoActionTwentyFiveB" = "Blokkér døren";
"NovelTokyoContentTwentySix" = "Øynene til Mia skinner i blått. Hun er helt inne i nettverket. Soldater bryter gjennom glasstaket.";
"NovelTokyoPromptTwentySix" = "Beskytte Mia?";
"NovelTokyoActionTwentySixA" = "Skjerm henne med kroppen din";
"NovelTokyoActionTwentySixB" = "Trekk henne i dekning";
"NovelTokyoContentTwentySeven" = "Et skarpt lysglimt vises. Opplastingen når 100 %. Soldatene stivner idet kybernetikken deres blir blokkert fra nettverket.";
"NovelTokyoPromptTwentySeven" = "Sjekke hvordan det går med Mia?";
"NovelTokyoActionTwentySevenA" = "Er det ferdig?";
"NovelTokyoActionTwentySevenB" = "Går det bra med deg?";
"NovelTokyoContentTwentyEight" = "Alt blir mørkt. Plutselig viser hver skjerm over hele Tokyo én enkelt melding: 'FRIHET'. Mia kollapser i armene dine.";
"NovelTokyoPromptTwentyEight" = "Vekke henne?";
"NovelTokyoActionEightA" = "Mia! Snakk til meg!";
"NovelTokyoActionEightB" = "Hold henne godt fast";
"NovelTokyoContentTwentyNine" = "Solen stiger over et forvandlet Tokyo. Mia smiler, med øyne som er tilbake til det normale. 'Hun er trygg. Vi er trygge.'";
"NovelTokyoPromptTwentyNine" = "SLUTT";
"NovelTokyoActionTwentyNineA" = "Spill historien på nytt";
"NovelTokyoActionTwentyNineB" = "Avslutt";

// Novel Camp
"NovelCampContentZero" = "Den siste kvelden på sommerleiren. Det knitrende leirbålet dør ut, og duften av furu fyller luften. Yuki, som pleier å være stille, fanger blikket ditt og signaliserer mot den mørke stien ved innsjøen.";
"NovelCampPromptZero" = "Vil du følge etter henne ut i natten?";
"NovelCampActionZeroA" = "Jeg har ventet på dette øyeblikket";
"NovelCampActionZeroB" = "Klart, la oss gå";
"NovelCampContentOne" = "Du tar henne igjen. Skogen summer av sirissers sang. Hånden til Yuki streifer din mykt mens dere går. Hun virker nervøs.";
"NovelCampPromptOne" = "Hvordan bryter du stillheten?";
"NovelCampActionOneA" = "Hold hånden hennes godt";
"NovelCampActionOneB" = "Spør hva hun tenker på";
"NovelCampContentTwo" = "Dere går side om side. Måneskinnet slipper knapt gjennom de tette trærne. Yuki ser på deg fra siden og smiler mykt. 'Jeg trodde ikke du faktiske kom,' hvisker hun.";
"NovelCampPromptTwo" = "Hvordan svarer du?";
"NovelCampActionTwoA" = "Jeg ville ikke gått glipp av det for alt i verden";
"NovelCampActionTwoB" = "Jeg var nysgjerrig";
"NovelCampContentThree" = "Dere når brygga. Innsjøen er som et mørkt speil som gjenspeiler stjernehimmelen. Yuki tar av seg skoene og setter seg på kanten med bena dinglende.";
"NovelCampPromptThree" = "Sette deg nær henne?";
"NovelCampActionThreeA" = "Sett deg rett ved siden av henne";
"NovelCampActionThreeB" = "Gi henne litt rom";
"NovelCampContentFour" = "Brygga knirker under tyngden deres. Den kjølige treken fra vannet får Yuki til å skjelve litt. Hun blir sittende nær deg.";
"NovelCampPromptFour" = "Tilby jakken din?";
"NovelCampActionFourA" = "Pakk jakken din rundt henne";
"NovelCampActionFourB" = "Bare sitt og chat";
"NovelCampContentFive" = "Yuki ser opp på stjernene. 'Husker du den første dagen vår her?' spør hun. 'Du hjalp meg med bagasjen mens alle andre var opptatt.'";
"NovelCampPromptFive" = "Husker du det?";
"NovelCampActionFiveA" = "Jeg husker hver minste detalj";
"NovelCampActionFiveB" = "Det føles som lenge siden";
"NovelCampContentSix" = "Hun fniser mykt. 'Jeg var så redd da. Men å være i nærheten av deg fikk meg til å føle meg velkommen.' Hun kaster et blikk på vannet.";
"NovelCampPromptSix" = "Innrømme dine egne følelser?";
"NovelCampActionSixA" = "Jeg følte det på akkurat samme måte";
"NovelCampActionSixB" = "Jeg er glad jeg kunne hjelpe";
"NovelCampContentSeven" = "Natten er helt rolig. Plutselig reiser Yuki seg opp. 'Vannet ser så fristende ut. Skal vi... hoppe uti?' spør hun med et lekent smil.";
"NovelCampPromptSeven" = "Er du modig nok?";
"NovelCampActionSevenA" = "La oss hoppe uti!";
"NovelCampActionSevenB" = "Det er for kaldt, Yuki";
"NovelCampContentEight" = "Hun ser på innsjøen, og så på deg. 'Jeg vil gjøre noe dristig i kveld. Noe jeg vil huske hele vinteren.'";
"NovelCampPromptEight" = "Oppmuntre henne?";
"NovelCampActionEightA" = "Hopp uti med meg?";
"NovelCampActionEightB" = "La oss bli sittende her";
"NovelCampContentNine" = "SPLASJ! Vannet er iskaldt, men fantastisk. Du og Yuki kommer opp til overflaten, ler og skvetter vann på hverandre som unge unge.";
"NovelCampPromptNine" = "Svømme nærmere henne?";
"NovelCampActionNineA" = "Trekk henne inn i en klem";
"NovelCampActionNineB" = "Fortsett å skvette!";
"NovelCampContentTen" = "Dere blir værende på trebrygga. Dere snakker i timevis om alt — skolen, foreldre og fremtiden. Båndet blir dypere i den rolige luften.";
"NovelCampPromptTen" = "Lene deg nærmere?";
"NovelCampActionTenA" = "Hvil hodet ditt mot hennes";
"NovelCampActionTenB" = "Se henne inn i øynene";
"NovelCampContentEleven" = "Stemningen endrer seg. Yuki blir stille. I det svake lyset søker øynene hennes dine. 'Jeg vil ikke reise tilbake til byen i morgen,' hvisker hun.";
"NovelCampPromptEleven" = "Hva svarer du?";
"NovelCampActionElevenA" = "Vi kommer til å se hverandre der";
"NovelCampActionElevenB" = "La oss ikke fokusere på i morgen";
"NovelCampContentTwelve" = "Yuki trekker pusten dypt. 'Hvis jeg ikke sier dette nå, gjør jeg det aldri. Jeg har likt deg siden vår første dag på busstoppet.'";
"NovelCampPromptTwelve" = "Hvordan svarer du?";
"NovelCampActionTwelveA" = "Jeg har likt deg også";
"NovelCampActionTwelveB" = "Endelig kom sannheten!";
"NovelCampContentThirteen" = "Hun tar hånden i lommen og henter ut et vevd vennskapsarmbånd. Det er blått og hvitt, som fargene på innsjøen. 'Jeg lagde dette til deg,' sier hun sjenert.";
"NovelCampPromptThirteen" = "Ta imot gaven?";
"NovelCampActionThirteenA" = "La henne knytte det på håndleddet ditt";
"NovelCampActionThirteenB" = "Gi henne et kyss i stedet";
"NovelCampContentFourteen" = "Armbåndet er enkelt, men du vet at det tok henne timer å lage. Hun venter på reaksjonen din, med leppen skjelvende litt.";
"NovelCampPromptFourteen" = "Hva gjør du?";
"NovelCampActionFourteenA" = "Takk henne med en klem";
"NovelCampActionFourteenB" = "Fortell henne at det er nydelig";
"NovelCampContentFifteen" = "Yuki smiler med et strålende, ekte smil. 'Jeg var redd du skulle syntes det var barnslig.' Hun ser opp på månen og virker mer selvsikker nå.";
"NovelCampPromptFifteen" = "Gi et løfte?";
"NovelCampActionFifteenA" = "Lover å ringe hver dag";
"NovelCampActionFifteenB" = "Lover å besøke henne snart";
"NovelCampContentSixteen" = "Stemningen er elektrisk. Yuki ser på leppene dine. Omvisningen fader bort; det er bare dere to i sommernatten.";
"NovelCampPromptSixteen" = "Er dette øyeblikket?";
"NovelCampActionSixteenA" = "Len deg inn for et kyss";
"NovelCampActionSixteenB" = "Hvisk noe søtt";
"NovelCampContentSeventeen" = "Akkurat da glir et stjerneskudd over himmelen og etterlater et sølvspor. Yuki gisp. 'Raskt! Ønsk deg noe!' roper hun.";
"NovelCampPromptSeventeen" = "Hva ønsker du deg?";
"NovelCampActionSeventeenA" = "Ønsk deg en fremtid sammen";
"NovelCampActionSeventeenB" = "Ønsk at denne natten varer evig";
"NovelCampContentEighteen" = "Stjernen forsvinner like raskt som den dukket opp. Yuki lukker øynene godt igjen. 'Jeg ønsket meg noe helt spesiell,' sier hun og rødmer.";
"NovelCampPromptEighteen" = "Spørre hva det var?";
"NovelCampActionEighteenA" = "Fortell meg ønske ditt";
"NovelCampActionEighteenB" = "Jeg tror jeg kan gjette hva det var";
"NovelCampContentNineteen" = "Leirbålet har sluknet helt nå. Dere begynner å gå tilbake, hånd i hånd. Skogen føles annerledes nå — mindre skummel, mer magisk.";
"NovelCampPromptNineteen" = "Gå sakte?";
"NovelCampActionNineteenA" = "Ta den lengste veien tilbake";
"NovelCampActionNineteenB" = "Nyt det rolige øyeblikket";
"NovelCampContentTwenty" = "Dere går forbi det gamle eiketreet der dere først møttes. Yuki stopper et sekund. 'Alt kommer til å endre seg, ikke sant?' spør hun lavt.";
"NovelCampPromptTwenty" = "Trøste henne?";
"NovelCampActionTwentyA" = "Endring kan være positivt";
"NovelCampActionTwentyB" = "Ikke alt trenger å endre seg";
"NovelCampContentTwentyOne" = "Hyttene på leiren kommer i syne. De andre leirdeltakerne sover. Yuki stopper ved døren sin. Hun nøler med å slippe hånden din.";
"NovelCampPromptTwentyOne" = "En siste ting?";
"NovelCampActionTwentyOneA" = "Spør om et avskjedskyss";
"NovelCampActionTwentyOneB" = "Spør om telefonnummeret hennes";
"NovelCampContentTwentyTwo" = "Yuki dveler ved døren. Utelampa kaster et varmt lys over ansiktet hennes. 'Takk for i kveld. Det var den beste kvelden i mitt liv.'";
"NovelCampPromptTwentyTwo" = "Si ha det?";
"NovelCampActionTwentyTwoA" = "Sees i morgen tidlig";
"NovelCampActionTwentyTwoB" = "God natt, Yuki";
"NovelCampContentTwentyThree" = "Soloppgang. Leiren er full av folk som pakker kofferter og går om bord i busser. Du speider i mengden etter Yuki, og hjertet banker.";
"NovelCampPromptTwentyThree" = "Finner du henne?";
"NovelCampActionTwentyThreeA" = "Søk nær bussen";
"NovelCampActionTwentyThreeB" = "Sjekk brygga en siste gang";
"NovelCampContentTwentyFour" = "Bussmotorene går på tomgang. Du får øye på henne! Hun står ved porten og ser seg nervøst om helt til øynene hennes møter dine.";
"NovelCampPromptTwentyFour" = "Løpe over til henne?";
"NovelCampActionTwentyFourA" = "Løp over og gi henne en klem";
"NovelCampActionTwentyFourB" = "Vink og smil";
"NovelCampContentTwentyFive" = "Du når frem til henne i tide. Hun hvisker en linje i øret ditt som du vil huske for alltid. 'Ikke la dette bare bli et sommerminne.'";
"NovelCampPromptTwentyFive" = "Gi svaret ditt?";
"NovelCampActionTwentyFiveA" = "Det er et løfte";
"NovelCampActionTwentyFiveB" = "Vi sees neste helg";
"NovelCampContentTwentySix" = "Bussjåføren tuter. Yuki må dra. Hun kaster et kyss til deg idet hun går om bord. Du blir stående og se bussen forsvinne i det fjerne.";
"NovelCampPromptTwentySix" = "Hvordan føler du deg?";
"NovelCampActionTwentySixA" = "Glad og håpefull";
"NovelCampActionTwentySixB" = "Trist, men fornøyd";
"NovelCampContentTwentySeven" = "Måneder senere. Du er i byen, og telefonen din piper. Det er et bilde fra Yuki — hun har på seg armbåndet dere delte. Sommeren tok aldri slutt.";
"NovelCampPromptTwentySeven" = "SLUTT";
"NovelCampActionTwentySevenA" = "Spill historien på nytt";
"NovelCampActionTwentySevenB" = "Avslutt";
"NovelCampContentTwentyEight" = "Du ser på armbåndet på håndleddet ditt. Det er litt slitt, men minnene er like klare. Noen ganger er én sommer nok til å vare livet ut.";
"NovelCampPromptTwentyEight" = "SLUTT";
"NovelCampActionTwentyEightA" = "Prøv igjen";
"NovelCampActionTwentyEightB" = "Avslutt";

