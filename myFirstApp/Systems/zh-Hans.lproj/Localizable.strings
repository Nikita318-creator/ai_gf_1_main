// Novels Interactive Content
"NovelMaidContentZero" = "当你深夜回到宅邸时，四周一片寂静。书房里闪烁着柔和的光芒。你注意到最安静的女仆埃琳娜正焦急地在凌晨 2 点整理你的办公桌。";
"NovelMaidPromptZero" = "走上前去？";
"NovelMaidActionZeroA" = "埃琳娜，怎么还没去休息？";
"NovelMaidActionZeroB" = "（在暗处静静观察）";
"NovelMaidContentOne" = "她吓了一跳，手中的羽毛掸子掉在了地上。“老爷！我… 我睡不着。看到有灰尘就想清理一下。”她脸色苍白，避开了你的目光。";
"NovelMaidPromptOne" = "相信她的说法？";
"NovelMaidActionOneA" = "这么晚打扫太辛苦了";
"NovelMaidActionOneB" = "你真是一个勤奋的员工";
"NovelMaidContentTwo" = "你看着她从围裙里拿出一把小小的银色钥匙。在注意到你的阴影之前，她带着渴望与恐惧交织的眼神凝视着它。";
"NovelMaidPromptTwo" = "走上前去？";
"NovelMaidActionTwoA" = "埃琳娜，那把钥匙是开什么的？";
"NovelMaidActionTwoB" = "解释一下你现在在做什么";
"NovelMaidContentThree" = "她颤抖了一下。“这个地方… 隐藏着太多秘密，老爷。有时它们就像沉重的负担。”她指向书架后面的旧保险箱。";
"NovelMaidPromptThree" = "询问关于保险箱的事？";
"NovelMaidActionThreeA" = "那把钥匙能打开它吗？";
"NovelMaidActionThreeB" = "保险箱是禁区";
"NovelMaidContentFour" = "她试图藏起钥匙，却不小心掉在了地上。“我发誓我不是小偷！我只是… 在走廊里捡到的，以为是您的。”";
"NovelMaidPromptFour" = "捡起钥匙？";
"NovelMaidActionFourA" = "（从地上捡起来）";
"NovelMaidActionFourB" = "让我们看看它能打开什么";
"NovelMaidContentFive" = "钥匙完美契合保险箱里的隐蔽暗格。当你拿出用黑色丝带系着的一叠泛黄信件时，埃琳娜屏住了呼吸。";
"NovelMaidPromptFive" = "查看第一封信？";
"NovelMaidActionFiveA" = "大声读出来";
"NovelMaidActionFiveB" = "问埃琳娜是否知道些什么";
"NovelMaidContentSix" = "埃琳娜压低了声音。“我母亲以前也是这里的女仆。她告诉我，老老爷曾记录过一个他深爱的女孩。那个女孩长得很像我。”";
"NovelMaidPromptSix" = "等等，真的吗？";
"NovelMaidActionSixA" = "把你了解的全部告诉我";
"NovelMaidActionSixB" = "这绝不可能是真的";
"NovelMaidContentSeven" = "信件记录着一段尘封的禁忌之恋。埃琳娜走近了一步，月光在她眼角闪烁。“我没想过偷东西，我只是想知道我是否属于这里。”";
"NovelMaidPromptSeven" = "安慰她？";
"NovelMaidActionSevenA" = "把手轻轻放在她的肩膀上";
"NovelMaidActionSevenB" = "给她一点空间";
"NovelMaidContentEight" = "她透露母亲的日记里提到这个房间藏着真相。“我一辈子都住在这里，老爷，可我觉得自己就像个幽灵。”";
"NovelMaidPromptEight" = "许下承诺？";
"NovelMaidActionEightA" = "我会帮你查明真相的";
"NovelMaidActionEightB" = "我们一起把这事弄清楚";
"NovelMaidContentNine" = "接下来的一个小时里，你们翻阅着旧文件。你找到了一张写着熟悉姓氏的出生证明，但父亲那一栏却是空白。";
"NovelMaidPromptNine" = "看向埃琳娜？";
"NovelMaidActionNineA" = "这指的是我叔叔吗？";
"NovelMaidActionNineB" = "也许有些秘密不知道更好";
"NovelMaidContentTen" = "搜寻越来越深入。埃琳娜在文件后发现了一个首饰盒。里面藏着一个吊坠，里面的肖像画着一个与她一模一样的女人。";
"NovelMaidPromptTen" = "拿给她看？";
"NovelMaidActionTenA" = "看看这个吊坠";
"NovelMaidActionTenB" = "这会不会是你母亲？";
"NovelMaidContentEleven" = "突然，门外地板发出了响声。有人正走过走廊。埃琳娜惊恐地瞪大了眼睛。“要是被管家抓到我们…！”";
"NovelMaidPromptEleven" = "找地方躲起来？";
"NovelMaidActionElevenA" = "一起躲进衣柜里";
"NovelMaidActionElevenB" = "留在这里面对他们";
"NovelMaidContentTwelve" = "脚步声越来越近。埃琳娜紧紧抓住你的手臂。“求求您，老爷，不能让任何人知道我们发现了这个。对我来说太危险了。”";
"NovelMaidPromptTwelve" = "你的回应？";
"NovelMaidActionTwelveA" = "把灯关掉";
"NovelMaidActionTwelveB" = "把门锁紧";
"NovelMaidContentThirteen" = "房间里一片漆黑。在狭小的空间里，你能听到埃琳娜急促的心跳，闻到她身上淡淡的玫瑰香。她贴得非常近。";
"NovelMaidPromptThirteen" = "轻声回应？";
"NovelMaidActionThirteenA" = "在我身边你很安全";
"NovelMaidActionThirteenB" = "（保持安静等待）";
"NovelMaidContentFourteen" = "你顶住了门。外面的人停顿了片刻，随后走开了。埃琳娜靠在你身上，因为肾上腺素飙升而微微颤抖。";
"NovelMaidPromptFourteen" = "安抚她？";
"NovelMaidActionFourteenA" = "他们已经走远了";
"NovelMaidActionFourteenB" = "你没事吧？";
"NovelMaidContentFifteen" = "她稍微退后了一点，但手依然搭在你的胸口。“老爷… 我其实一直都在远远地仰慕着您。这个秘密… 太沉重了，我一个人承受不起。”";
"NovelMaidPromptFifteen" = "表达你的心意？";
"NovelMaidActionFifteenA" = "其实我也一直在注意你";
"NovelMaidActionFifteenB" = "对我来说你早已不只是个女仆";
"NovelMaidContentSixteen" = "“我以为我只是您的仆人，”她轻声说道。“只是这栋宅邸的一部分。但今晚… 感觉像是真正故事的开始。”";
"NovelMaidPromptSixteen" = "认同她的想法？";
"NovelMaidActionSixteenA" = "这是真的，埃琳娜";
"NovelMaidActionSixteenB" = "看看故事会走向何方吧";
"NovelMaidContentSeventeen" = "她打开了吊坠。里面藏着一张小纸条：“给我的女儿，合法的继承人。”埃琳娜捂住了嘴。这座宅邸的名义继承人竟然是她。";
"NovelMaidPromptSeventeen" = "这意味着什么？";
"NovelMaidActionSeventeenA" = "我们需要公开真相";
"NovelMaidActionSeventeenB" = "我们必须保守这个秘密";
"NovelMaidContentEighteen" = "文件确认了埃琳娜才是宅邸真正的主人。她迷茫地环顾房间。“我… 我根本不在乎豪宅。我想要的只是一份归属感。”";
"NovelMaidPromptEighteen" = "你的心愿是什么？";
"NovelMaidActionEighteenA" = "你现在拥有我了";
"NovelMaidActionEighteenB" = "你打算怎么做？";
"NovelMaidContentNineteen" = "她看向壁炉。“如果我烧毁这个，我依然只是埃琳娜。如果我留着它，一切都会改变。老爷，我该怎么选？”";
"NovelMaidPromptNineteen" = "给她建议？";
"NovelMaidActionNineteenA" = "烧掉它，留在我身边";
"NovelMaidActionNineteenB" = "留着它，夺回属于你的头衔";
"NovelMaidContentTwenty" = "埃琳娜紧握着身世文件。“这个家族姓氏带着诅咒，老爷。我宁愿做个快乐的普通人，也不想做个悲惨的继承人。”";
"NovelMaidPromptTwenty" = "你的决定是？";
"NovelMaidActionTwentyA" = "听从你内心的声音";
"NovelMaidActionTwentyB" = "仔细考虑你的未来";
"NovelMaidContentTwentyOne" = "她将纸张扔进了微弱的火苗中。秘密化为了灰烬。埃琳娜露出了笑容，显得比以往任何时候都轻松。";
"NovelMaidPromptTwentyOne" = "未来会如何？";
"NovelMaidActionTwentyOneA" = "全新篇章的开始";
"NovelMaidActionTwentyOneB" = "只有我们两个人";
"NovelMaidContentTwentyTwo" = "她将文件塞进胸前。“那么从今往后，我就是这栋大宅的女主人。而我需要一位伴侣陪伴左右。”";
"NovelMaidPromptTwentyTwo" = "你准备好了吗？";
"NovelMaidActionTwentyTwoA" = "随时准备着";
"NovelMaidActionTwentyTwoB" = "这将是一段艰难的旅程";
"NovelMaidContentTwentyThree" = "埃琳娜不再只是个女仆。她是你的平等伴侣，是你的挚爱，也是你们共有秘密的守护者。宅邸依然属于你，但它的心已属于她。";
"NovelMaidPromptTwentyThree" = "结局";
"NovelMaidActionTwentyThreeA" = "重玩故事";
"NovelMaidActionTwentyThreeB" = "退出";
"NovelMaidContentTwentyFour" = "真相大白。埃琳娜成为了宅邸的主人。身份格局发生了改变，但那个夜晚建立的羁绊永不磨灭。";
"NovelMaidPromptTwentyFour" = "结局";
"NovelMaidActionTwentyFourA" = "重玩故事";
"NovelMaidActionTwentyFourB" = "退出";

/* Novel Tokyo & Summer Camp Shortcuts */
"NovelTokyoContentZero" = "大雨倾盆打在新宿霓虹闪烁的街头。你正坐在一家安静的酒吧里，一位穿着湿透风衣的女子坐在了你身边。她身上带着茉莉花与枪药的味道。";
"NovelTokyoPromptZero" = "你如何开启对话？";
"NovelTokyoActionZeroA" = "帮她点一杯酒";
"NovelTokyoActionZeroB" = "今晚过得挺艰难，对吧？";
"NovelTokyoContentOne" = "她看了看酒杯，又看了看你。“你挺有胆量的，”她轻声说道，将一枚微型芯片沿桌子滑了过来。";
"NovelTokyoPromptOne" = "拿走芯片？";
"NovelTokyoActionOneA" = "拿走并藏好";
"NovelTokyoActionOneB" = "我可不想惹麻烦";
"NovelTokyoContentTwo" = "她苦笑了一声。“你根本一无所知。”她回头看了一眼。两个穿西装的男人刚刚走进了酒吧。";
"NovelTokyoPromptTwo" = "帮她掩护？";
