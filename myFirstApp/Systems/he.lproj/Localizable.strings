"NovelMaidActionElevenB" = "להישאר כאן ולפגוש אותם";
"NovelMaidContentTwelve" = "הצעדים מתחזקים. אלנה אוחזת בזרועך. 'בבקשה, אדוני, אף אחד לא יכול לדעת שחשפנו את זה. זה מסוכן עבורי.'";
"NovelMaidPromptTwelve" = "התגובה שלך?";
