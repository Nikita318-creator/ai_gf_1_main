"NovelMaidActionThreeA" = "המפתח הזה מתאים לשם?";
"NovelMaidActionThreeB" = "הכספת היא שטח מוגבל";
"NovelMaidContentFour" = "היא מנסה להסתיר את המפתח, אך מפילה אותו. 'אני לא גנבת, אני נשבעת! פשוט... מצאתי אותו במסדרון וחשבתי שהוא שלך.'";
