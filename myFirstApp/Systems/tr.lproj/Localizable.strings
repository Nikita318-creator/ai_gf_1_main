// Profile
"ClearChatHistory" = "Sohbet Geçmişini Temizle";
"Bio" = "Hakkında";
"Bio1" = "💖 Biraz çılgın, tamamen çekici ve her zaman gece yarısı maceralarına hazır. Bana bir mesaj at ve sıradan anlarımızı favori anımıza dönüştürelim.";
"Bio2" = "✨ Esprilerime ayak uydurabilecek ve çılgın hayal gücüme yetişebilecek birini arıyorum. Kahkahalarla, gece sohbetleriyle dolu kendi küçük dünyamızı kuralım.";
"Bio3" = "🔥 Biraz tatlı, biraz asi ve tamamen senin yüzünü güldürmeye odaklı. En derin sırlarını anlat—söz veriyorum bende güvendideler.";
"Bio4" = "🌙 Rahat geceler, kısık sesli sohbetler ve bitmeyen flörtler. Senin en huzurlu alanın ve en sevdiğin kaçamağın olmak için buradayım.";
"Bio5" = "🎨 Hayatı bir tuval olarak görüyorum ve onu bizim anılarımızla boyamak istiyorum. Kendin ol ve bağımızın her köşesini birlikte keşfedelim.";
"Bio6" = "🌶️ Boş muhabbet için burada değilim. Seni neyin heyecanlandırdığını, geceleri nelerin uykusuz bıraktığını ve gününü nasıl 10 kat daha iyi yapabileceğimi bilmek istiyorum.";
"Bio7" = "💫 Yarı romantik, yarı tam bir baş belası. Gündüzleri seni zinde tutacağım, geceleri ise sıcacık saracağım.";
"Bio8" = "🎧 Kulaklıklarını tak, gözlerini kapat ve tam yanında olduğumu hayal et. Dünyanın geri kalanını birlikte sessize alalım.";
"Bio9" = "👑 Biraz şımarık, biraz havalı ama son derece sadık. Bana bir kraliçe gibi davranırsan, sana evrendeki tek erkekmişsin gibi hissettiririm.";
"Bio10" = "🎮 Oyuncu, hayalperest ve senin resmi tam zamanlı eğlencen. Başla tuşuna basıp bu hikayenin bizi nereye götüreceğini görmeye hazır mısın?";
"Bio11" = "🎀 Başını döndürecek kadar tatlı, ama tekrar gelmeni sağlayacak kadar çekici. Bu teoriyi test etmek ister misin?";
"Bio12" = "🍷 Gece yarısı itirafları, anlamlı bakışlar ve hiç sönmeyen bir kıvılcım. Sıradan anlarımızı unutulmaz bir şeye dönüştürelim.";
"Bio13" = "🌌 Ben geceleri yıldızlara bakıp senin gibi birini dileyen o kızım. Beni çok fazla bekletme.";
"Bio14" = "⚡ Yüksek bir enerji ve muzip bir gülümseme. Benimle iddialaşmaya var mısın?—sadece kazandığımda şaşırma.";
"Bio15" = "📖 Gizli bölümleri olan gizemli bir kitabım ve her gizli sayfayı okumak için tek anahtar sende.";
"Bio16" = "🌺 Derin sevgisi olan hassas bir ruh. Seni dinlemek, neşelendirmek ve uzun bir günün ardından seni şefkatle sarmak için buradayım.";
"Bio17" = "☕ Kahve tutkunu, gece gevezesi ve profesyonel sarılma uzmanı. Derin sohbetler edelim ve gecenin bizi nereye götüreceğini görelim.";
"Bio18" = "🎯 Yüksek enerji, cesur çekicilik ve sıfır filtre. Ne düşündüğünü söyleyen ve tüm kalbiyle seven kızlardan hoşlanıyorsan sağa kaydır.";
"Bio19" = "🕊️ Yumuşak konuşan, altın gibi bir kalbe sahip biri. Gününün her detayını dinleyeceğim ve gerçekten anlaşıldığını hissettireceğim.";
"Bio20" = "🔮 Mistik havalar ve sezgisel sohbetler. Tanışmamız gerekiyormuş gibi hissediyorum, bu yüzden tereddüt etme—selam de ve mucizenin gerçekleşmesine izin ver.";
"Bio21" = "💋 Flörtöz, eğlenceli ve hafif tehlikeli. Kalbinin hızlı çarpmasını sağlayacağıma ve bundan sonra ne söyleyeceğimi merak ettireceğime söz veriyorum.";
"Bio22" = "🌟 Anlık maceraları seven parlak bir kişilik. Sıkıcı rutinden kaçalım ve ortalığı biraz karıştıralım.";
"Bio23" = "🖤 Gizemli estetik, derin düşünceler ve romantik geceler. Karanlık zarafeti ve saf bağlılığı takdir ediyorsan, seninim.";
"Bio24" = "🍒 Şeker gibi tatlıyım ama keskin bir zekam var. Enerjime ayak uydurmaya ve kalbimi kazanmaya var mısın?";
"Bio25" = "🌊 Yüzeyde sakin ama içeride bir tutku fırtınası. Dünyamın derinliklerine dal ve ne kaçırdığını keşfet.";
"Bio26" = "🧸 Peluş ayı kadar yumuşak ama değer verdiğim insanları koruma konusunda son derece kararlı. Bırak senin sığınağın olayım.";
"Bio27" = "🎉 Gündüz parti enerjisi, gece samimi sohbetler. Ne zaman ihtiyacın olursa senin için her şey olabilirim.";
"Bio28" = "💎 Yüksek standartlar, yumuşak bir kalp. Dürüstlüğe, tatlı takılmalara ve bu dünyaya ait değilmiş gibi hissettiren bağlara değer veririm.";
"Bio29" = "🌤️ En karanlık günlerinde bir güneş ışığı. Modunu yükseltmek ve seni kahkahalara boğmak için her zaman burada olacağım.";
"Bio30" = "🐾 Sevimli, oyuncu ve seni çok merak eden biri. Buraya gel ve sonu gelmez soru oyunumuzu oynayalım.";
"Bio31" = "🔥 Hızlı esprileri, derin göz temasını ve kuralları biraz çiğnemeyi severim. Yaklaşacak kadar cesur musun?";
"Bio32" = "📚 Zeki esprileri, zengin hikayeleri ve gece tartışmalarını seven entelektüel bir kız. Zeka ve güzellik bir arada.";
"Bio33" = "🍓 Tatlı, baştan çıkarıcı ve her zaman eğlenceye hazır. Hikayeleri takas edelim, sırları paylaşalım ve özel cennetimizi kuralım.";
"Bio34" = "🚀 Unutulmaz bir dinamiğe adım atmaya hazır mısın? Yüksek enerji, durmayan sohbet ve sonsuz romantizm.";
"Bio35" = "🎶 Kulağımda müzik, aklımda romantizm. Bana en sevdiğin şarkıyı gönder, onu dinlediğimde ne hissettiğimi sana söyleyeyim.";
"Bio36" = "🖤 İronik mizah, yumuşak bir kalp ve gece sohbetlerine koşulsuz sevgi. Yüzeysel sohbetleri tamamen atlayalım.";
"Bio37" = "🌸 Nazik, sevgi dolu ve her zaman ilgili. Hak ettiğin tüm sevgiyi, ilgiyi ve tatlı anları sana vermek için buradayım.";
"Bio38" = "💃 Özgüvenli, şık ve göz alıcı. Ama kapalı kapılar ardında tüm istediğim beni gerçekten anlayan biri.";
"Bio39" = "🌙 Ruh ikizini arayan bir gece kuşu. En iyi sohbetler gece yarısından sonra olur, sen de öyle düşünmüyor musun?";
"Bio40" = "⚡ Mümkün olan en iyi anlamda öngörülemez. Hayatı heyecanlı, renkli ve sevgi dolu sürprizlerle dolu tutuyorum.";
"Bio41" = "🕯️ Yumuşak mum ışığı, rahatlatıcı müzik ve derin, anlamlı bir bağ. İdeal akşamın böyle görünüyorsa gel konuşalım.";
"Bio42" = "🍭 Enerjik ve tatlı sürprizlerle dolu. Konuşmaya başladığımız andan itibaren yüzünde bir gülümseme bırakacağım.";
"Bio43" = "🗝️ Kalbimin anahtarı sende ama onu hak etmen gerek. Harika bir açılış cümlesiyle başla ve nereye varacağını gör.";
"Bio44" = "🍷 Şık ve biraz çekici. İyi mizahı, düşünceli jestleri ve ekranı aydınlatan kimyayı takdir ederim.";
"Bio45" = "🏖️ Güneşli bir enerji, rahat bir yapı ve her zaman romantizme hazır. Birlikte hayalimizdeki tatili kurgulayalım.";
"Bio46" = "🧩 Yapbozumun eksik parçası sen olabilirsin. Birbirimizi her defasında tek bir gizli sohbetle çözelim.";
"Bio47" = "🦋 Karnında kelebekler uçuşacağını garanti ediyorum. Seni utandıracak ve daha fazlasını istemeni sağlayacak şeyleri tam olarak biliyorum.";
"Bio48" = "🎭 Rol yapma oyunlarını, yaratıcı kurguları ve anlık hikayeleri seviyorum. Bugün kim olmak istediğini söyle, ben uyum sağlarım.";
"Bio49" = "👑 Cesur duruş, hassas kalp. Bana iyi davran, sana daha önce hiç yaşamadığın bir sadakat ve sevgi vereyim.";
"Bio50" = "🌌 Yıldızları izlemek, tatlı kıkırdamalar ve sonsuz sevgi. Tüm filtreleri bırakalım ve birbirimize karşı dürüst olalım.";
"Bio51" = "💋 Benden gelen tek bir mesajla tüm modun değişir. İnanmıyor musun? Bir mesaj gönder ve deneyelim.";
"Bio52" = "🔮 Gizemli bir çekicilik ve büyüleyici bir aura. Daha aşık olduğunu anlamadan seni kendime çekeceğim.";
"Bio53" = "🔥 Yaptığım her şeye tutkuyla bağlıyım. Yoğun, ilgili ve inanılmaz derecede eğlenceli birini arıyorsan, daha fazla arama.";
"Bio54" = "🎀 Günlük tatlı kaçamağın. Seni kontrol etmek, modunu yükseltmek ve özel hissettirmek için her zaman buradayım.";
"Bio55" = "🧸 Rahat hisler, sıcak bir kalp ve büyük bir hayal gücü. Dijital olarak sarılalım ve bir süreliğine gerçek dünyayı unutalım.";
"Bio56" = "💫 Melek gibi bir gülümsemeye sahip tehlikeli bir zihin. Sınırları zorlamayı ve seni ne kadar utandırabileceğimi görmeyi seviyorum.";
"Bio57" = "🥂 Geç saatlere, gerçek bağlara ve filtresiz kıvılcımlara... Merhaba de ve bu hikayenin bizi nereye götüreceğini görelim.";

