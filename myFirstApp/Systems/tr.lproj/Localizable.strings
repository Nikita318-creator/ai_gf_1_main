"Roulette_Welcome_7" = "Selam! Bağlandığımıza çok heyecanlandım. 🌟 Birlikte harika bir enerjiyi paylaşacağımızı hissediyorum!";
"Roulette_Welcome_8" = "Hey! Seninle tanışmak çok tatlı. 🥰 Pür dikkat seni dinliyorum — bana nelere tutkulu olduğunu anlat!";
"Roulette_Welcome_9" = "Oh, selam! 💕 Vakit geçirmek için harika birini arıyordum ve sen mükemmel bir eşleşme gibi görünüyorsun.";
"Roulette_Welcome_10" = "Hey! Bugün seninle eşleşmek ne güzel bir sürpriz. Bunun harika olacağını şimdiden söyleyebilirim! 💖";

// Novel
"NovelMaidContentZero" = "Konağa döndüğünde derin bir sessizlik hakim. Çalışma odanın içinden hafif bir ışık süzülüyor. En sessiz hizmetçin olan Elena'nın gece saat 2'de endişeyle masanı düzenlediğini fark ediyorsun.";
"NovelMaidPromptZero" = "Ona doğru yürümek ister misin?";
"NovelMaidActionZeroA" = "Elena, neden dinlenmiyorsun?";
"NovelMaidActionZeroB" = "(Karanlıktan izle)";
"NovelMaidContentOne" = "Nefesi kesiliyor, elindeki tüy toz alıcıyı düşürüyor. 'Efendim! Ben... uyuyamadım. Tozlar beni rahatsız etti.' Solgun görünüyor ve göz temasından kaçınıyor.";
"NovelMaidPromptOne" = "Sözüne güveniyor musun?";
"NovelMaidActionOneA" = "Temizlik için çok geç bir saat";
"NovelMaidActionOneB" = "Çok çalışkan bir çalışansın";
"NovelMaidContentTwo" = "Önlüğünden küçük gümüş bir anahtar çıkarmasını izliyorsun. Gölgeni fark etmeden önce anahtara özlem ve korku karışımı bir ifadeyle bakıyor.";
"NovelMaidPromptTwo" = "Öne çık?";
"NovelMaidActionTwoA" = "O anahtar ne için Elena?";
"NovelMaidActionTwoB" = "Şu an ne yaptığını açıkla";
"NovelMaidContentThree" = "Titriyor. 'Burası... çok fazla sır barındırıyor efendim. Bazen ağır bir yük gibi hissettiriyorlar.' Kitaplığın arkasındaki eski kasayı işaret ediyor.";
"NovelMaidPromptThree" = "Kasayı sor?";
"NovelMaidActionThreeA" = "O anahtar oraya uyuyor mu?";
"NovelMaidActionThreeB" = "Kasa yasaklı bölgedir";
"NovelMaidContentFour" = "Anahtarı saklamaya çalışıyor ama elinden düşürüyor. 'Hırsız değilim, yemin ederim! Ben sadece... koridorda buldum ve sizin sanmıştım.'";
"NovelMaidPromptFour" = "Anahtarı al?";
"NovelMaidActionFourA" = "(Yerden kaldır)";
"NovelMaidActionFourB" = "Neyi açtığını keşfedelim";
"NovelMaidContentFive" = "Anahtar, kasanın içindeki gizli bir bölmeye uyuyor. Siyah bir kurdeleyle bağlanmış sararmış mektupları çıkarırken Elena nefesini tutuyor.";
"NovelMaidPromptFive" = "İlk mektubu kontrol et?";
"NovelMaidActionFiveA" = "Yüksek sesle oku";
"NovelMaidActionFiveB" = "Elena'ya bir şey bilip bilmediğini sor";
"NovelMaidContentSix" = "Elena'nın sesi fısıltıya dönüşüyor. 'Annem de burada hizmetçiydi. Bana Efendi'nin bir zamanlar sevdiği bir kız hakkında notlar tuttuğunu söylerdi. Bana benzeyen biri.'";
"NovelMaidPromptSix" = "Bekle, gerçekten mi?";
"NovelMaidActionSixA" = "Bildiğin her şeyi anlat";
"NovelMaidActionSixB" = "Bu doğru olamaz";
"NovelMaidContentSeven" = "Notlar gizli bir aşktan bahsediyor. Elena yaklaşır, gözyaşları ay ışığında parlar. 'Çalmaya çalışmıyordum. Sadece buraya ait olup olmadığımı öğrenmek istedim.'";
"NovelMaidPromptSeven" = "Onu teselli et?";
"NovelMaidActionSevenA" = "Elini omzuna koy";
"NovelMaidActionSevenB" = "Ona biraz alan bırak";
"NovelMaidContentEight" = "Annesinin günlüğünde bu odadaki gizli bir gerçekten bahsedildiğini açıklıyor. 'Tüm hayatımı burada geçirdim efendim ama bir hayalet gibi hissediyorum.'";
"NovelMaidPromptEight" = "Bir söz ver?";
"NovelMaidActionEightA" = "Gerçeği keşfetmene yardım edeceğim";
"NovelMaidActionEightB" = "Bunu birlikte çözeceğiz";
"NovelMaidContentNine" = "Takip eden saati eski belgeleri arayarak geçiriyorsunuz. Tanıdık bir soyadına sahip bir doğum belgesi buluyorsunuz ama baba kısmı boş.";
"NovelMaidPromptNine" = "Elena'ya bak?";
"NovelMaidActionNineA" = "Amcamı kastediyor olabilir mi?";
"NovelMaidActionNineB" = "Belki de bilinmemesi daha iyidir";
"NovelMaidContentTen" = "Arama derinleşiyor. Elena belgelerin arkasına saklanmış bir mücevher kutusu fark ediyor. İçinde tıpkı kendisine benzeyen bir kadının portresini içeren bir madalyon var.";
"NovelMaidPromptTen" = "Ona göster?";
"NovelMaidActionTenA" = "Bu madalyona bir bak";
"NovelMaidActionTenB" = "Bu annen olabilir mi?";
"NovelMaidContentEleven" = "Aniden yakınlardaki bir tahta gıcırdıyor. Biri koridorda yürüyor. Elena'nın gözleri korkuyla açılıyor. 'Kahyaya yakalanırsak...!'";
"NovelMaidPromptEleven" = "Saklan?";
"NovelMaidActionElevenA" = "Dolaba birlikte saklanın";
"NovelMaidActionElevenB" = "Burada kalıp yüzleşin";
"NovelMaidContentTwelve" = "Adımlar yaklaşıyor. Elena kolunu tutuyor. 'Lütfen efendim, bunu ortaya çıkardığımızı kimse bilmemeli. Benim için tehlikeli.'";
"NovelMaidPromptTwelve" = "Yanıtın?";
"NovelMaidActionTwelveA" = "Işıkları kapat";
"NovelMaidActionTwelveB" = "Kapıyı emniyete al";
"NovelMaidContentThirteen" = "Oda zifiri karanlık. Bu dar alanda Elena'nın hızlı nabzını duyuyor ve gül kokusunu alıyorsun. Çok yakınında duruyor.";
"NovelMaidPromptThirteen" = "Geri fısılda?";
"NovelMaidActionThirteenA" = "Benimle güvendesin";
"NovelMaidActionThirteenB" = "(Sessiz kal ve bekle)";
"NovelMaidContentFourteen" = "Kapıyı kapalı tutuyorsun. Dışarıdaki kişi kısa bir süre duraklıyor, ardından devam ediyor. Elena adrenalinden titreyerek sana yaslanıyor.";
"NovelMaidPromptFourteen" = "Onu sakinleştir?";
"NovelMaidActionFourteenA" = "Uzaklaştılar";
"NovelMaidActionFourteenB" = "İyi misin?";
"NovelMaidContentFifteen" = "Hafifçe geri çekiliyor ama eli göğsünde kalıyor. 'Efendim... Size her zaman uzaktan hayrandım. Bu sır... tek başına taşımak için çok ağır.'";
"NovelMaidPromptFifteen" = "Duygularını ifade et?";
"NovelMaidActionFifteenA" = "Ben de seni fark etmiştim";
"NovelMaidActionFifteenB" = "Benim için bir hizmetçiden fazlasısın";
"NovelMaidContentSixteen" = "'Sizin için sadece bir hizmetçi olduğumu sanıyordum,' diye fısıldıyor. 'Mülkün sadece bir parçası. Ama bu gece gerçek bir şeyin başlangıcı gibi hissettiriyor.'";
"NovelMaidPromptSixteen" = "Katılıyor musun?";
"NovelMaidActionSixteenA" = "Bu gerçek, Elena";
"NovelMaidActionSixteenB" = "Bunun bizi nereye götüreceğini görelim";
"NovelMaidContentSeventeen" = "Madalyonun klipsini açıyor. İçinde küçük bir not var: 'Kızıma, meşru varisime.' Elena'nın nefesi kesiliyor. Mülk kanunen ona ait olabilir.";
"NovelMaidPromptSeventeen" = "Bu ne anlama geliyor?";
"NovelMaidActionSeventeenA" = "Bunu ifşa etmeliyiz";
"NovelMaidActionSeventeenB" = "Bunu gizli tutmalıyız";
"NovelMaidContentEighteen" = "Kağıt, Elena'nın mülkün gerçek sahibi olduğunu doğruluyor. Odaya şaşkınlıkla bakıyor. 'Ben... malikaneyi umursamıyorum. Ben sadece bir aile istiyorum.'";
"NovelMaidPromptEighteen" = "Senin dileğin ne?";
"NovelMaidActionEighteenA" = "Artık bana sahipsin";
"NovelMaidActionEighteenB" = "Ne yapmayı planlıyorsun?";
"NovelMaidContentNineteen" = "Şömineye doğru bakıyor. 'Bunu yok edersem sadece Elena olarak kalırım. Tutarsam her şey değişir. Efendim, ne seçmeliyim?'";
"NovelMaidPromptNineteen" = "Ona tavsiye ver?";
"NovelMaidActionNineteenA" = "Bunu yok et ve yanımda kal";
"NovelMaidActionNineteenB" = "Bunu tut ve unvanını talep et";
"NovelMaidContentTwenty" = "Elena soyluluk belgesini tutuyor. 'Bu aile adı bir lanet taşıyor efendim. Sefil bir mirasçı olmaktansa mutlu bir hiç kimse olmayı tercih ederim.'";
"NovelMaidPromptTwenty" = "Senin kararın?";
"NovelMaidActionTwentyA" = "Kalbini dinle";
"NovelMaidActionTwentyB" = "Geleceğini dikkatlice düşün";
"NovelMaidContentTwentyOne" = "Kağıdı sönmekte olan alevlere atıyor. Sır küle dönüşüyor. Elena her zamankinden daha hafif görünerek gülümsüyor.";
"NovelMaidPromptTwentyOne" = "İleride ne var?";
"NovelMaidActionTwentyOneA" = "Yepyeni bir sayfa";
"NovelMaidActionTwentyOneB" = "Sadece ikimiz";
"NovelMaidContentTwentyTwo" = "Kağıdı elbisesinin içine koyuyor. 'O zaman bu evin Hanımefendisi olacağım. Ve yanımda bir partnere ihtiyacım olacak.'";
"NovelMaidPromptTwentyTwo" = "Hazır mısın?";
"NovelMaidActionTwentyTwoA" = "Her zaman hazır";
"NovelMaidActionTwentyTwoB" = "Zorlu bir yolculuk olacak";
"NovelMaidContentTwentyThree" = "Elena artık sadece bir hizmetçi değil. O senin dengin, partnerin ve ortak sırrın. Malikane senin kalır ama kalbi ona aittir.";
"NovelMaidPromptTwentyThree" = "SON";
"NovelMaidActionTwentyThreeA" = "Hikayeyi Tekrar Oyna";
"NovelMaidActionTwentyThreeB" = "Çıkış";
"NovelMaidContentTwentyFour" = "Gerçek ortaya çıktı. Elena evin başı olur. Dinamik değişti ama o gece kurduğunuz bağ sarsılmaz kalıyor.";
"NovelMaidPromptTwentyFour" = "SON";
"NovelMaidActionTwentyFourA" = "Hikayeyi Tekrar Oyna";
"NovelMaidActionTwentyFourB" = "Çıkış";

"NovelTokyoContentZero" = "Shinjuku'nun neon caddelerine yağmur yağıyor. Sakin bir barda otururken sırılsıklam ceketli bir kadın yanına oturuyor. Yasemin ve barut kokuyor.";
"NovelTokyoPromptZero" = "Sohbeti nasıl başlatırsın?";
"NovelTokyoActionZeroA" = "Ona bir içki ısmarla";
"NovelTokyoActionZeroB" = "Zor bir gece, değil mi?";
"NovelTokyoContentOne" = "Bardağına, ardından sana bakıyor. 'Cesursun,' diye fısıldıyor, masanın üzerinden küçük bir mikroçip kaydırarak.";
"NovelTokyoPromptOne" = "Çipi alacak mısın?";
"NovelTokyoActionOneA" = "Al ve sakla";
"NovelTokyoActionOneB" = "Bela istemiyorum";
"NovelTokyoContentTwo" = "Acı bir kahkaha atıyor. 'Hiçbir fikrin yok.' Omuzunun üzerinden bakıyor. Takım elbiseli iki adam bara girdi.";
"NovelTokyoPromptTwo" = "Saklanmasına yardım et?";
"NovelTokyoActionTwoA" = "Beni arka çıkıştan takip et";
"NovelTokyoActionTwoB" = "Birlikteymişiz gibi davran";
"NovelTokyoContentThree" = "Onu kendine çekiyorsun. Adamlar mekanı arayıp çıkıyor. Elleri hala titriyor olsa da rahatlamış görünüyor. 'Ben Mia,' diye fısıldıyor.";
"NovelTokyoPromptThree" = "Tehlike hakkında soru sor?";
"NovelTokyoActionThreeA" = "O adamlar kimdi Mia?";
"NovelTokyoActionThreeB" = "Tehlikeden uzak mıyız?";
"NovelTokyoContentFour" = "Adamlar yaklaşıyor ama sakin kalıyorsun. Geçip gidiyorlar. 'Beni kurtardın. Ben Mia. Ama bu mikroçip... bir milyon hayata bedel.'";
"NovelTokyoPromptFour" = "Çip hakkında soru sor?";
"NovelTokyoActionFourA" = "Üzerinde ne depolanmış?";
"NovelTokyoActionFourB" = "Buradan ayrılmalıyız";
"NovelTokyoContentFive" = "Mia kapıya bakıyor. 'Arasaka Şirketi bunu istiyor. Bu sadece veri değil, dijital bir ruh.'";
"NovelTokyoPromptFive" = "Ona inanıyor musun?";
"NovelTokyoActionFiveA" = "Dijital bir ruh mu? Cidden mi?";
"NovelTokyoActionFiveB" = "Bununla ilgili fısıltılar duymuştum...";
"NovelTokyoContentSix" = "Mia bileğini tutuyor. 'Yüklenene kadar hiçbir yer güvenli değil. Teknoloji Bölgesi'ne gitmeliyiz.'";
"NovelTokyoPromptSix" = "Eşlik et?";
"NovelTokyoActionSixA" = "Seni oraya götüreceğim";
"NovelTokyoActionSixB" = "Sadece daha fazla açıklarsan";
"NovelTokyoContentSeven" = "Arka sokaktan çıkıyorsunuz. Karanlık pasaj ozon kokuyor. Aniden yukarıda bir dron beliriyor, termal imzaları tarıyor.";
"NovelTokyoPromptSeven" = "Dronu nasıl atlatırsınız?";
"NovelTokyoActionSevenA" = "Tenten altında saklanın";
"NovelTokyoActionSevenB" = "Metroya doğru koşun";
"NovelTokyoContentEight" = "Mia bardaktan boşanırcasına yağan yağmurda duraklıyor. 'Beni yakalarlarsa zihnimi silecekler. Ve yardım ettiğin için seninkini de.'";
"NovelTokyoPromptEight" = "Güven ver?";
"NovelTokyoActionEightA" = "Bu işte seninleyim";
"NovelTokyoActionEightB" = "Hızlı hareket etmeye devam edelim";
"NovelTokyoContentNine" = "Dron uzaklaşıyor. Aracına ulaşıyorsunuz. Mia sana endişe ve minnet karışımıyla bakıyor.";
"NovelTokyoPromptNine" = "Arabayı çalıştır?";
"NovelTokyoActionNineA" = "Gaza bas!";
"NovelTokyoActionNineB" = "Karışmak için sessizce sür";
"NovelTokyoContentTen" = "İstasyona zor yetişiyorsunuz. Kalabalık ideal bir koruma sağlıyor. Mia yakın duruyor, omuzu seninkine basıyor.";
"NovelTokyoPromptTen" = "Devam et?";
"NovelTokyoActionTenA" = "Hızlı treni yakala";
"NovelTokyoActionTenB" = "Tünellerden ilerle";
"NovelTokyoContentEleven" = "Gökdelen bölgesinden geçiyorsunuz. Holografik reklamlar Mia'nın yüzünü pembe ve mavi tonlarında aydınlatıyor.";
"NovelTokyoPromptEleven" = "Sessizliği boz?";
"NovelTokyoActionElevenA" = "Neden beni seçtin Mia?";
"NovelTokyoActionElevenB" = "Bana bu çipten bahset";
"NovelTokyoContentTwelve" = "Şehir bitmeyen bir labirent gibi. Kısa bir süre dinlenmek için gizli bir ramen dükkanında duruyorsunuz.";
"NovelTokyoPromptTwelve" = "Sokağı tara?";
"NovelTokyoActionTwelveA" = "Takip eden var mı bak";
"NovelTokyoActionTwelveB" = "Mia ile konuş";
"NovelTokyoContentThirteen" = "Mia aşağı bakıyor. 'Bu gece tehlikeli görünmeyen tek kişi sendin. Bir paralı asker değil, bir insana ihtiyacım vardı.'";
"NovelTokyoPromptThirteen" = "Yumuşakça yanıt ver?";
"NovelTokyoActionThirteenA" = "Orada olduğuma sevindim";
"NovelTokyoActionThirteenB" = "Ben sadece bardaki sıradan bir adamım";
"NovelTokyoContentFourteen" = "Mia çipe dokunuyor. 'Bu kız kardeşimin bilincini taşıyor. Çok fazla şey ortaya çıkaran bir netrunner'dı. Bedenini yok ettiler.'";
"NovelTokyoPromptFourteen" = "Üzüntünü paylaş?";
"NovelTokyoActionFourteenA" = "Bu korkunç...";
"NovelTokyoActionFourteenB" = "Onu kurtarmanın bir yolu var mı?";
"NovelTokyoContentFifteen" = "Bir gözyaşını siliyor. 'Terminal eski TV kulesinde. Ama ana köprü polis tarafından kapatılmış.'";
"NovelTokyoPromptFifteen" = "Nasıl geçeceksiniz?";
"NovelTokyoActionFifteenA" = "Hackle araçlarını kullan";
"NovelTokyoActionFifteenB" = "Bekçilere rüşvet ver";
"NovelTokyoContentSixteen" = "Mia bir harita gösteriyor. 'Kanalizasyon rotasını kullanmak daha güvenli, ancak çok daha uzun sürüyor.'";
"NovelTokyoPromptSixteen" = "Bir rota seç?";
"NovelTokyoActionSixteenA" = "Kanalizasyona inelim";
"NovelTokyoActionSixteenB" = "Hayır, hız kritik";
"NovelTokyoContentSeventeen" = "Nemli ve karanlık ama etkili. Mia senin rehberliğine güveniyor. Güveninin ağırlığını hissediyorsun.";
"NovelTokyoPromptSeventeen" = "Engeli geçmesine yardım et?";
"NovelTokyoActionSeventeenA" = "Elini uzat";
"NovelTokyoActionSeventeenB" = "Önden git";
"NovelTokyoContentEighteen" = "Köprü karmaşık. Kaçmak için kargaşayı kullanıyorsunuz. Mia'nın kalbi o kadar hızlı çarpıyor ki neredeyse duyabiliyorsun.";
"NovelTokyoPromptEighteen" = "Sakin kalmasını sağla?";
"NovelTokyoActionEighteenA" = "Neredeyse vardık";
"NovelTokyoActionEighteenB" = "Odaklan Mia";
"NovelTokyoContentNineteen" = "TV kulesi ileride duruyor. Çelik yapılarla çevrili geçmişin bir kalıntısı. Mia yorgun görünüyor.";
"NovelTokyoPromptNineteen" = "Mola ver?";
"NovelTokyoActionNineteenA" = "Beş dakika dinlen";
"NovelTokyoActionNineteenB" = "Zirveye doğru ilerle";
"NovelTokyoContentTwenty" = "Kulenin tabanına ulaşıyorsunuz. 'Asansör çalışmıyor,' diye iç çekiyor Mia. 'Merdivenleri kullanmalıyız.'";
"NovelTokyoPromptTwenty" = "Cesaretlendir?";
"NovelTokyoActionTwentyA" = "Her seferinde bir adım";
"NovelTokyoActionTwentyB" = "Ekipmanı ben taşıyacağım";
"NovelTokyoContentTwentyOne" = "Merdiven boşluğunda dinleniyorsunuz. Mia omzuna yaslanıyor. 'Başarırsak... yarın ne yapacaksın?'";
"NovelTokyoPromptTwentyOne" = "Geleceği düşün?";
"NovelTokyoActionTwentyOneA" = "Belki bir kahve içeriz";
"NovelTokyoActionTwentyOneB" = "Sadece dinlendiğime sevineceğim";
"NovelTokyoContentTwentyTwo" = "Tırmanış zorlu. Yarı yolda aşağıda sirenler çalıyor. Aracınızı takip etmişler.";
"NovelTokyoPromptTwentyTwo" = "Acele et?";
"NovelTokyoActionTwentyTwoA" = "Hızımızı ikiye katlayalım!";
"NovelTokyoActionTwentyTwoB" = "Bir saklanma yeri bul";
"NovelTokyoContentTwentyThree" = "Sunucu odasına ulaşıyorsunuz. Hava soğuk ve güçle vızlıyor. Mia çipi takıyor. 'Başlatılıyor...' diyor.";
"NovelTokyoPromptTwentyThree" = "Ekranı izle?";
"NovelTokyoActionTwentyThreeA" = "Girişi koru";
"NovelTokyoActionTwentyThreeB" = "Mia'nın yanında kal";
"NovelTokyoContentTwentyFour" = "Konsol eski ama aktif. Mia'nın parmakları tuşlarda uçuşuyor. 'Güvenlik duvarı devasa!'";
"NovelTokyoPromptTwentyFour" = "Hacklemesine yardım et?";
"NovelTokyoActionTwentyFourA" = "Güç kaynağını devral";
"NovelTokyoActionTwentyFourB" = "Onu sakin tut";
"NovelTokyoContentTwentyFive" = "Kapılar tıslayarak açılıyor. Arasaka'nın taktik ekibi geldi. Silahını kılıfından çıkarıyorsun. 'Sadece iki dakika daha!' diye bağırıyor Mia.";
"NovelTokyoPromptTwentyFive" = "Çizgiyi koru?";
"NovelTokyoActionTwentyFiveA" = "Ateş aç!";
"NovelTokyoActionTwentyFiveB" = "Kapıyı engelle";
"NovelTokyoContentTwentySix" = "Mia'nın gözleri mavi parlıyor. Tamamen ağın içinde. Askerler cam çatıyı kırıyor.";
"NovelTokyoPromptTwentySix" = "Mia'yı koru?";
"NovelTokyoActionTwentySixA" = "Bedeninle ona siper ol";
"NovelTokyoActionTwentySixB" = "Onu siper alanına çek";
"NovelTokyoContentTwentySeven" = "Parlak bir ışık patlaması beliriyor. Yükleme %100'e ulaşıyor. Askerler siber donanımları ağdan kilitlendiği için donup kalıyor.";
"NovelTokyoPromptTwentySeven" = "Mia'yı kontrol et?";
"NovelTokyoActionTwentySevenA" = "Tamamlandı mı?";
"NovelTokyoActionTwentySevenB" = "İyi misin?";
"NovelTokyoContentTwentyEight" = "Her şey kararıyor. Aniden Tokyo'daki her ekranda tek bir mesaj beliriyor: 'ÖZGÜRLÜK'. Mia kollarına yığılıyor.";
"NovelTokyoPromptTwentyEight" = "Onu uyandır?";
"NovelTokyoActionEightA" = "Mia! Benimle konuş!";
"NovelTokyoActionEightB" = "Onu sıkıca tut";
"NovelTokyoContentTwentyNine" = "Dönüşmüş bir Tokyo'nun üzerine güneş doğuyor. Mia gülümsüyor, gözleri normale dönmüş. 'O güvende. Biz güvendeyiz.'";
"NovelTokyoPromptTwentyNine" = "SON";
"NovelTokyoActionTwentyNineA" = "Hikayeyi Tekrar Oyna";
"NovelTokyoActionTwentyNineB" = "Çıkış";

"NovelCampContentZero" = "Yaz kampının son gecesi. Çıtırdayan kamp ateşi sönüyor ve havayı çam kokusu dolduruyor. Genellikle sessiz olan Yuki gözlerini yakalıyor ve karanlık göl patikasına doğru işaret ediyor.";
"NovelCampPromptZero" = "Geceye doğru onu takip edecek misin?";
"NovelCampActionZeroA" = "Bu anı bekliyordum";
"NovelCampActionZeroB" = "Tabii, gidelim";
"NovelCampContentOne" = "Ona yetişiyorsun. Orman cırcır böceklerinin sesiyle uğulduyor. Yürürken Yuki'nin eli seninkine hafifçe değiyor. Endişeli görünüyor.";
"NovelCampPromptOne" = "Sessizliği nasıl bozarsın?";
"NovelCampActionOneA" = "Elini sıkıca tut";
"NovelCampActionOneB" = "Ne düşündüğünü sor";
"NovelCampContentTwo" = "Yan yana yürüyorsunuz. Ay ışığı yoğun ağaçlardan zar zor süzülüyor. Yuki yumuşakça gülümseyerek sana yan bakıyor. 'Gerçekten geleceğini tahmin etmemiştim,' diye fısıldıyor.";
"NovelCampPromptTwo" = "Nasıl yanıt verirsin?";
"NovelCampActionTwoA" = "Hiçbir şey için kaçırmazdım";
"NovelCampActionTwoB" = "Merak etmiştim";
"NovelCampContentThree" = "İskeleye ulaşıyorsunuz. Göl karanlık bir ayna gibi, yıldızlarla dolu bir gökyüzünü yansıtıyor. Yuki ayakkabılarını çıkarıp kenara oturuyor, ayaklarını sallandırıyor.";
"NovelCampPromptThree" = "Ona yakın otur?";
"NovelCampActionThreeA" = "Tam yanına otur";
"NovelCampActionThreeB" = "Ona biraz alan bırak";
"NovelCampContentFour" = "İskele ağırlığınla gıcırdıyor. Sudan gelen soğuk rüzgar Yuki'yi hafifçe titretiyor. Sen yaklaşırken yakın kalıyor.";
"NovelCampPromptFour" = "Ceketini teklif et?";
"NovelCampActionFourA" = "Ceketini ona sar";
"NovelCampActionFourB" = "Sadece otur ve konuş";
"NovelCampContentFive" = "Yuki yıldızlara bakıyor. 'Buradaki ilk günümüzü hatırlıyor musun?' diye soruyor. 'Herkes meşgulken bagajıma yardım etmiştin.'";
"NovelCampPromptFive" = "Hatırlıyor musun?";
"NovelCampActionFiveA" = "Her detayını hatırlıyorum";
"NovelCampActionFiveB" = "Çok uzun zaman önce gibi hissettiriyor";
"NovelCampContentSix" = "Yumuşakça kıkırdıyor. 'O zamanlar çok korkmuştum. Ama senin yanında olmak bana kendimi burada güvende hissettirdi.' Suyu seyrediyor.";
"NovelCampPromptSix" = "Kendi duygularını itiraf et?";
"NovelCampActionSixA" = "Ben de tam olarak aynı hissettim";
"NovelCampActionSixB" = "Yardım edebildiğime sevindim";
"NovelCampContentSeven" = "Gece tamamen sakin. Aniden Yuki ayağa kalkıyor. 'Su çok davetkar görünüyor. İçeri... atlasak mı?' diye soruyor oyuncu bir gülümsemeyle.";
"NovelCampPromptSeven" = "Cesur musun?";
"NovelCampActionSevenA" = "Hadi atlayalım!";
"NovelCampActionSevenB" = "Çok soğuk Yuki";
"NovelCampContentEight" = "Göle bakıyor, sonra sana bakıyor. 'Bu gece cesurca bir şey yapmak istiyorum. Bütün kış hatırlayacağım bir şey.'";
"NovelCampPromptEight" = "Cesaretlendir?";
"NovelCampActionEightA" = "Benimle atla?";
"NovelCampActionEightB" = "Burada kalalım";
"NovelCampContentNine" = "ŞALPATI! Su dondurucu ama heyecan verici. Sen ve Yuki su yüzüne çıkıyorsunuz, çocuklar gibi gülüşüp nefes nefese birbirinize su sıçratıyorsunuz.";
"NovelCampPromptNine" = "Ona daha yakın yüz?";
"NovelCampActionNineA" = "Onu sarılmaya çek";
"NovelCampActionNineB" = "Su sıçratmaya devam et!";
"NovelCampContentTen" = "Ahşap iskelede kalıyorsunuz. Okul, aile ve gelecek hakkında saatlerce konuşuyorsunuz. Sessiz havada bağ derinleşiyor.";
"NovelCampPromptTen" = "Yaklaş?";
"NovelCampActionTenA" = "Başını onun başının üzerine koy";
"NovelCampActionTenB" = "Gözlerinin içine bak";
"NovelCampContentEleven" = "Atmosphere değişiyor. Yuki sessizleşiyor. Loş ışıkta gözleri seninkileri arıyor. 'Yarın şehre dönmek istemiyorum,' diye fısıldıyor.";
"NovelCampPromptEleven" = "Ne cevap veriyorsun?";
"NovelCampActionElevenA" = "Orada görüşeceğiz";
"NovelCampActionElevenB" = "Yarına odaklanmayalım";
"NovelCampContentTwelve" = "Yuki derin bir nefes alıyor. 'Bunu şimdi söylemezsem asla söyleyemeyeceğim. Otobüs durağındaki ilk günümüzden beri senden hoşlanıyorum.'";
"NovelCampPromptTwelve" = "Nasıl yanıt verirsin?";
"NovelCampActionTwelveA" = "Ben de senden hoşlanıyordum";
"NovelCampActionTwelveB" = "Nihayet gerçekler!";
"NovelCampContentThirteen" = "Cebine uzanıp dokunma bir dostluk bileziği çıkarıyor. Gölün renkleriyle eşleşen mavi ve beyaz. 'Bunu senin için yaptım,' diyor utangaçça.";
"NovelCampPromptThirteen" = "Hediyeyi kabul et?";
"NovelCampActionThirteenA" = "Bileğine bağlamasına izin ver";
"NovelCampActionThirteenB" = "Bunun yerine ona bir öpücük ver";
"NovelCampContentFourteen" = "Bilezik basit ama hazırlamasının saatler sürdüğünü biliyorsun. Tepkini bekliyor, dudağı hafifçe titriyor.";
"NovelCampPromptFourteen" = "Hamlen ne?";
"NovelCampActionFourteenA" = "Sarılıp teşekkür et";
"NovelCampActionFourteenB" = "Harika olduğunu söyle";
"NovelCampContentFifteen" = "Yuki gülümsüyor, parlak ve samimi bir gülümseme. 'Çocukça olduğunu düşüneceğinden korkmuştum.' Aya bakıyor, şimdi daha kendinden emin görünüyor.";
"NovelCampPromptFifteen" = "Bir söz ver?";
"NovelCampActionFifteenA" = "Her gün arayacağıma söz ver";
"NovelCampActionFifteenB" = "Yakında ziyaret edeceğime söz ver";
"NovelCampContentSixteen" = "Atmosfer elektrikli. Yuki dudaklarına bakıyor. Etraf yok oluyor; yaz gecesinde sadece ikiniz varsınız.";
"NovelCampPromptSixteen" = "O an bu an mı?";
"NovelCampActionSixteenA" = "Öpücük için yaklaş";
"NovelCampActionSixteenB" = "Tatlı bir şey fısılda";
"NovelCampContentSeventeen" = "Tam o sırada gökyüzünde kayan bir yıldız gümüş bir iz bırakıyor. Yuki'nin nefesi kesiliyor. 'Çabuk! Bir dilek tut!' diye bağırıyor.";
"NovelCampPromptSeventeen" = "Ne diliyorsun?";
"NovelCampActionSeventeenA" = "Birlikte bir gelecek dile";
"NovelCampActionSeventeenB" = "Bu gecenin sürmesini dile";
"NovelCampContentEighteen" = "Yıldız belirdiği hızla kayboluyor. Yuki gözlerini sıkıca kapatıyor. 'Özel bir şey diledim,' diyor kızararak.";
"NovelCampPromptEighteen" = "Ne olduğunu sor?";
"NovelCampActionEighteenA" = "Dileğini bana söyle";
"NovelCampActionEighteenB" = "Ne olduğunu tahmin edebiliyorum";
"NovelCampContentNineteen" = "Kamp ateşi artık tamamen söndü. El ele geri yürümeye başlıyorsunuz. Orman şimdi farklı hissettiriyor—daha az korkutucu, daha büyülü.";
"NovelCampPromptNineteen" = "Yavaş mı yürüyorsunuz?";
"NovelCampActionNineteenA" = "Geri dönmek için uzun yolu seçin";
"NovelCampActionNineteenB" = "Sessiz anın tadını çıkarın";
"NovelCampContentTwenty" = "İlk tanıştığınız eski meşe ağacının yanından geçiyorsunuz. Yuki bir saniye duraklıyor. 'Her şey değişmek üzere, değil mi?' diye soruyor yumuşakça.";
"NovelCampPromptTwenty" = "Onu rahatlat?";
"NovelCampActionTwentyA" = "Değişim olumlu olabilir";
"NovelCampActionTwentyB" = "Her şeyin değişmesi gerekmiyor";
"NovelCampContentTwentyOne" = "Kamp kulübeleri görünüyor. Diğer kampçılar uyuyor. Yuki kapısının önünde duruyor. Elini bırakmakta tereddüt ediyor.";
"NovelCampPromptTwentyOne" = "Son bir şey?";
"NovelCampActionTwentyOneA" = "Bir veda öpücüğü iste";
"NovelCampActionTwentyOneB" = "Telefon numarasını iste";
"NovelCampContentTwentyTwo" = "Yuki kapıda kalıyor. Veranda lambası yüzüne sıcak bir ışık vuruyor. 'Bu gece için teşekkür ederim. Hayatımın en iyi akşamıydı.'";
"NovelCampPromptTwentyTwo" = "Hoşçakal de?";
"NovelCampActionTwentyTwoA" = "Sabah görüşürüz";
"NovelCampActionTwentyTwoB" = "İyi geceler Yuki";
"NovelCampContentTwentyThree" = "Gündoğumu. Kamp, çantalarını toplayan ve otobüslere binen insanlarla dolu. Kalbin hızla çarparak kalabalıkta Yuki'yi arıyorsun.";
"NovelCampPromptTwentyThree" = "Onu bulabilir misin?";
"NovelCampActionTwentyThreeA" = "Otobüsün yanında ara";
"NovelCampActionTwentyThreeB" = "İskeleyi son bir kez kontrol et";
"NovelCampContentTwentyFour" = "Otobüs motorları rölantide çalışıyor. Onu gördün! Kapının yanında duruyor, gözleri seninkilerle buluşana kadar endişeyle etrafa bakıyor.";
"NovelCampPromptTwentyFour" = "Yanına koş?";
"NovelCampActionTwentyFourA" = "Koş ve ona sarıl";
"NovelCampActionTwentyFourB" = "El sallayıp gülümse";
"NovelCampContentTwentyFive" = "Tam zamanında ona ulaşıyorsun. Kulağına sonsuza dek hatırlayacağın bir cümle fısıldıyor. 'Bunun sadece bir yaz anısı olarak kalmasına izin verme.'";
"NovelCampPromptTwentyFive" = "Cevabını ver?";
"NovelCampActionTwentyFiveA" = "Söz veriyorum";
"NovelCampActionTwentyFiveB" = "Gelecek hafta sonu görüşürüz";
"NovelCampContentTwentySix" = "Otobüs şoförü korna çalıyor. Yuki gitmek zorunda. Araç adım atarken sana bir öpücük gönderiyor. Otobüsün uzaklaşmasını izleyerek orada duruyorsun.";
"NovelCampPromptTwentySix" = "Nasıl hissediyorsun?";
"NovelCampActionTwentySixA" = "Mutlu ve umutlu";
"NovelCampActionTwentySixB" = "Üzgün ama tatmin olmuş";
"NovelCampContentTwentySeven" = "Aylar sonra. Şehirdesin ve telefonun titriyor. Yuki'den bir fotoğraf—paylaştığınız bileziği takıyor. Yaz hiçbir zaman gerçekten bitmedi.";
"NovelCampPromptTwentySeven" = "SON";
"NovelCampActionTwentySevenA" = "Hikayeyi Tekrar Oyna";
"NovelCampActionTwentySevenB" = "Çıkış";
"NovelCampContentTwentyEight" = "Bileğindeki bileziğe bakıyorsun. Biraz eskimiş ama anılar canlı kalıyor. Bazen bir ömür sürmesi için tek bir yaz yeterlidir.";
"NovelCampPromptTwentyEight" = "SON";
"NovelCampActionTwentyEightA" = "Tekrar Dene";
"NovelCampActionTwentyEightB" = "Çıkış";

