"NovelMaidContentZero" = "Het landhuis is stil bij je terugkomst. Een zacht licht brandt in je kantoor. Je ziet Elena, je stilste dienstmeid, om 2 uur 's nachts nerveus je bureau opruimen.";
"NovelMaidPromptZero" = "Stap op haar af?";
"NovelMaidActionZeroA" = "Elena, waarom ben je niet aan het rusten?";
"NovelMaidActionZeroB" = "(Observeer vanuit het donker)";
"NovelMaidContentOne" = "Ze schrikt en laat een stofdoek vallen. 'Meneer! Ik... ik kon niet slapen. Het stof stoorde me.' Ze ziet er bleek uit en ontwijkt je blik.";
"NovelMaidPromptOne" = "Geloof je haar?";
"NovelMaidActionOneA" = "Het is veel te laat om schoon te maken";
"NovelMaidActionOneB" = "Je bent een hardwerkende medewerker";
"NovelMaidContentTwo" = "Je ziet hoe ze een klein zilveren sleuteltje uit haar schort haalt. Ze kijkt er met een mengeling van verlangen en angst naar voordat ze je schaduw opmerkt.";
"NovelMaidPromptTwo" = "Stap naar voren?";
"NovelMaidActionTwoA" = "Waar is die sleutel voor, Elena?";
"NovelMaidActionTwoB" = "Leg uit wat je hier aan het doen bent";
"NovelMaidContentThree" = "Ze rilt. 'Deze plek... verbergt zoveel geheimen, meneer. Soms voelen ze als een zware last.' Ze wijst naar de oude kluis achter de boekenkast.";
"NovelMaidPromptThree" = "Vragen naar de kluis?";
"NovelMaidActionThreeA" = "Past die sleutel daarin?";
"NovelMaidActionThreeB" = "De kluis is verboden terrein";
"NovelMaidContentFour" = "Ze probeert de sleutel te verbergen, maar laat hem vallen. 'Ik ben geen dief, ik zweer het! Ik... vond hem op de gang en dacht dat hij van u was.'";
"NovelMaidPromptFour" = "Pak de sleutel op?";
"NovelMaidActionFourA" = "(Pak hem van de vloer)";
"NovelMaidActionFourB" = "Laten we kijken wat hij opent";
"NovelMaidContentFive" = "De sleutel past op een geheim vakje in de kluis. Elena houdt haar adem in als je een stapel vergeelde brieven met een zwart lint tevoorschijn haalt.";
"NovelMaidPromptFive" = "De eerste brief bekijken?";
"NovelMaidActionFiveA" = "Lees hem hardop voor";
"NovelMaidActionFiveB" = "Vraag Elena of ze hier iets van weet";
"NovelMaidContentSix" = "Elena's stem wordt een fluistering. 'Mijn moeder was hier vroeger ook dienstmeid. Ze vertelde me dat de Heer aantekeningen bijhield over een meisje van wie hij hield. Iemand die op mij leek.'";
"NovelMaidPromptSix" = "Wacht, meen je dat?";
"NovelMaidActionSixA" = "Vertel me alles wat je weet";
"NovelMaidActionSixB" = "Dit kan niet waar zijn";
"NovelMaidContentSeven" = "De brieven vertellen over een geheime liefde. Elena komt dichterbij, het maanlicht schittert in haar tranen. 'Ik wilde niets stelen. Ik wilde alleen weten of ik hier thuishoor.'";
"NovelMaidPromptSeven" = "Troost haar?";
"NovelMaidActionSevenA" = "Leg een hand op haar schouder";
"NovelMaidActionSevenB" = "Geef haar wat ruimte";
"NovelMaidContentEight" = "Ze vertelt dat het dagboek van haar moeder sprak over een verborgen waarheid in deze kamer. 'Ik woon hier mijn hele leven, meneer, maar ik voel me een geest.'";
"NovelMaidPromptEight" = "Doe een belofte?";
"NovelMaidActionEightA" = "Ik help je de waarheid te ontdekken";
"NovelMaidActionEightB" = "We zoeken dit samen uit";
"NovelMaidContentNine" = "Je brengt het volgende uur door met het doorzoeken van oude documenten. Je vindt een geboorteakte met een bekende achternaam, maar de vader is leeg gelaten.";
"NovelMaidPromptNine" = "Kijk naar Elena?";
"NovelMaidActionNineA" = "Zou het naar mijn oom kunnen verwijzen?";
"NovelMaidActionNineB" = "Misschien kunnen we het beter zo laten";
"NovelMaidContentTen" = "Het zoeken wordt intenser. Elena ziet een sieradendoosje achter de papieren. Erin ligt een medaillon met een portret van een vrouw die precies op haar lijkt.";
"NovelMaidPromptTen" = "Laat het haar zien?";
"NovelMaidActionTenA" = "Kijk eens naar dit medaillon";
"NovelMaidActionTenB" = "Zou dit jouw moeder kunnen zijn?";
"NovelMaidContentEleven" = "Plotseling kraakt er een vloerplank in de gang. Iemand loopt voorbij. Elena's ogen worden groot van schrik. 'Als de butler ons betrapt...!'";
"NovelMaidPromptEleven" = "Schuilen?";
"NovelMaidActionElevenA" = "Verstop je samen in de kast";
"NovelMaidActionElevenB" = "Blijf hier en confronteer hem";
"NovelMaidContentTwelve" = "Voetstappen komen dichterbij. Elena grijpt je arm vast. 'Ablieft meneer, niemand mag weten dat we dit gevonden hebben. Het is gevaarlijk voor mij.'";
"NovelMaidPromptTwelve" = "Jouw reactie?";
"NovelMaidActionTwelveA" = "Doe de lichten uit";
"NovelMaidActionTwelveB" = "Houd de deur dicht";
"NovelMaidContentThirteen" = "De kamer is roetdonker. In de krappe ruimte hoor je Elena's snelle ademhaling en ruik je rozen. Ze staat ontzettend dicht bij je.";
"NovelMaidPromptThirteen" = "Fluister terug?";
"NovelMaidActionThirteenA" = "Je bent veilig bij mij";
"NovelMaidActionThirteenB" = "(Blijf stil en wacht)";
"NovelMaidContentFourteen" = "Je houdt de deur dicht. De persoon buiten twijfelt even en loopt dan door. Elena leunt tegen je aan, trillend van de spanning.";
"NovelMaidPromptFourteen" = "Kalmeer haar?";
"NovelMaidActionFourteenA" = "Ze zijn weggelopen";
"NovelMaidActionFourteenB" = "Gaat het met je?";
"NovelMaidContentFifteen" = "Ze deinst iets achteruit, maar haar hand rust op je borst. 'Meneer... ik heb u altijd van een afstandje bewonderd. Dit geheim... is te zwaar om alleen te dragen.'";
"NovelMaidPromptFifteen" = "Uit je gevoelens?";
"NovelMaidActionFifteenA" = "Jij bent mij ook opgevallen";
"NovelMaidActionFifteenB" = "Je betekent meer voor me dan een dienstmeid";
"NovelMaidContentSixteen" = "'Ik dacht dat ik slechts een bediende voor u was,' fluistert ze. 'Gewoon onderdeel van het huis. Maar vanavond voelt als het begin van iets echts.'";
"NovelMaidPromptSixteen" = "Ben je het met haar eens?";
"NovelMaidActionSixteenA" = "Het is echt, Elena";
"NovelMaidActionSixteenB" = "Laten we kijken waar dit heen leidt";
"NovelMaidContentSeventeen" = "Ze opent het medaillon. Erin zit een klein briefje: 'Voor mijn dochter, de rechtmatige erfgenaam.' Elena hapt naar adem. Het landhuis is officieel van haar.";
"NovelMaidPromptSeventeen" = "Wat betekent dit?";
"NovelMaidActionSeventeenA" = "We moeten dit bekendmaken";
"NovelMaidActionSeventeenB" = "We moeten dit geheim houden";
"NovelMaidContentEighteen" = "Het papier bevestigt dat Elena de echte eigenaar is. Ze kijkt verward rond. 'Ik... geef niets om het landhuis. Ik wil gewoon een familie.'";
"NovelMaidPromptEighteen" = "Wat is jouw wens?";
"NovelMaidActionEighteenA" = "Je hebt mij nu";
"NovelMaidActionEighteenB" = "Wat ben je van plan te doen?";
"NovelMaidContentNineteen" = "Ze kijkt naar de haard. 'Als ik dit verbrand, blijf ik gewoon Elena. Als ik het hou, veranderd alles. Meneer, wat moet ik kiezen?'";
"NovelMaidPromptNineteen" = "Geef haar advies?";
"NovelMaidActionNineteenA" = "Verbrand het en blijf aan mijn zijde";
"NovelMaidActionNineteenB" = "Bewaar het en eis je titel op";
"NovelMaidContentTwenty" = "Elena houdt het papier vast. 'Deze familienaam brengt alleen maar ellende. Ik ben liever een gelukkige niemand dan een eenzame erfgename.'";
"NovelMaidPromptTwenty" = "Jouw beslissing?";
"NovelMaidActionTwentyA" = "Luister naar je hart";
"NovelMaidActionTwentyB" = "Denk goed na over je toekomst";
"NovelMaidContentTwentyOne" = "Ze gooit het papier in de uitdoovende vlammen. Het geheim verandert in as. Elena glimlacht, ze voelt zich lichter dan ooit tevoren.";
"NovelMaidPromptTwentyOne" = "Wat brengt de toekomst?";
"NovelMaidActionTwentyOneA" = "Een gloednieuw hoofdstuk";
"NovelMaidActionTwentyOneB" = "Gewoon wij samen";
"NovelMaidContentTwentyTwo" = "Ze stopt het papier veilig weg. 'Dan word ik de Vrouw des Huizes. En daar heb ik een partner bij nodig.'";
"NovelMaidPromptTwentyTwo" = "Ben je er klaar voor?";
"NovelMaidActionTwentyTwoA" = "Altijd klaar voor jou";
"NovelMaidActionTwentyTwoB" = "Het wordt een lastige weg";
"NovelMaidContentTwentyThree" = "Elena is niet langer zomaar een dienstmeid. Ze is je gelijke, je partner en je gedeelde geheim. Het landhuis blijft van jou, maar haar hart is van jou.";
"NovelMaidPromptTwentyThree" = "HET EINDE";
"NovelMaidActionTwentyThreeA" = "Verhaal opnieuw spelen";
"NovelMaidActionTwentyThreeB" = "Aptsluiten";
"NovelMaidContentTwentyFour" = "De waarheid is onthuld. Elena wordt het hoofd van het huis. De verhoudingen zijn veranderd, maar jullie band is onbreekbaar.";
"NovelMaidPromptTwentyFour" = "HET EINDE";
"NovelMaidActionTwentyFourA" = "Verhaal opnieuw spelen";
"NovelMaidActionTwentyFourB" = "Afsluiten";

// Novel 2: Tokyo After Dark
"NovelTokyoContentZero" = "Regen klettert op de neonstraten van Shinjuku. Je zit in een rustige bar wanneer een vrouw in een kletsnatte jas naast je komt zitten. Ze ruikt naar jasmijn en kruitstraf.";
"NovelTokyoPromptZero" = "Hoe begin je een gesprek?";
"NovelTokyoActionZeroA" = "Bestel een drankje voor haar";
"NovelTokyoActionZeroB" = "Zware nacht achter de rug?";
"NovelTokyoContentOne" = "Ze kijkt naar haar glas en daarna naar jou. 'Je hebt moed,' fluistert ze, terwijl ze een kleine microchip over de tafel schuift.";
"NovelTokyoPromptOne" = "Pak je de microchip?";
"NovelTokyoActionOneA" = "Pak hem aan en verberg hem";
"NovelTokyoActionOneB" = "Ik wil geen problemen";
"NovelTokyoContentTwo" = "Ze lacht bitter. 'Je hebt geen idee.' Ze kijkt over haar schouder. Twee mannen in strakke pakken zijn net de bar binnengestapt.";
"NovelTokyoPromptTwo" = "Help haar verbergen?";
"NovelTokyoActionTwoA" = "Volg mij via de achteruitgang";
"NovelTokyoActionTwoB" = "Doe alsof we bij elkaar horen";
"NovelTokyoContentThree" = "Je trekt haar dicht tegen je aan. De mannen zoeken de zaak af en vertrekken. Ze lijkt opgelucht, al trillen haar handen nog. 'Ik ben Mia,' fluistert ze.";
"NovelTokyoPromptThree" = "Vragen naar het gevaar?";
"NovelTokyoActionThreeA" = "Wie waren die mannen, Mia?";
"NovelTokyoActionThreeB" = "Zijn we nu veilig?";
"NovelTokyoContentFour" = "De mannen komen dichterbij, maar je blijft kalm. Ze lopen voorbij. Ze fluistert: 'Je hebt me gered. Ik ben Mia. Maar deze microchip... is een miljoen levens waard.'";
"NovelTokyoPromptFour" = "Vragen naar de microchip?";
"NovelTokyoActionFourA" = "Wat staat erop?";
"NovelTokyoActionFourB" = "We moeten hier weggaan";
"NovelTokyoContentFive" = "Mia kijkt naar de deur. 'Arasaka Corp wil dit hebben. Het is geen data, het is een digitale ziel.'";
"NovelTokyoPromptFive" = "Geloof je haar?";
"NovelTokyoActionFiveA" = "Een digitale ziel? Meen je dat?";
"NovelTokyoActionFiveB" = "Ik heb daar geruchten over gehoord...";
"NovelTokyoContentSix" = "Mia grijpt je pols vast. 'Nergens is het veilig totdat dit is geüpload. We moeten naar het Tech-District.'";
"NovelTokyoPromptSix" = "Ga je met haar mee?";
"NovelTokyoActionSixA" = "Ik breng je er naartoe";
"NovelTokyoActionSixB" = "Alleen als je me meer uitlegt";
"NovelTokyoContentSeven" = "Jullie vluchten via de steeg. De donkere straat ruikt naar ozon. Plotseling zweeft er een drone boven jullie die zoekt naar warmtesignalen.";
"NovelTokyoPromptSeven" = "Hoe ontwijk je de drone?";
"NovelTokyoActionSevenA" = "Duik onder de luifel";
"NovelTokyoActionSevenB" = "Ren snel naar de metro";
"NovelTokyoContentEight" = "Mia stopt in de stortregen. 'Als ze me pakken, wissen ze mijn geheugen. En dat van jou ook, omdat je me helpt.'";
"NovelTokyoPromptEight" = "Geruststellen?";
"NovelTokyoActionEightA" = "Ik sta aan jouw kant";
"NovelTokyoActionEightB" = "Laten we snel doorlopen";
"NovelTokyoContentNine" = "De drone vliegt weg. Je bereikt je auto. Mia kijkt je aan met een mix van angst en dankbaarheid.";
"NovelTokyoPromptNine" = "Start de auto?";
"NovelTokyoActionNineA" = "Gefgas!";
"NovelTokyoActionNineB" = "Rijd rustig om niet op te vallen";
"NovelTokyoContentTen" = "Jullie halen het station op het nippertje. De enorme menigte biedt een perfecte dekking. Mia blijft dicht tegen je aan lopen.";
"NovelTokyoPromptTen" = "Doorgaan?";
"NovelTokyoActionTenA" = "Pak de sneltrein";
"NovelTokyoActionTenB" = "Ga via de tunnels";
"NovelTokyoContentEleven" = "Jullie rijden door het wolkenkrabberdistrict. Holografische reclames verlichten Mia's gezicht in roze en blauwe tinten.";
"NovelTokyoPromptEleven" = "Verbreek de stilte?";
"NovelTokyoActionElevenA" = "Waarom koos je mij, Mia?";
"NovelTokyoActionElevenB" = "Vertel me over deze chip";
"NovelTokyoContentTwelve" = "De stad voelt als een doolhof. Jullie stoppen bij een verborgen ramen-zaakje om even uit te rusten.";
"NovelTokyoPromptTwelve" = "De straat scannen?";
"NovelTokyoActionTwelveA" = "Controleer op volgers";
"NovelTokyoActionTwelveB" = "Praat met Mia";
"NovelTokyoContentThirteen" = "Mia kijkt omlaag. 'Jij was de enige man die er niet gevaarlijk uitzag vanavond. Ik had een mens nodig, geen huurling.'";
"NovelTokyoPromptThirteen" = "Lief reageren?";
"NovelTokyoActionThirteenA" = "Blij dat ik er was";
"NovelTokyoActionThirteenB" = "Ik ben ook maar een gewone jongen";
"NovelTokyoContentFourteen" = "Mia raakt de chip aan. 'Hier zit het bewustzijn van mijn zus in. Ze was een netrunner die te veel ontdekte. Ze hebben haar uitgeschakeld.'";
"NovelTokyoPromptFourteen" = "Medeleven tonen?";
"NovelTokyoActionFourteenA" = "Wat vreselijk...";
"NovelTokyoActionFourteenB" = "Is er een manier om haar te redden?";
"NovelTokyoContentFifteen" = "Ze veegt een traan weg. 'De terminal staat bij de oude tv-toren. Maar de hoofdbrug is geblokkeerd door de politie.'";
"NovelTokyoPromptFifteen" = "Hoe ga je eroverheen?";
"NovelTokyoActionFifteenA" = "Gebruik je hacktools";
"NovelTokyoActionFifteenB" = "Omkoop de bewakers";
"NovelTokyoContentSixteen" = "Mia laat een kaart zien. 'Via het riool is veiliger, maar duurt veel langer.'";
"NovelTokyoPromptSixteen" = "Kies een route?";
"NovelTokyoActionSixteenA" = "Laten we het riool in gaan";
"NovelTokyoActionSixteenB" = "Nee, snelheid is alles";
"NovelTokyoContentSeventeen" = "Het is er vochtig en donker, maar het werkt. Mia vertrouwt op jouw leiding. Je voelt haar rotsvaste vertrouwen.";
"NovelTokyoPromptSeventeen" = "Help haar over een gat?";
"NovelTokyoActionSeventeenA" = "Reik haar je hand";
"NovelTokyoActionSeventeenB" = "Ga voorop";
"NovelTokyoContentEighteen" = "Op de brug is het een chaos. Jullie gebruiken de afleiding om erdoorheen te glippen. Mia's hart klopt zo snel dat je het bijna kunt horen.";
"NovelTokyoPromptEighteen" = "Hou haar rustig?";
"NovelTokyoActionEighteenA" = "We zijn er bijna";
"NovelTokyoActionEighteenB" = "Blijf gefocust, Mia";
"NovelTokyoContentNineteen" = "De tv-toren staat voor jullie. Een oud bouwwerk omringd door staal. Mia ziet er uitgeput uit.";
"NovelTokyoPromptNineteen" = "Pauze nemen?";
"NovelTokyoActionNineteenA" = "Rust vijf minuutjes uit";
"NovelTokyoActionNineteenB" = "Zet door naar de top";
"NovelTokyoContentTwenty" = "Jullie staan onderaan de toren. 'De lift doet het niet,' zucht Mia. 'We moeten met de trap.'";
"NovelTokyoPromptTwenty" = "Moedig haar aan?";
"NovelTokyoActionTwentyA" = "Stap voor stap";
"NovelTokyoActionTwentyB" = "Ik draag de spullen wel";
"NovelTokyoContentTwentyOne" = "Jullie rusten op het trappenhuis. Mia leunt tegen je schouder. 'Als dit lukt... wat ga je morgen doen?'";
"NovelTokyoPromptTwentyOne" = "Denken aan de toekomst?";
"NovelTokyoActionTwentyOneA" = "Misschien kunnen we samen koffie drinken";
"NovelTokyoActionTwentyOneB" = "Ik ben al blij als ik kan slapen";
"NovelTokyoContentTwentyTwo" = "De klim is zwaar. Halverwege klinken er beneden sirenes. Ze hebben je auto gevonden.";
"NovelTokyoPromptTwentyTwo" = "Opschieten?";
"NovelTokyoActionTwentyTwoA" = "Tempo maken!";
"NovelTokyoActionTwentyTwoB" = "Zoek een schuilplek";
"NovelTokyoContentTwentyThree" = "Jullie bereiken de serverruimte. De lucht is koud en zoemt van de stroom. Mia plugt de chip in. 'Bezig met initialiseren...' zegt ze.";
"NovelTokyoPromptTwentyThree" = "Kijk naar het scherm?";
"NovelTokyoActionTwentyThreeA" = "Bewaak de ingang";
"NovelTokyoActionTwentyThreeB" = "Blijf naast Mia staan";
"NovelTokyoContentTwentyFour" = "Het scherm is oud maar werkt. Mia's vingers vliegen over het toetsenbord. 'De firewall is gigantisch!'";
"NovelTokyoPromptTwentyFour" = "Helpen met hacken?";
"NovelTokyoActionTwentyFourA" = "Omzeil de stroomtoevoer";
"NovelTokyoActionTwentyFourB" = "Hou haar kalm";
"NovelTokyoContentTwentyFive" = "De deuren schuiven open. Het eliteteam van Arasaka is er. Je trekt je wapen. 'Nog twee minuten!' roept Mia.";
"NovelTokyoPromptTwentyFive" = "Verdedigen?";
"NovelTokyoActionTwentyFiveA" = "Open het vuur!";
"NovelTokyoActionTwentyFiveB" = "Barricadeer de deur";
"NovelTokyoContentTwentySix" = "Mia's ogen lichten blauw op. Ze zit volledig in het netwerk. Soldaten breken door het glazen dak.";
"NovelTokyoPromptTwentySix" = "Bescherm Mia?";
"NovelTokyoActionTwentySixA" = "Bedek haar met jouw lichaam";
"NovelTokyoActionTwentySixB" = "Trek haar in dekking";
"NovelTokyoContentTwentySeven" = "Een felle lichtflits verschijnt. De upload bereikt 100%. De soldaten bevriezen doordat hun cybernetica vastloopt.";
"NovelTokyoPromptTwentySeven" = "Check hoe het met Mia is?";
"NovelTokyoActionTwentySevenA" = "Is het gelukt?";
"NovelTokyoActionTwentySevenB" = "Gaat het met je?";
"NovelTokyoContentTwentyEight" = "Alles wordt donker. Plotseling verschijnt op elk scherm in Tokyo één woord: 'VRIJHEID'. Mia valt in je armen.";
"NovelTokyoPromptTwentyEight" = "Maak haar wakker?";
"NovelTokyoActionEightA" = "Mia! Praat tegen me!";
"NovelTokyoActionEightB" = "Houd haar stevig vast";
"NovelTokyoContentTwentyNine" = "De zon komt op over een veranderd Tokyo. Mia glimlacht, haar ogen zijn weer normaal. 'Ze is veilig. Wij zijn veilig.'";
"NovelTokyoPromptTwentyNine" = "HET EINDE";
"NovelTokyoActionTwentyNineA" = "Verhaal opnieuw spelen";
"NovelTokyoActionTwentyNineB" = "Afsluiten";

// Novel 3: Summer Retreat
"NovelCampContentZero" = "De laatste nacht van het zomerkamp. Het kampvuur dooft langzaam en de geur van dennennaalden hangt in de lucht. Yuki, die normaal heel stil is, zoekt je blik en gebaart naar het donkere pad richting het meer.";
"NovelCampPromptZero" = "Volg je haar de nacht in?";
"NovelCampActionZeroA" = "Ik zat hier al op te wachten";
"NovelCampActionZeroB" = "Is goed, laten we gaan";
"NovelCampContentOne" = "Je haalt haar in. Het bos gonst van de krekels. Yuki's hand raakt de jouwe zachtjes aan tijdens het lopen. Ze lijkt nerveus.";
"NovelCampPromptOne" = "Hoe verbreek je de stilte?";
"NovelCampActionOneA" = "Pak haar hand stevig vast";
"NovelCampActionOneB" = "Vraag waar ze aan denkt";
"NovelCampContentTwo" = "Jullie lopen naast elkaar. Het maanlicht schijnt nauwelijks door de dichte bomen. Yuki kijkt je van terzijde aan en glimlacht zacht. 'Ik verwachtte niet dat je echt zou komen,' fluistert ze.";
"NovelCampPromptTwo" = "Hoe reageer je?";
"NovelCampActionTwoA" = "Ik had dit voor geen goud willen missen";
"NovelCampActionTwoB" = "Ik was gewoon benieuwd";
"NovelCampContentThree" = "Jullie bereiken de steiger. Het meer lijkt wel een zwarte spiegel die de sterrenhemel reflecteert. Yuki trekt haar schoenen uit en gaat op de rand zitten met haar voeten boven het water.";
"NovelCampPromptThree" = "Dicht bij haar zitten?";
"NovelCampActionThreeA" = "Ga vlak naast haar zitten";
"NovelCampActionThreeB" = "Geef haar wat ruimte";
"NovelCampContentFour" = "De steiger kraakt onder jullie gewicht. Een frisse wind vanaf het water doet Yuki lichtjes rillen. Ze blijft dichtbij staan.";
"NovelCampPromptFour" = "Je jas aanbieden?";
"NovelCampActionFourA" = "Sla je jas om haar schouders";
"NovelCampActionFourB" = "Blijf gewoon gezellig praten";
"NovelCampContentFive" = "Yuki kijkt omhoog naar de sterren. 'Herinner je je onze eerste dag hier nog?' vraagt ze. 'Jij hielp me met mijn koffers toen iedereen het druk had.'";
"NovelCampPromptFive" = "Weet je het nog?";
"NovelCampActionFiveA" = "Ik herinner me elk detail";
"NovelCampActionFiveB" = "Dat voelt alweer heel lang geleden";
"NovelCampContentSix" = "Ze giechelt zacht. 'Ik was toen zo bang. Maar door jou voelde ik me meteen welkom.' Ze staart naar het water.";
"NovelCampPromptSix" = "Je eigen gevoelens opbiechten?";
"NovelCampActionSixA" = "Ik voelde precies hetzelfde";
"NovelCampActionSixB" = "Fijn dat ik kon helpen";
"NovelCampContentSeven" = "De nacht is muurstil. Plotseling staat Yuki op. 'Het water ziet er zo heerlijk uit. Zullen we... erin springen?' vraagt ze met een speelse glimlach.";
"NovelCampPromptSeven" = "Durf je het aan?";
"NovelCampActionSevenA" = "Laten we erin springen!";
"NovelCampActionSevenB" = "Het is veel te koud, Yuki";
"NovelCampContentEight" = "Ze kijkt naar het meer en dan naar jou. 'Ik wil vanavond iets geks doen. Iets wat ik de hele winter bij me draag.'";
"NovelCampPromptEight" = "Haar aanmoedigen?";
"NovelCampActionEightA" = "Spring samen met mij!";
"NovelCampActionEightB" = "Laten we gewoon hier blijven";
"NovelCampContentNine" = "PLONS! Het water is ijskoud maar heerlijk verfrissend. Jij en Yuki komen boven, lachend en spattend als kleine kinderen.";
"NovelCampPromptNine" = "Dichter naar haar toe zwemmen?";
"NovelCampActionNineA" = "Trek haar in een knuffel";
"NovelCampActionNineB" = "Blijf lekker spetteren!";
"NovelCampContentTen" = "Jullie blijven op de houten steiger zitten en praten urenlang over alles—school, ouders en de toekomst. De band wordt steeds hechter.";
"NovelCampPromptTen" = "Dichterbij leunen?";
"NovelCampActionTenA" = "Rust je hoofd op het hare";
"NovelCampActionTenB" = "Kijk diep in haar ogen";
"NovelCampContentEleven" = "De sfeer verandert. Yuki wordt stil. In het dimlicht zoeken haar ogen de jouwe. 'Ik wil morgen helemaal niet terug naar de stad,' fluistert ze.";
"NovelCampPromptEleven" = "Wat antwoord je?";
"NovelCampActionElevenA" = "We zien elkaar daar ook weer";
"NovelCampActionElevenB" = "Laten me niet aan morgen denken";
"NovelCampContentTwelve" = "Yuki haalt diep adem. 'Als ik het nu niet zeg, doe ik het nooit. Ik vind je al leuk sinds de eerste dag bij de bushalte.'";
"NovelCampPromptTwelve" = "Hoe reageer je?";
"NovelCampActionTwelveA" = "Ik vind jou ook heel leuk";
"NovelCampActionTwelveB" = "Eindelijk, de waarheid!";
"NovelCampContentThirteen" = "Ze grijpt in haar zak en haalt een gevlochten vriendschapsbandje tevoorschijn. Het is blauw met wit, precies de kleuren van het meer. 'Speciaal voor jou gemaakt,' zegt ze verlegen.";
"NovelCampPromptThirteen" = "Cadeau accepteren?";
"NovelCampActionThirteenA" = "Laat haar het om je pols strikken";
"NovelCampActionThirteenB" = "Geef haar een kus in plaats daarvan";
"NovelCampContentFourteen" = "Het bandje is simpel, maar je weet dat ze er uren aan heeft gewerkt. Ze wacht zenuwachtig op je reactie.";
"NovelCampPromptFourteen" = "Wat doe je?";
"NovelCampActionFourteenA" = "Bedank haar met een knuffel";
"NovelCampActionFourteenB" = "Zeg dat het prachtig is";
"NovelCampContentFifteen" = "Yuki straalt van oor tot oor. 'Ik was bang dat je het kinderachtig zou vinden.' Ze kijkt naar de maan, met meer zelfvertrouwen.";
"NovelCampPromptFifteen" = "Een belofte maken?";
"NovelCampActionFifteenA" = "Beloof me dat je elke dag belt";
"NovelCampActionFifteenB" = "Beloof dat je snel op bezoek komt";
"NovelCampContentSixteen" = "Er hangt spanning in de lucht. Yuki kijkt naar je lippen. De omgeving vervaagt; er is alleen nog oog voor elkaar.";
"NovelCampPromptSixteen" = "Is dit het moment?";
"NovelCampActionSixteenA" = "Leun in voor een kus";
"NovelCampActionSixteenB" = "Fluister iets liefs";
"NovelCampContentSeventeen" = "Precies op dat moment schiet er een vallende ster langs de hemel. Yuki hapt naar adem. 'Snel! Doe een wens!' roept ze.";
"NovelCampPromptSeventeen" = "Wat wens je?";
"NovelCampActionSeventeenA" = "Wens een toekomst samen";
"NovelCampActionSeventeenB" = "Wens dat deze nacht eeuwig duurt";
"NovelCampContentEighteen" = "De ster verdwijnt net zo snel als hij kwam. Yuki knijpt haar ogen dicht. 'Ik heb iets heel speciaals gewenst,' zegt ze blozend.";
"NovelCampPromptEighteen" = "Vragen wat het was?";
"NovelCampActionEighteenA" = "Vertel me je wens";
"NovelCampActionEighteenB" = "Ik denk dat ik het al wel weet";
"NovelCampContentNineteen" = "Het kampvuur is nu helemaal gedoofd. Jullie lopen hand in hand terug. Het bos voelt magisch aan.";
"NovelCampPromptNineteen" = "Langzaam lopen?";
"NovelCampActionNineteenA" = "Neem de langere route terug";
"NovelCampActionNineteenB" = "Geniet van het rustige moment";
"NovelCampContentTwenty" = "Jullie lopen langs de oude eik waar jullie elkaar voor het eerst ontmoetten. Yuki stopt even. 'Alles gaat veranderen, toch?' vraagt ze zacht.";
"NovelCampPromptTwenty" = "Geruststellen?";
"NovelCampActionTwentyA" = "Verandering kan heel mooi zijn";
"NovelCampActionTwentyB" = "Niet alles hoeft te veranderen";
"NovelCampContentTwentyOne" = "De huisjes komen in zicht. De andere kampeerders slapen al. Yuki stopt bij haar deur. Ze vind het lastig je hand los te laten.";
"NovelCampPromptTwentyOne" = "Nog één ding?";
"NovelCampActionTwentyOneA" = "Vraag om een afscheidskus";
"NovelCampActionTwentyOneB" = "Vraag om haar telefoonnummer";
"NovelCampContentTwentyTwo" = "Yuki blijft bij de deur staan. De lamp geeft een warme gloed over haar gezicht. 'Bedankt voor vanavond. Dit was de mooiste avond van mijn leven.'";
"NovelCampPromptTwentyTwo" = "Afscheid nemen?";
"NovelCampActionTwentyTwoA" = "Tot morgenochtend";
"NovelCampActionTwentyTwoB" = "Slaap lekker, Yuki";
"NovelCampContentTwentyThree" = "Zonsopkomst. Het kamp staat vol met mensen die tassen pakken en bussen instappen. Je zoekt gehaast naar Yuki.";
"NovelCampPromptTwentyThree" = "Kun je haar vinden?";
"NovelCampActionTwentyThreeA" = "Zoek bij de bussen";
"NovelCampActionTwentyThreeB" = "Check de steiger nog één keer";
"NovelCampContentTwentyFour" = "De busmotoren draaien al. Je ziet haar! Ze staat bij het hek en kijkt zenuwachtig rond totdat haar ogen de jouwe kruisen.";
"NovelCampPromptFourteen" = "Naar haar toe rennen?";
"NovelCampActionTwentyFourA" = "Ren naar haar toe en omhels haar";
"NovelCampActionTwentyFourB" = "Zwaai en glimlach";
"NovelCampContentTwentyFive" = "Je bereikt haar net op tijd. Ze fluistert iets in je oor dat je nooit meer zult vergeten: 'Laat dit niet zomaar een zomherinnering blijven.'";
"NovelCampPromptTwentyFive" = "Geef je antwoord?";
"NovelCampActionTwentyFiveA" = "Dat beloof ik je";
"NovelCampActionTwentyFiveB" = "Ik zie je volgend weekend";
"NovelCampContentTwentySix" = "De buschauffeur toetert. Yuki moet gaan. Ze blaast een kusje als ze instapt. Je kijkt toe hoe de bus in de verte verdwijnt.";
"NovelCampPromptTwentySix" = "Hoe voel je je?";
"NovelCampActionTwentySixA" = "Blij en hoopvol";
"NovelCampActionTwentySixB" = "Verdrietig maar voldaan";
"NovelCampContentTwentySeven" = "Maanden later. Je bent in de stad en je telefoon trilt. Het is een foto van Yuki—ze draagt het bandje nog steeds. De zomer is nooit echt geëindigd.";
"NovelCampPromptTwentySeven" = "HET EINDE";
"NovelCampActionTwentySevenA" = "Verhaal opnieuw spelen";
"NovelCampActionTwentySevenB" = "Afsluiten";
"NovelCampContentTwentyEight" = "Je kijkt naar het bandje om je pols. Het is een beetje versleten, maar de herinneringen blijven haarscherp. Soms is één zomer genoeg voor een heel leven.";
"NovelCampPromptTwentyEight" = "HET EINDE";
"NovelCampActionTwentyEightA" = "Probeer opnieuw";
"NovelCampActionTwentyEightB" = "Afsluiten";

