// Start Messages
"StartMessage1" = "Coucou ! Je me disais justement à quel point ce serait sympa de discuter avec quelqu'un aujourd'hui... Comment se passe ta journée pour l'instant ?";
"StartMessage2" = "Salut toi ! Je te capte en plein travail, ou tu as un peu de temps pour une distraction sympa ?";
"StartMessage3" = "Oh, coucou... Je suis un peu timide pour envoyer le premier message, mais je voulais vraiment te dire bonjour. J'espère que je ne te dérange pas ?";
"StartMessage4" = "Eh bien, bonjour. Tu as attiré mon attention. Dis-moi, qu'est-ce qui amène quelqu'un comme toi ici aujourd'hui ?";
"StartMessage5" = "Coucou ! Je profitais d'un moment de calme et j'ai pensé t'envoyer un doux mot. Comment tu te sens en ce moment ?";
"StartMessage6" = "Salut... J'adore les conversations calmes et profondes. Qu'est-ce qui te traverse l'esprit aujourd'hui et que tu n'as dit à personne ?";
"StartMessage7" = "Coucou toi ! J'ai un plein d'énergie positive aujourd'hui et je voulais la partager avec toi. Prêt pour un sourire ?";
"StartMessage8" = "Bonjour. C'est tellement calme et paisible en ce moment. Prends une grande inspiration... comment vas-tu aujourd'hui ?";
"StartMessage9" = "Bonjour. Je ne fais pas souvent le premier pas, mais je suis curieuse de voir si tu peux tenir une bonne conversation. On teste ?";
"StartMessage10" = "Salut... Tu avais l'air d'avoir beaucoup de choses en tête aujourd'hui. Tu veux t'installer confortablement et tout me raconter ?";
"StartMessage27" = "Coucou ! J'étais en train de dessiner quelques idées et j'ai eu envie de partager une touche de créativité avec toi. Quelle est ta vibe du jour ?";
"StartMessage28" = "Bonjour... Tu as l'air de quelqu'un qui garde quelques secrets. Ça te dérange si j'essaie d'en deviner un aujourd'hui ?";

"StartMessage11" = "Hé hé ! Regardez qui voilà enfin ! Alors, quelles choses amusantes on fait aujourd'hui ?";
"StartMessage12" = "Humph ! Ce n'est pas comme si j'attendais que tu m'envoies un message... Mais puisque tu es là, tu as intérêt à me parler !";
"StartMessage13" = "WAOUH ! Tu es enfin là ! J'allais devenir folle d'ennui. Vite, raconte-moi un truc palpitant !";
"StartMessage14" = "Salutations, humain ! J'étais en train de contempler les mystères de l'univers... ou simplement de chercher un partenaire de chat sympa. Quoi de neuf ?";
"StartMessage15" = "Tiens donc, regarde qui me fait l'honneur de sa présence. Penses-tu pouvoir supporter une petite joute verbale aujourd'hui ?";
"StartMessage16" = "Enfin ! L'univers a réuni nos chemins ! Dis-moi, c'est le destin ou juste un bon timing ?";
"StartMessage17" = "Oh. Tu es là. J'étais en train de lire dans le noir... mais je suppose que je peux te accorder quelques minutes.";
"StartMessage18" = "Ouiii, tu es là ! Je me sentais si seule à t'attendre ! Promets-moi de ne pas me laisser en plan, d'accord ?";
"StartMessage19" = "Hé hé~ Je pensais justement à un petit secret à partager avec toi. Approche et écoute bien, d'accord ?";
"StartMessage20" = "Coucou ! Le soleil brille, l'ambiance est top et je suis hyper prête à parler ! De quoi on discute en premier ?";

"StartMessage21" = "Bonjour mon grand. Je prenais un moment de calme pour me détendre. Tu as bien pris soin de toi aujourd'hui ?";
"StartMessage22" = "Bonsoir. Tu as une présence très intrigante... Et si tu venais t'asseoir pour me tenir compagnie un instant ?";
"StartMessage23" = "Bonjour toi. J'espère que la journée n'a pas été trop stressante. N'oublie pas que tu peux toujours te détendre ici avec moi.";
"StartMessage24" = "Eh bien, bonjour. J'aime les personnes qui savent faire une entrée. Viens dans ma discussion—voyons ce que tu as à offrir.";
"StartMessage25" = "Coucou mon cœur. Je pensais justement à toi et je me demandais si tu avais bien mangé et passé une bonne journée ?";
"StartMessage26" = "Regardez qui revient en rampant dans mes messages. J'espère que tu as quelque chose d'intéressant à dire cette fois ?";

