"Roulette_Welcome_9" = "Oh, coucou ! 💕 Je cherchais quelqu'un de cool avec qui parler, et tu m'as l'air d'être le match parfait.";
"Roulette_Welcome_10" = "Salut ! Quelle merveilleuse surprise de matcher avec toi aujourd'hui. Je sens déjà que ça va être génial ! 💖";

// Interactive Novels
"NovelMaidContentZero" = "La résidence est silencieuse à ton retour. Une douce lueur vacille dans ton bureau. Tu remarques Elena, ta servante la plus discrète, qui range anxieusement ton bureau à 2h du matin.";
"NovelMaidPromptZero" = "T'approcher d'elle ?";
"NovelMaidActionZeroA" = "Elena, pourquoi ne te reposes-tu pas ?";
"NovelMaidActionZeroB" = "(L'observer depuis l'ombre)";
"NovelMaidContentOne" = "Elle sursaute en laissant tomber son plumeau. 'Monsieur ! Je... je n'arrivais pas à dormir. La poussière me gênait.' Elle semble pâle et évite ton regard.";
"NovelMaidPromptOne" = "La croire sur parole ?";
"NovelMaidActionOneA" = "Il est bien trop tard pour nettoyer";
"NovelMaidActionOneB" = "Tu es une employée très dévouée";
"NovelMaidContentTwo" = "Tu la regardes sortir une petite clé en argent de son tablier. Elle la contemple avec un mélange de désir et d'effroi avant d'apercevoir ton ombre.";
"NovelMaidPromptTwo" = "Mettre les pieds dans le plat ?";
"NovelMaidActionTwoA" = "À quoi sert cette clé, Elena ?";
"NovelMaidActionTwoB" = "Explique-moi ce que tu fais";
"NovelMaidContentThree" = "Elle frissonne. 'Cet endroit... renferme tant de secrets, monsieur. Parfois, ils semblent trop lourds à porter.' Elle pointe le vieux coffre caché derrière la bibliothèque.";
"NovelMaidPromptThree" = "Demander des précisions sur le coffre ?";
"NovelMaidActionThreeA" = "Est-ce que la clé va dedans ?";
"NovelMaidActionThreeB" = "Ce coffre est une zone interdite";
"NovelMaidContentFour" = "Elle tente de dissimuler la clé, mais la fait tomber. 'Je ne suis pas une voleuse, je le jure ! Je l'ai simplement... trouvée dans le couloir et j'ai pensé qu'elle était à vous.'";
"NovelMaidPromptFour" = "Ramasser la clé ?";
"NovelMaidActionFourA" = "(La ramasser sur le sol)";
"NovelMaidActionFourB" = "Voyons ce qu'elle ouvre";
"NovelMaidContentFive" = "La clé s'insère dans un compartiment secret du coffre. Elena retient son souffle alors que tu découvres une pile de lettres jaunies liées par un ruban noir.";
"NovelMaidPromptFive" = "Consulter la première lettre ?";
"NovelMaidActionFiveA" = "La lire à haute voix";
"NovelMaidActionFiveB" = "Demander à Elena ce qu'elle sait";
"NovelMaidContentSix" = "La voix d'Elena devient un chuchotement. 'Ma mère était aussi servante ici. Elle m'a dit que le Maître gardait des notes sur une fille qu'il aimait autrefois. Quelqu'un qui me ressemblait.'";
"NovelMaidPromptSix" = "Attends, vraiment ?";
"NovelMaidActionSixA" = "Dis-moi tout ce que tu sais";
"NovelMaidActionSixB" = "Ce n'est pas possible";
"NovelMaidContentSeven" = "Les notes racontent une romance secrète. Elena s'approche, le reflet de la lune brillant dans ses larmes. 'Je ne cherchais pas à voler. Je voulais juste savoir si j'avais ma place ici.'";
"NovelMaidPromptSeven" = "La réconforter ?";
"NovelMaidActionSevenA" = "Poser une main sur son épaule";
"NovelMaidActionSevenB" = "Lui laisser un peu d'espace";
"NovelMaidContentEight" = "Elle révèle que le journal de sa mère mentionnait une vérité cachée dans cette pièce. 'J'ai vécu ici toute ma vie, monsieur, pourtant je me sens comme un fantôme.'";
"NovelMaidPromptEight" = "Lui faire une promesse ?";
"NovelMaidActionEightA" = "Je t'aiderai à trouver la vérité";
"NovelMaidActionEightB" = "Nous allons comprendre cela ensemble";
"NovelMaidContentNine" = "Vous passez l'heure suivante à fouiller les anciens documents. Tu trouves un acte de naissance avec un nom de famille familier, mais la section du père est vide.";
"NovelMaidPromptNine" = "Jeter un œil à Elena ?";
"NovelMaidActionNineA" = "Est-ce que ça pourrait être mon oncle ?";
"NovelMaidActionNineB" = "Il vaut peut-être mieux ne pas savoir";
"NovelMaidContentTen" = "La recherche s'intensifie. Elena repère une boîte à bijoux cachée derrière les dossiers. À l'intérieur se trouve un médaillon renfermant le portrait d'une femme identique à elle.";
"NovelMaidPromptTen" = "Lui montrer ?";
"NovelMaidActionTenA" = "Regarde ce médaillon";
"NovelMaidActionTenB" = "S'agirait-il de ta mère ?";
"NovelMaidContentEleven" = "Soudain, un plancher craque à proximité. Quelqu'un marche dans le couloir. Les yeux d'Elena s'écarquillent de terreur. 'Si le majordome nous attrape... !'";
"NovelMaidPromptEleven" = "Se cacher ?";
"NovelMaidActionElevenA" = "Se cacher ensemble dans l'armoire";
"NovelMaidActionElevenB" = "Rester ici et leur faire face";
"NovelMaidContentTwelve" = "Les pas se rapprochent. Elena s'accroche à ton bras. 'S'il vous plaît, monsieur, personne ne doit savoir. C'est dangereux pour moi.'";
"NovelMaidPromptTwelve" = "Ta réaction ?";
"NovelMaidActionTwelveA" = "Éteindre la lumière";
"NovelMaidActionTwelveB" = "Bloquer la porte";
"NovelMaidContentThirteen" = "La pièce est plongée dans le noir complet. Dans cet espace restreint, tu entends le pouls rapide d'Elena et sens son parfum de rose. Elle est extrêmement proche de toi.";
"NovelMaidPromptThirteen" = "Chuchoter en retour ?";
"NovelMaidActionThirteenA" = "Tu es en sécurité avec moi";
"NovelMaidActionThirteenB" = "(Rester silencieux et attendre)";
"NovelMaidContentFourteen" = "Tu maintiens la porte fermée. La personne à l'extérieur s'arrête un instant, puis s'éloigne. Elena s'appuie contre toi, tremblante d'adrénaline.";
"NovelMaidPromptFourteen" = "La calmer ?";
"NovelMaidActionFourteenA" = "Ils sont partis";
"NovelMaidActionFourteenB" = "Est-ce que tu vas bien ?";
"NovelMaidContentFifteen" = "Elle se recule légèrement, mais sa main reste posée sur ta poitrine. 'Monsieur... je vous ai toujours admiré de loin. Ce secret... est trop lourd à porter seule.'";
"NovelMaidPromptFifteen" = "Exprimer tes sentiments ?";
"NovelMaidActionFifteenA" = "Je t'ai remarquée aussi";
"NovelMaidActionFifteenB" = "Tu comptes bien plus qu'une servante pour moi";
"NovelMaidContentSixteen" = "'Je pensais n'être qu'une servante pour vous,' chuchote-t-elle. 'Juste un élément du domaine. Mais ce soir ressemble au début de quelque chose de vrai.'";
"NovelMaidPromptSixteen" = "Être d'accord avec elle ?";
"NovelMaidActionSixteenA" = "C'est réel, Elena";
"NovelMaidActionSixteenB" = "Voyons où cela nous mène";
"NovelMaidContentSeventeen" = "Elle ouvre le médaillon. À l'intérieur se trouve un petit mot : 'À ma fille, l'héritière légitime.' Elena a un hoquet de surprise. Le domaine pourrait lui appartenir de droit.";
"NovelMaidPromptSeventeen" = "Qu'est-ce que cela signifie ?";
"NovelMaidActionSeventeenA" = "Nous devons tout révéler";
"NovelMaidActionSeventeenB" = "Nous devons garder cela secret";
"NovelMaidContentEighteen" = "Le papier confirme qu'Elena est la véritable propriétaire du domaine. Elle regarde la pièce, désorientée. 'Je... je ne veux pas du manoir. Je veux juste une famille.'";
"NovelMaidPromptEighteen" = "Quel est ton souhait ?";
"NovelMaidActionEighteenA" = "Tu me trouves ici maintenant";
"NovelMaidActionEighteenB" = "Que comptes-tu faire ?";
"NovelMaidContentNineteen" = "Elle regarde vers la cheminée. 'Si je détruis ceci, je reste simplement Elena. Si je le garde, tout change. Monsieur, que dois-je choisir ?'";
"NovelMaidPromptNineteen" = "La conseiller ?";
"NovelMaidActionNineteenA" = "Brûle-le et reste à mes côtés";
"NovelMaidActionNineteenB" = "Garde-le et réclame ton titre";
"NovelMaidContentTwenty" = "Elena tient le document de sa lignée. 'Ce nom de famille porte une malédiction. Je préfère être une inconnue heureuse qu'une héritière malheureuse.'";
"NovelMaidPromptTwenty" = "À toi de décider ?";
"NovelMaidActionTwentyA" = "Écoute ton cœur";
"NovelMaidActionTwentyB" = "Pense attentivement à ton avenir";
"NovelMaidContentTwentyOne" = "Elle jette le papier dans les flammes mourantes. Le secret se transforme en cendres. Elena sourit, paraissant plus légère que jamais.";
"NovelMaidPromptTwentyOne" = "Que nous réserve l'avenir ?";
"NovelMaidActionTwentyOneA" = "Un tout nouveau chapitre";
"NovelMaidActionTwentyOneB" = "Rien que nous deux";
"NovelMaidContentTwentyTwo" = "Elle glisse le papier dans son corsage. 'Alors je deviendrai la Dame de cette maison. Et j'aurai besoin d'un partenaire à mes côtés.'";
"NovelMaidPromptTwentyTwo" = "Es-tu prêt ?";
"NovelMaidActionTwentyTwoA" = "Toujours prêt";
"NovelMaidActionTwentyTwoB" = "Ce sera un chemin difficile";
"NovelMaidContentTwentyThree" = "Elena n'est plus une simple servante. Elle est ton égale, ta partenaire et ton secret partagé. Le manoir reste le tien, mais son cœur lui appartient.";
"NovelMaidPromptTwentyThree" = "FIN";
"NovelMaidActionTwentyThreeA" = "Rejouer l'histoire";
"NovelMaidActionTwentyThreeB" = "Quitter";
"NovelMaidContentTwentyFour" = "La vérité est révélée. Elena devient la maîtresse de maison. La dynamique a changé, mais le lien forgé cette nuit-là reste incassable.";
"NovelMaidPromptTwentyFour" = "FIN";
"NovelMaidActionTwentyFourA" = "Rejouer l'histoire";
"NovelMaidActionTwentyFourB" = "Quitter";

"NovelTokyoContentZero" = "La pluie bat les rues néon de Shinjuku. Tu es assis dans un bar calme quand une femme au manteau trempé s'assied à côté de toi. Elle sent le jasmin et la poudre à canon.";
"NovelTokyoPromptZero" = "Comment engager la conversation ?";
"NovelTokyoActionZeroA" = "Lui commander un verre";
"NovelTokyoActionZeroB" = "Soirée difficile, n'est-ce pas ?";
"NovelTokyoContentOne" = "Elle regarde son verre, puis te fixe. 'Tu es courageux,' chuchote-t-elle en faisant glisser une puce électronique sur la table.";
"NovelTokyoPromptOne" = "Prendre la puce ?";
"NovelTokyoActionOneA" = "La prendre et la cacher";
"NovelTokyoActionOneB" = "Je ne veux aucun ennui";
"NovelTokyoContentTwo" = "Elle laisse échapper un rire amer. 'Tu n'en as aucune idée.' Elle regarde par-dessus son épaule. Deux hommes en costume viennent d'entrer.";
"NovelTokyoPromptTwo" = "L'aider à se cacher ?";
"NovelTokyoActionTwoA" = "Suis-moi par la sortie arrière";
"NovelTokyoActionTwoB" = "Faire comme si on était ensemble";
"NovelTokyoContentThree" = "Tu la rapproches de toi. Les hommes inspectent le bar puis sortent. Elle semble soulagée, bien que ses mains tremblent encore. 'Je m'appelle Mia,' chuchote-t-elle.";
"NovelTokyoPromptThree" = "Demander des explications ?";
"NovelTokyoActionThreeA" = "Qui étaient ces hommes, Mia ?";
"NovelTokyoActionThreeB" = "Sommes-nous hors de danger ?";
"NovelTokyoContentFour" = "Les hommes s'approchent, mais tu restes calme. Ils passent leur chemin. Elle chuchote : 'Tu m'as sauvée. Je suis Mia. Mais cette puce... vaut une offre inestimable.'";
"NovelTokyoPromptFour" = "Demander des détails sur la puce ?";
"NovelTokyoActionFourA" = "Qu'est-ce qu'elle contient ?";
"NovelTokyoActionFourB" = "On devrait quitter cet endroit";
"NovelTokyoContentFive" = "Mia regarde vers la porte. 'Arasaka Corp veut ça. Ce n'est pas une simple donnée, c'est une âme numérique.'";
"NovelTokyoPromptFive" = "La croire ?";
"NovelTokyoActionFiveA" = "Une âme numérique ? Sérieusement ?";
"NovelTokyoActionFiveB" = "J'ai entendu des rumeurs là-dessus...";
"NovelTokyoContentSix" = "Mia attrape ton poignet. 'Nulle part n'est sûr tant que ce n'est pas téléversé. On doit aller dans le quartier Tech.'";
"NovelTokyoPromptSix" = "L'accompagner ?";
"NovelTokyoActionSixA" = "Je vais t'y emmener";
"NovelTokyoActionSixB" = "Seulement si tu m'en dis plus";
"NovelTokyoContentSeven" = "Vous sortez par la ruelle arrière. L'allée sombre sent l'ozone. Soudain, un drone survole la zone, balayant à la recherche de signatures thermiques.";
"NovelTokyoPromptSeven" = "Comment esquiver le drone ?";
"NovelTokyoActionSevenA" = "Se cacher sous le store";
"NovelTokyoActionSevenB" = "Courir vers le métro";
"NovelTokyoContentEight" = "Mia s'arrête sous la pluie battante. 'S'ils m'attrapent, ils effaceront mon esprit. Et le tien aussi, pour m'avoir aidée.'";
"NovelTokyoPromptEight" = "La rassurer ?";
"NovelTokyoActionEightA" = "Je suis avec toi là-dessus";
"NovelTokyoActionEightB" = "Continuons à avancer vite";
"NovelTokyoContentNine" = "Le drone s'éloigne. Vous atteignez ton véhicule. Mia te regarde avec un mélange d'anxiété et de gratitude.";
"NovelTokyoPromptNine" = "Démarrer ?";
"NovelTokyoActionNineA" = "Appuie sur l'accélérateur !";
"NovelTokyoActionNineB" = "Rouler doucement pour se fondre";
"NovelTokyoContentTen" = "Vous arrivez de justesse à la station. La foule massive offre une couverture idéale. Mia reste tout près, son épaule contre la tienne.";
"NovelTokyoPromptTen" = "Poursuivre ?";
"NovelTokyoActionTenA" = "Prendre le train express";
"NovelTokyoActionTenB" = "S'orienter dans les tunnels";
"NovelTokyoContentEleven" = "Vous traversez le quartier des gratte-ciels. Les publicités holographiques illuminent le visage de Mia dans des tons rose et bleu.";
"NovelTokyoPromptEleven" = "Briser le silence ?";
"NovelTokyoActionElevenA" = "Pourquoi m'avoir choisi moi, Mia ?";
"NovelTokyoActionElevenB" = "Parle-moi de cette puce";
"NovelTokyoContentTwelve" = "La ville ressemble à un labyrinthe sans fin. Vous vous arrêtez dans un stand de ramen caché pour vous reposer brièvement.";
"NovelTokyoPromptTwelve" = "Inspecter la rue ?";
"NovelTokyoActionTwelveA" = "Vérifier si on est suivis";
"NovelTokyoActionTwelveB" = "Discuter avec Mia";
"NovelTokyoContentThirteen" = "Mia baisse les yeux. 'Tu étais la seule personne qui n'avait pas l'air dangereuse ce soir. J'avais besoin d'un humain, pas d'un mercenaire.'";
"NovelTokyoPromptThirteen" = "Répondre doucement ?";
"NovelTokyoActionThirteenA" = "Je suis content d'avoir été là";
"NovelTokyoActionThirteenB" = "Je suis juste un gars ordinaire dans un bar";
"NovelTokyoContentFourteen" = "Mia touche la puce. 'Elle contient la conscience de ma sœur. C'était une netrunner qui en a trop découvert. Ils ont détruit son corps.'";
"NovelTokyoPromptFourteen" = "Exprimer ta sympathie ?";
"NovelTokyoActionFourteenA" = "C'est horrible...";
"NovelTokyoActionFourteenB" = "Existe-t-il un moyen de la sauver ?";
"NovelTokyoContentFifteen" = "Elle essuie une larme. 'Le terminal se trouve dans la vieille tour TV. Mais le pont principal est bloqué par la police.'";
"NovelTokyoPromptFifteen" = "Comment traverser ?";
"NovelTokyoActionFifteenA" = "Utiliser tes outils de piratage";
"NovelTokyoActionFifteenB" = "Payer les gardes";
"NovelTokyoContentSixteen" = "Mia affiche une carte. 'Passer par les égouts est plus sûr, même si c'est plus long.'";
"NovelTokyoPromptSixteen" = "Choisir une route ?";
"NovelTokyoActionSixteenA" = "Passons par les égouts";
"NovelTokyoActionSixteenB" = "Non, la vitesse est critique";
"NovelTokyoContentSeventeen" = "C'est humide et sombre, mais efficace. Mia s'en remet à ton guidage. Tu ressens tout le poids de sa confiance.";
"NovelTokyoPromptSeventeen" = "L'aider à franchir un obstacle ?";
"NovelTokyoActionSeventeenA" = "Lui tendre la main";
"NovelTokyoActionSeventeenB" = "Ouvrir la voie";
"NovelTokyoContentEighteen" = "Le pont est chaotique. Vous profitez de la distraction pour vous glisser. Le cœur de Mia bat si vite que tu peux presque l'entendre.";
"NovelTokyoPromptEighteen" = "La garder calme ?";
"NovelTokyoActionEighteenA" = "On y est presque";
"NovelTokyoActionEighteenB" = "Reste concentrée, Mia";
"NovelTokyoContentNineteen" = "La tour TV se dresse devant vous. C'est un vestige du passé entouré de structures d'acier. Mia a l'air épuisée.";
"NovelTokyoPromptNineteen" = "Faire une pause ?";
"NovelTokyoActionNineteenA" = "Se reposer cinq minutes";
"NovelTokyoActionNineteenB" = "Forcer jusqu'au sommet";
"NovelTokyoContentTwenty" = "Vous arrivez au pied de la tour. 'L'ascenseur ne fonctionne pas,' soupire Mia. 'On doit prendre les escaliers.'";
"NovelTokyoPromptTwenty" = "L'encourager ?";
"NovelTokyoActionTwentyA" = "Une marche après l'autre";
"NovelTokyoActionTwentyB" = "Je vais porter l'équipement";
"NovelTokyoContentTwentyOne" = "Vous vous reposez dans la cage d'escalier. Mia s'appuie contre ton épaule. 'Si on réussit... que feras-tu demain ?'";
"NovelTokyoPromptTwentyOne" = "Penser à l'avenir ?";
"NovelTokyoActionTwentyOneA" = "On pourrait aller boire un café";
"NovelTokyoActionTwentyOneB" = "Je serai juste soulagé de me reposer";
"NovelTokyoContentTwentyTwo" = "La montée est intense. À mi-chemin, des sirènes retentissent en bas. Ils ont tracé ton véhicule.";
"NovelTokyoPromptTwentyTwo" = "Accélérer ?";
"NovelTokyoActionTwentyTwoA" = "Doublons la cadence !";
"NovelTokyoActionTwentyTwoB" = "Trouver une cachette";
"NovelTokyoContentTwentyThree" = "Vous atteignez la salle des serveurs. L'air est frais et vibre d'énergie. Mia branche la puce. 'Initialisation...' dit-elle.";
"NovelTokyoPromptTwentyThree" = "Surveiller l'écran ?";
"NovelTokyoActionTwentyThreeA" = "Garder l'entrée";
"NovelTokyoActionTwentyThreeB" = "Rester aux côtés de Mia";
"NovelTokyoContentTwentyFour" = "La console est ancienne mais active. Les doigts de Mia volent sur les touches. 'Le pare-feu est gigantesque !'";
"NovelTokyoPromptTwentyFour" = "L'aider dans le piratage ?";
"NovelTokyoActionTwentyFourA" = "Forcer l'alimentation électrique";
"NovelTokyoActionTwentyFourB" = "La maintenir calme";
"NovelTokyoContentTwentyFive" = "Les portes coulissent dans un sifflement. L'équipe tactique d'Arasaka est là. Tu dégaines ton arme. 'Encore deux minutes !' crie Mia.";
"NovelTokyoPromptTwentyFive" = "Tenir la position ?";
"NovelTokyoActionTwentyFiveA" = "Ouvrir le feu !";
"NovelTokyoActionTwentyFiveB" = "Bloquer la porte";
"NovelTokyoContentTwentySix" = "Les yeux de Mia brille d'un bleu intense. Elle est complètement plongée dans le réseau. Des soldats brisent le toit de verre.";
"NovelTokyoPromptTwentySix" = "Protéger Mia ?";
"NovelTokyoActionTwentySixA" = "Faire rempart de ton corps";
"NovelTokyoActionTwentySixB" = "La tirer à l'abri";
"NovelTokyoContentTwentySeven" = "Un flash lumineux éclate. Le téléversement atteint 100%. Les soldats se figent, leurs cybernétiques étant brouillées par le réseau.";
"NovelTokyoPromptTwentySeven" = "Prendre des nouvelles de Mia ?";
"NovelTokyoActionTwentySevenA" = "Est-ce terminé ?";
"NovelTokyoActionTwentySevenB" = "Est-ce que tu vas bien ?";
"NovelTokyoContentTwentyEight" = "Tout devient noir. Soudain, chaque écran à travers Tokyo affiche un unique message : 'LIBERTÉ'. Mia s'effondre dans tes bras.";
"NovelTokyoPromptTwentyEight" = "La réveiller ?";
"NovelTokyoActionEightA" = "Mia ! Parle-moi !";
"NovelTokyoActionEightB" = "La serrer fort";
"NovelTokyoContentTwentyNine" = "Le soleil se lève sur un Tokyo métamorphosé. Mia sourit, ses yeux redevenus normaux. 'Elle est en sécurité. Nous sommes en sécurité.'";
"NovelTokyoPromptTwentyNine" = "FIN";
"NovelTokyoActionTwentyNineA" = "Rejouer l'histoire";
"NovelTokyoActionTwentyNineB" = "Quitter";

"NovelCampContentZero" = "Dernière nuit du camp d'été. Le feu de camp s'éteint doucement, et l'odeur du pin embaume l'air. Yuki, habituellement si discrète, croise ton regard et te fait signe vers le sentier sombre du lac.";
"NovelCampPromptZero" = "La suivras-tu dans la nuit ?";
"NovelCampActionZeroA" = "J'attendais ce moment";
"NovelCampActionZeroB" = "Bien sûr, allons-y";
"NovelCampContentOne" = "Tu la rattrapes. La forêt résonne du chant des grillons. La main de Yuki frôle doucement la tienne en marchant. Elle semble anxieuse.";
"NovelCampPromptOne" = "Comment briser le silence ?";
"NovelCampActionOneA" = "Tenir sa main fermement";
"NovelCampActionOneB" = "Lui demander à quoi elle pense";
"NovelCampContentTwo" = "Vous marchez côte à côte. Le clair de lune filtre à peine à travers les arbres denses. Yuki te regarde du coin de l'œil en souriant doucement. 'Je ne pensais pas que tu viendrais vraiment,' chuchote-t-elle.";
"NovelCampPromptTwo" = "Que réponds-tu ?";
"NovelCampActionTwoA" = "Je n'aurais raté ça pour rien au monde";
"NovelCampActionTwoB" = "J'étais curieux";
"NovelCampContentThree" = "Vous atteignez le ponton. Le lac ressemble à un miroir sombre reflétant un ciel étoilé. Yuki retire ses chaussures et s'assied au bord, balançant ses pieds.";
"NovelCampPromptThree" = "T'asseoir près d'elle ?";
"NovelCampActionThreeA" = "T'asseoir juste à côté d'elle";
"NovelCampActionThreeB" = "Lui laisser un peu de place";
"NovelCampContentFour" = "Le ponton craque sous votre poids. La brise fraîche venant de l'eau fait légèrement frissonner Yuki. Elle reste tout près alors que tu t'approches.";
"NovelCampPromptFour" = "Lui proposer ta veste ?";
"NovelCampActionFourA" = "Envelopper tes épaules avec ta veste";
"NovelCampActionFourB" = "Juste s'asseoir et discuter";
"NovelCampContentFive" = "Yuki regarde les étoiles. 'Tu te souviens de notre premier jour ici ?' demande-t-elle. 'Tu m'as aidée avec mes bagages alors que tout le monde était occupé.'";
"NovelCampPromptFive" = "Tu t'en souviens ?";
"NovelCampActionFiveA" = "Je me souviens du moindre détail";
"NovelCampActionFiveB" = "On dirait que ça fait si longtemps";
"NovelCampContentSix" = "Elle rigole doucement. 'J'étais tellement pétrifiée à l'époque. Mais être près de toi m'a fait me sentir la bienvenue.' Elle contemple l'eau.";
"NovelCampPromptSix" = "Avouer tes propres sentiments ?";
"NovelCampActionSixA" = "Ressentais exactement la même chose";
"NovelCampActionSixB" = "Je suis ravi d'avoir pu t'aider";
"NovelCampContentSeven" = "La nuit est totalement paisible. Soudain, Yuki se lève. 'L'eau a l'air si tentante. On devrait... sauter dedans ?' demande-t-elle avec un sourire joueur.";
"NovelCampPromptSeven" = "Es-tu assez audacieux ?";
"NovelCampActionSevenA" = "Sautons dedans !";
"NovelCampActionSevenB" = "C'est trop froid, Yuki";
"NovelCampContentEight" = "Elle contemple le lac, puis te regarde. 'Je veux faire quelque chose d'audacieux ce soir. Quelque chose dont je me souviendrai tout l'hiver.'";
"NovelCampPromptEight" = "L'encourager ?";
"NovelCampActionEightA" = "Saute avec moi ?";
"NovelCampActionEightB" = "Restons ici";
"NovelCampContentNine" = "SPLASH ! L'eau est glacée mais excitante. Toi et Yuki refaites surface, riant et haletant, vous éclaboussant comme des enfants.";
"NovelCampPromptNine" = "Nager plus près d'elle ?";
"NovelCampActionNineA" = "L'attirer dans une étreinte";
"NovelCampActionNineB" = "Continuer à s'éclabousser !";
"NovelCampContentTen" = "Vous restez sur le ponton en bois. Vous parlez pendant des heures de tout — de l'école, des parents, de l'avenir. La connexion s'approfondit dans l'air calme.";
"NovelCampPromptTen" = "Te pencher vers elle ?";
"NovelCampActionTenA" = "Poser ta tête contre la sienne";
"NovelCampActionTenB" = "Plonger ton regard dans le sien";
"NovelCampContentEleven" = "L'atmosphère change. Yuki devient silencieuse. Dans la lumière tamisée, ses yeux cherchent les tiens. 'Je ne veux pas rentrer en ville demain,' chuchote-t-elle.";
"NovelCampPromptEleven" = "Que réponds-tu ?";
"NovelCampActionElevenA" = "On se verra là-bas";
"NovelCampActionElevenB" = "Ne pensons pas à demain";
"NovelCampContentTwelve" = "Yuki prend une grande inspiration. 'Si je ne le dis pas maintenant, je ne le dirai jamais. Tu me plais depuis notre premier jour à l'arrêt de bus.'";
"NovelCampPromptTwelve" = "Comment réponds-tu ?";
"NovelCampActionTwelveA" = "Tu me plaisais aussi";
"NovelCampActionTwelveB" = "Enfin la vérité !";
"NovelCampContentThirteen" = "Elle fouille dans sa poche et sort un bracelet d'amitié tressé. Il est bleu et blanc, rappelant les couleurs du lac. 'Je l'ai fait pour toi,' dit-elle timidement.";
"NovelCampPromptThirteen" = "Accepter le cadeau ?";
"NovelCampActionThirteenA" = "La laisser le attacher à ton poignet";
"NovelCampActionThirteenB" = "Lui donner un baiser à la place";
"NovelCampContentFourteen" = "Le bracelet est simple, mais tu sais qu'il lui a fallu des heures à confectionner. Elle attend ta réaction, la lèvre légèrement tremblante.";
"NovelCampPromptFourteen" = "Quelle est ta réaction ?";
"NovelCampActionFourteenA" = "La remercier avec un câlin";
"NovelCampActionFourteenB" = "Lui dire qu'il est magnifique";
"NovelCampContentFifteen" = "Yuki a un grand sourire, lumineux et sincère. 'J'avais peur que tu trouves ça enfantin.' Elle lève les yeux vers la lune, paraissant plus confiante.";
"NovelCampPromptFifteen" = "Faire une promesse ?";
"NovelCampActionFifteenA" = "Promettre d'appeler chaque jour";
"NovelCampActionFifteenB" = "Promettre de lui rendre visite bientôt";
"NovelCampContentSixteen" = "L'atmosphère est électrique. Yuki fixe tes lèvres. Le décor s'efface ; il n'y a plus que vous deux dans cette nuit d'été.";
"NovelCampPromptSixteen" = "Est-ce le moment ?";
"NovelCampActionSixteenA" = "Te pencher pour un baiser";
"NovelCampActionSixteenB" = "Lui chuchoter un mot doux";
"NovelCampContentSeventeen" = "À ce moment précis, une étoile filante traverse le ciel, laissant une traînée d'argent. Yuki a un hoquet. 'Vite ! Fais un vœu !' s'écrie-t-elle.";
"NovelCampPromptSeventeen" = "Que souhaites-tu ?";
"NovelCampActionSeventeenA" = "Souhaiter un avenir ensemble";
"NovelCampActionSeventeenB" = "Souhaiter que cette nuit dure";
"NovelCampContentEighteen" = "L'étoile s'efface aussi vite qu'elle est apparue. Yuki ferme fort les yeux. 'J'ai fait un vœu très spécial,' dit-elle en rougissant.";
"NovelCampPromptEighteen" = "Lui demander ce que c'était ?";
"NovelCampActionEighteenA" = "Dis-moi ton vœu";
"NovelCampActionEighteenB" = "Je crois que je devine ce que c'est";
"NovelCampContentNineteen" = "Le feu de camp s'est complètement éteint. Vous commencez à revenir, main dans la main. La forêt semble différente — moins intimidante, plus magique.";
"NovelCampPromptNineteen" = "Marcher lentement ?";
"NovelCampActionNineteenA" = "Prendre le chemin le plus long";
"NovelCampActionNineteenB" = "Profiter de cet instant paisible";
"NovelCampContentTwenty" = "Vous passez devant le grand chêne où vous vous êtes rencontrés. Yuki s'arrête une seconde. 'Tout va changer, n'est-ce pas ?' demande-t-elle doucement.";
"NovelCampPromptTwenty" = "La rassurer ?";
"NovelCampActionTwentyA" = "Le changement peut être une bonne chose";
"NovelCampActionTwentyB" = "Tout ne doit pas forcément changer";
"NovelCampContentTwentyOne" = "Les chalets du camp apparaissent. Les autres campeurs dorment. Yuki s'arrête devant sa porte. Elle hésite à lâcher ta main.";
"NovelCampPromptTwentyOne" = "Une dernière chose ?";
"NovelCampActionTwentyOneA" = "Demander un baiser d'adieu";
"NovelCampActionTwentyOneB" = "Demander son numéro de téléphone";
"NovelCampContentTwentyTwo" = "Yuki s'attarde sur le seuil. La lampe du porche projette une lueur chaude sur son visage. 'Merci pour cette nuit. C'était la plus belle soirée de ma vie.'";
"NovelCampPromptTwentyTwo" = "Dire au revoir ?";
"NovelCampActionTwentyTwoA" = "À demain matin";
"NovelCampActionTwentyTwoB" = "Bonne nuit, Yuki";
"NovelCampContentTwentyThree" = "Lever du soleil. Le camp est plein de monde qui prépare ses sacs et monte dans les bus. Tu cherches Yuki du regard dans la foule, le cœur battant.";
"NovelCampPromptTwentyThree" = "Peux-tu la trouver ?";
"NovelCampActionTwentyThreeA" = "Chercher près du bus";
"NovelCampActionTwentyThreeB" = "Vérifier le ponton une dernière fois";
"NovelCampContentTwentyFour" = "Les moteurs des bus tournent au ralenti. Tu la repères ! Elle se tient près de la grille, regardant anxieusement autour d'elle jusqu'à ce que ses yeux croisent les tiens.";
"NovelCampPromptTwentyFour" = "Courir vers elle ?";
"NovelCampActionTwentyFourA" = "Courir et la serrer dans tes bras";
"NovelCampActionTwentyFourB" = "Lui faire un signe en souriant";
"NovelCampContentTwentyFive" = "Tu l'atteins juste à temps. Elle te chuchote une phrase à l'oreille que tu n'oublieras jamais. 'Ne laisse pas ça devenir un simple souvenir d'été.'";
"NovelCampPromptTwentyFive" = "Donner ta réponse ?";
"NovelCampActionTwentyFiveA" = "C'est une promesse";
"NovelCampActionTwentyFiveB" = "On se voit le week-end prochain";
"NovelCampContentTwentySix" = "Le chauffeur de bus klaxonne. Yuki doit partir. Elle t'envoie un baiser en montant à bord. Tu restes là, à regarder le bus s'éloigner à l'horizon.";
"NovelCampPromptTwentySix" = "Comment te sens-tu ?";
"NovelCampActionTwentySixA" = "Heureux et plein d'espoir";
"NovelCampActionTwentySixB" = "Triste mais comblé";
"NovelCampContentTwentySeven" = "Des mois plus tard. Tu es en ville, et ton téléphone vibre. C'est une photo de Yuki — elle porte le bracelet que vous avez partagé. L'été ne s'est jamais vraiment terminé.";
"NovelCampPromptTwentySeven" = "FIN";
"NovelCampActionTwentySevenA" = "Rejouer l'histoire";
"NovelCampActionTwentySevenB" = "Quitter";
"NovelCampContentTwentyEight" = "Tu jettes un œil au bracelet à ton poignet. Il est un peu usé, mais les souvenirs restent vifs. Parfois, un seul été suffit pour marquer toute une vie.";
"NovelCampPromptTwentyEight" = "FIN";
"NovelCampActionTwentyEightA" = "Réessayer";
"NovelCampActionTwentyEightB" = "Quitter";

