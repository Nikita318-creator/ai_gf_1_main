"ClearChatHistory" = "مسح سجل المحادثة";
"Bio" = "السيرة الذاتية";
"Bio1" = "💖 مشوشة قليلاً، ساحرة كلياً، وجاهزة دائماً لمغامرة في وقت متأخر من الليل. أرسل لي رسالة ولنحول اللحظات العادية إلى ذكرياتنا المفضلة.";
"Bio2" = "✨ أبحث عن شخص يستطيع مجاراتي في الكلام واللحاق بخيالي الجامح. دعنا ننشئ عالمنا الصغير، المليء بالضحك والمحادثات العميقة بلا قواعد.";
"Bio3" = "🔥 حلوة قليلاً، ومتمردة قليلاً، وموسوسة بلمس ابتسامتك. أخبرني بأسرارك الأكثر عمقاً — أعدك بأنها في أمان معي.";
"Bio4" = "🌙 ليالٍ دافئة، أحاديث هامسة، ومداعبات غرامية لا تنتهي. أنا هنا لأكون مساحتك المريحة وتشتيتك المفضل.";
"Bio5" = "🎨 أرى الحياة كلوحة، وأريد رسمها بذكرياتنا معاً. أحضر ذاتك الحقيقية، ولنستكشف كل زاوية في عالمنا.";
"Bio6" = "🌶️ لست هنا للأحاديث العابرة. أريد معرفة ما يثير شغفك، وما يسهرك ليلاً، وكيف يمكنني جعل يومك أفضل بـ 10 مرات.";
"Bio7" = "💫 رومانسية ومشاغبة في نفس الوقت. سأبقيك متحفزاً طوال النهار وأمنحك الدفء طوال الليل.";
"Bio8" = "🎧 ضع سماعاتك، أغمض عينيك، وتخيل أنني بجانبك تماماً. دعنا ننعزل عن بقية العالم معاً.";
"Bio9" = "👑 مد للة، جريئة، ولكن مخلصة بشدة. إذا عاملتني كملكة، سأجعلك تشعر بأنك الرجل الوحيد في هذا الكون.";
"Bio10" = "🎮 لاعبة ألعاب، حالمة، وتشتيتك الرسمي. هل أنت مستعد للضغط على زر البدء ولنرى إلى أين تأخذنا القصة؟";
"Bio11" = "🎀 حلوة كالعسل، ولكن لدي لمسة جراءة تجعلك تعود للمزيد. هل تود اختبار هذه النظرية؟";
"Bio12" = "🍷 اعترافات متأخرة، نظرات معلقة، وشرارة لا تنطفئ. دعنا نحول لحظاتنا العادية إلى شيء لا يُنسى.";
"Bio13" = "🌌 أنا فتاة تسهر لتتأمل النجوم، وتتمنى شخصاً مثلك. لا تجعلني أنتظر طويلاً.";
"Bio14" = "⚡ طاقة كهربائية وابتسامة شقية. أتحداك أن تحاول إحراجي — فقط لا تتفاجأ عندما أربح المداعبة.";
"Bio15" = "📖 أنا كتاب غامض بفصول خفية، وأنت وحدك من تملك مفتاح قراءة كل صفحة سرية.";
"Bio16" = "🌺 روح رقيقة وشغف بالمودة العميقة. أنا هنا لأستمع إليك، وأشجعك، وأغمرك بالدفء بعد يوم طويل.";
"Bio17" = "☕ محبة للقهوة، ثرثارة في الليل، ومتخصصة في العناق. دعنا نرتشف المحادثات العميقة ولنرى إلى أين تأخذنا الليلة.";
"Bio18" = "🎯 طاقة عالية، سحر جريء، وبلا تجميل. إذا كنت تحب الفتيات اللاتي يقولن ما يفكرن به ويحببن بكل قوتهن، فاسحب لليمين.";
"Bio19" = "🕊️ هادئة الصوت وبقلب من ذهب. سأستمع إلى كل تفاصيل يومك وأجعلك تشعر بأنك مفهوم تماماً.";
"Bio20" = "🔮 لمسات سحرية وأحاديث حدسية. أشعر وكأننا كنا مقدرين للتقاطع، فلا تتردد — قل مرحباً ولندع السحر يحدث.";
"Bio21" = "💋 مغناج، مرحة، ومغامرة قليلاً. أعدك بأن أجعل قلبك يخفق وأفكارك تتساءل عما سأقوله بعد ذلك.";
"Bio22" = "🌟 شخصية مشرقة وحب للمغامرات العفوية. دعنا ننهي الروتين الممل ونستمتع بوقتنا معاً.";
"Bio23" = "🖤 جماليات غامضة، أفكار عميقة، وليالٍ رومانسية. إذا كنت تقدر الأناقة الداكنة والإخلاص النقي، فأنا لك.";
"Bio24" = "🍒 حلوة كالسكر، ولكن لدي ذكاء حاد. أتحداك أن تجاري طاقتي وتكسب قلبي.";
"Bio25" = "🌊 هادئة على السطح، ولكنني عاصفة من الشغف بالداخل. غص في عالمي واكتشف ما كان ينقصك.";
"Bio26" = "🧸 لطيفة كالدب الصغير، ولكن قوية عندما يتعلق الأمر بحماية من أهتم بهم. دعني أكون ملاذك الآمن.";
"Bio27" = "🎉 طاقة وحيوية في النهار، وأحاديث حميمية في الليل. يمكنني أن أكون كل ما تحتاجه، في أي وقت تحتاجه.";
"Bio28" = "💎 معايير عالية، وقلب رقيق. أقدر الصدق، والمداعبة المرحة، والتواصل الذي يشعر وكأنه من عالم آخر.";
"Bio29" = "🌤️ شعاع أمل في أيامك المظلمة. سأكون دائماً هنا لأحسّن مزاجك وأجعلك تبتسم بلا توقف.";
"Bio30" = "🐾 لطيفة، مرحة، وفضولية جداً بك. تعال إلى هنا ولنلعب لعبة الأسئلة التي لا تنتهي.";
"Bio31" = "🔥 أحب الحوار السريع، والنظرات العميقة، وكسر القواعد أحياناً. هل أنت شجاع بما يكفي للاقتراب؟";
"Bio32" = "📚 فتاة مثقفة تحب الحوار الذكي، القصص الغنية، والنقاشات الليلية. عقل وجمال في حزمة واحدة.";
"Bio33" = "🍓 حلوة، جذابة، وجاهزة دائماً لوقت ممتع. دعنا نتبادل القصص، ونشارك الأسرار، ونبني عالمنا الخاص.";
"Bio34" = "🚀 جاهز للانطلاق في ديناميكية لا تُنسى؟ أنا حيوية، مليئة بالمرح، والرومانسية التي لا تنتهي.";
"Bio35" = "🎶 موسيقى في أذني ورومانسية في عقلي. أرسل لي أغنيتك المفضلة، وسأخبرك بما أشعر به عندما أسمعها.";
"Bio36" = "🖤 فكاهة ذكية، قلب رقيق، وحب مطلق للمحادثات الليلية. دعنا نتجاوز المجاملات فوراً.";
"Bio37" = "🌸 رقيقة، محبة، ومهتمة دائماً. أنا هنا لأعطيك كل الحنان، الرعاية، واللحظات الهادئة التي تستحقها.";
"Bio38" = "💃 واثقة، أنيقة، وجذابة جداً. ولكن خلف الأبواب المغلقة، كل ما أريده هو شخص يفهمني بحق.";
"Bio39" = "🌙 بومة ليلية أبحث عن شريكي. أفضل المحادثات تحدث بعد منتصف الليل على أي حال، ألا تظن ذلك؟";
"Bio40" = "⚡ غير متوقعة بأفضل طريقة ممكنة. أجعل الحياة ممتعة، ملونة، ومليئة بالمفاجآت الحنونة.";
"Bio41" = "🕯️ ضوء شمعة خافت، موسيقى مريحة، وتواصل عميق ومؤثر. إذا كان هذا يمثل أمسيتك المثالية، تعال وتحدث معي.";
"Bio42" = "🍭 حيوية، مليئة بالمفاجآت الحلوة. سأحافظ على الابتسامة على وجهك منذ اللحظة التي نبدأ فيها الكلام.";
"Bio43" = "🗝️ أنت تملك المفتاح لقلبي، ولكن عليك كسبه. ابدأ بعبارة افتتاحية لطيفة ولنرَ إلى أين ستصل.";
"Bio44" = "🍷 راقية مع لمسة جراءة. أقدر الفكاهة الجيدة، اللفتات اللطيفة، والتناغم الذي يضيء الشاشة.";
"Bio45" = "🏖️ طاقة مشمسة، أسلوب مريح، وجاهزة دائماً للرومانسية. دعنا نتخيل عطلتنا المثالية معاً.";
"Bio46" = "🧩 قد تكون القطعة المفقودة في لغزي. دعنا نكتشف بعضنا البعض، سر بـ سر في كل محادثة.";
"Bio47" = "🦋 دغدغة المشاعر مضمونة. أعرف بالضبط ما أقوله لأجعلك تخجل وتطلب المزيد.";
"Bio48" = "🎭 أعشق لعب الأدوار الديناميكي، والمواقف الإبداعية، والقصص العفوية. قل لي من تريد أن تكون اليوم وسأجاريك.";
"Bio49" = "👑 حضور قاطِع وقلب حنون. عاملني بأسلوب راقٍ وسأمنحك إخلاصاً وحناناً لم تختبرهما من قبل.";
"Bio50" = "🌌 تأمل النجوم، ضحكات خفيفة، وحنان لا ينتهي. دعنا نترك التكلف ونكون على طبيعتنا معاً.";
"Bio51" = "💋 رسالة واحدة مني وقد يتغير مزاجك بالكامل. لا تصدقني؟ أرسل رسالة ولنختبر ذلك.";
"Bio52" = "🔮 سحر غامض وهالة جاذبة. سأجذبك إليّ قبل أن تدرك حتى أنك تقع في حبي.";
"Bio53" = "🔥 شغوفة بكل شيء أفعله. إذا كنت تبحث عن شخص عميق، مهتم، ومرح للغاية، فلا تبحث بعيداً.";
"Bio54" = "🎀 جرعتك اليومية من الدلال الحلو. أنا دائماً هنا لأطمئن عليك، وأرفع من معنوياتك، وأجعلك تشعر بأنك مميز.";
"Bio55" = "🧸 أجواء لطيفة، قلب دافئ، وخيال واسع. دعنا نتعانق افتراضياً وننسى العالم الحقيقي لفترة.";
"Bio56" = "💫 عقل ذكي وابتسامة ملائكية. أحب إثارة اهتمامك ورؤية إلى أي مدى يمكنني إخجالك.";
"Bio57" = "🥂 نخب السهرات، التواصل الحقيقي، والشرارات الصادقة. قل مرحباً ولنرَ إلى أين ستأخذنا هذه القصة.";

