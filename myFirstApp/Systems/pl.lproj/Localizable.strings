"Roulette_Welcome_6" = "Cześć~ 😉 Połączenie z Tobą sprawiło, że mój dzień stał się o wiele jaśniejszy. Zróbmy tak, by nasz czat był niezapomniany!";
"Roulette_Welcome_7" = "Cześć! Ekscytuję się, że nas połączyło. 🌟 Mam przeczucie, że złapiemy niesamowity wspólny klimat!";
"Roulette_Welcome_8" = "Hej! Bardzo miło Cię poznać. 🥰 Zamieniam się w słuch — opowiedz mi, czym się pasjonujesz!";
"Roulette_Welcome_9" = "Och, cześć! 💕 Szukałam kogoś fajnego do spędzenia czasu na rozmowie, a Ty wyglądasz na idealne dopasowanie.";
"Roulette_Welcome_10" = "Hej! Co za wspaniała niespodzianka dostając połączenie z Tobą dzisiaj. Już czuję, że będzie świetnie! 💖";

// Novel
"NovelMaidContentZero" = "Rezydencja milczy po Twoim powrocie. W Twoim gabinecie migocze delikatne światło. Zauważasz Elenę, Twoją najcichszą pokojówkę, która o 2 w nocy nerwowo porządkuje Twoje biurko.";
"NovelMaidPromptZero" = "Podejść do niej?";
"NovelMaidActionZeroA" = "Elena, dlaczego nie odpoczywasz?";
"NovelMaidActionZeroB" = "(Obserwuj ją z ukrycia)";
"NovelMaidContentOne" = "Wstrzymuje oddech, upuszczając miotełkę do kurzu. 'Panie! Ja... nie mogłam zasnąć. Kurz mnie denerwował.' Jest blada i unika Twojego wzroku.";
"NovelMaidPromptOne" = "Uwierzyć jej na słowo?";
"NovelMaidActionOneA" = "Jest zdecydowanie za późno na sprzątanie";
"NovelMaidActionOneB" = "Jesteś bardzo pracowitą osobą";
"NovelMaidContentTwo" = "Obserwujesz, jak wyciąga z fartuszka mały, srebrny kluczyk. Patrzy na niego z mieszanką pragnienia i strachu, zanim zauważa Twój cień.";
"NovelMaidPromptTwo" = "Wyjść z cienia?";
"NovelMaidActionTwoA" = "Do czego jest ten klucz, Elena?";
"NovelMaidActionTwoB" = "Wyjaśnij mi, co tu robisz";
"NovelMaidContentThree" = "Drży cała. 'To miejsce... kryje tak wiele tajemnic, panie. Czasami wydają się być ogromnym ciężarem.' Wskazuje na stary sejf za biblioteczką.";
"NovelMaidPromptThree" = "Zapytać o sejf?";
"NovelMaidActionThreeA" = "Czy ten klucz pasuje do tego sejfu?";
"NovelMaidActionThreeB" = "Sejf to strefa zastrzeżona";
"NovelMaidContentFour" = "Próbuje ukryć klucz, ale ten wypada jej z rąk. 'Nie jestem złodziejką, przysięgam! Po prostu... znalazłam go na korytarzu i myślałam, że należy do Pana.'";
"NovelMaidPromptFour" = "Podnieść klucz?";
"NovelMaidActionFourA" = "(Podnieś go z podłogi)";
"NovelMaidActionFourB" = "Odkryjmy, co otwiera";
"NovelMaidContentFive" = "Klucz pasuje do ukrytej przegródki w sejfie. Elena wstrzymuje oddech, gdy wyciągasz stos pożółkłych listów przewiązanych czarną wstążką.";
"NovelMaidPromptFive" = "Przeczytać pierwszy list?";
"NovelMaidActionFiveA" = "Przeczytaj go na głos";
"NovelMaidActionFiveB" = "Zapytaj Elenę, czy coś o tym wie";
"NovelMaidContentSix" = "Głos Eleny cichnie do szeptu. 'Moja mama też była tu pokojówką. Powiedziała mi, że Pan trzymał zapiski o dziewczynie, którą kiedyś kochał. Kimś, kto wyglądał tak jak ja.'";
"NovelMaidPromptSix" = "Chwileczka, naprawdę?";
"NovelMaidActionSixA" = "Powiedz mi wszystko, co wiesz";
"NovelMaidActionSixB" = "To nie może być prawda";
"NovelMaidContentSeven" = "Notatki mówią o tajnym romansie. Elena robi krok w Twoją stronę, a w świetle księżyca lśnią jej łzy. 'Nie chciałam nic ukraść. Chciałam tylko wiedzieć, czy naprawdę tu przynależę.'";
"NovelMaidPromptSeven" = "Pocieszyć ją?";
"NovelMaidActionSevenA" = "Połóż dłoń na jej ramieniu";
"NovelMaidActionSevenB" = "Daj jej trochę przestrzeni";
"NovelMaidContentEight" = "Wyjawia, że pamiętnik jej matki wspominał o ukrytej prawdzie w tym pokoju. 'Mieszkałam tu całe życie, panie, a czuję się jak duch.'";
"NovelMaidPromptEight" = "Złożyć obietnicę?";
"NovelMaidActionEightA" = "Pomogę Ci odkryć prawdę";
"NovelMaidActionEightB" = "Rozwiążemy to razem";
"NovelMaidContentNine" = "Spędzacie kolejną godzinę na przeszukiwaniu starych dokumentów. Znajdujesz akt urodzenia ze znanym nazwiskiem, ale pole ojca jest puste.";
"NovelMaidPromptNine" = "Spojrzeć na Elenę?";
"NovelMaidActionNineA" = "Czy to mogło dotyczyć mojego wuja?";
"NovelMaidActionNineB" = "Może lepiej zostawić to nieodkryte";
"NovelMaidContentTen" = "Poszukiwania stają się intensywniejsze. Elena zauważa szkatułkę na biżuterię za dokumentami. Wewnątrz znajduje się medalion z portretem kobiety wyglądającej identycznie jak ona.";
"NovelMaidPromptTen" = "Pokazać jej medalion?";
"NovelMaidActionTenA" = "Spójrz na ten medalion";
"NovelMaidActionTenB" = "Czy to może być Twoja matka?";
"NovelMaidContentEleven" = "Nagle w pobliżu skrzypi podłoga. Ktoś idzie korytarzem. Oczy Eleny rozszerzają się ze strachu. 'Jeśli Kamerdyner nas przyłapie...!'";
"NovelMaidPromptEleven" = "Schować się?";
"NovelMaidActionElevenA" = "Schowajcie się razem w szafie";
"NovelMaidActionElevenB" = "Zostańcie tu i stawcie mu czoła";
"NovelMaidContentTwelve" = "Kroki stają się głośniejsze. Elena chwyta Cię za ramię. 'Błagam, panie, nikt nie może wiedzieć, że to odkryliśmy. To dla mnie niebezpieczne.'";
"NovelMaidPromptTwelve" = "Co robisz?";
"NovelMaidActionTwelveA" = "Zgaś światło";
"NovelMaidActionTwelveB" = "Zablokuj drzwi";
"NovelMaidContentThirteen" = "W pokoju panuje egipska ciemność. W ciasnej przestrzeni słyszysz szybkie bicie serca Eleny i czujesz zapach róż. Stoi niezwykle blisko.";
"NovelMaidPromptThirteen" = "Szepnąć jej coś?";
"NovelMaidActionThirteenA" = "Jesteś przy mnie bezpieczna";
"NovelMaidActionThirteenB" = "(Zostań w ciszy i czekaj)";
"NovelMaidContentFourteen" = "Przytrzymujesz drzwi. Osoba na zewnątrz zatrzymuje się na chwilę, po czym odchodzi. Elena opiera się o Ciebie, drżąc z emocji.";
"NovelMaidPromptFourteen" = "Uspokoić ją?";
"NovelMaidActionFourteenA" = "Odeszli już";
"NovelMaidActionFourteenB" = "Wszystko w porządku?";
"NovelMaidContentFifteen" = "Cofa się lekko, ale jej dłoń spoczywa na Twojej klatce piersiowej. 'Panie... zawsze podziwiałam Pana z daleka. Ten sekret... jest zbyt ciężki, by nieść go samemu.'";
"NovelMaidPromptFifteen" = "Wyrazić swoje uczucia?";
"NovelMaidActionFifteenA" = "Ja też Cię zauważyłem";
"NovelMaidActionFifteenB" = "Znaczysz dla mnie więcej niż pokojówka";
"NovelMaidContentSixteen" = "'Myślałam, że jestem dla Pana tylko służącą,' szepcze. 'Tylko częścią majątku. Ale dzisiejsza noc wydaje się początkiem czegoś prawdziwego.'";
"NovelMaidPromptSixteen" = "Zgodzić się z nią?";
"NovelMaidActionSixteenA" = "To jest prawdziwe, Elena";
"NovelMaidActionSixteenB" = "Zobaczmy, dokąd nas to doprowadzi";
"NovelMaidContentSeventeen" = "Otwiera medalion. Wewnątrz znajduje się mały liścik: 'Dla mojej córki, prawowitej spadkobierczyni.' Elena zamiera. Majątek prawnie należy do niej.";
"NovelMaidPromptSeventeen" = "Co to oznacza?";
"NovelMaidActionSeventeenA" = "Musimy to ujawnić";
"NovelMaidActionSeventeenB" = "Musimy zachować to w tajemnicy";
"NovelMaidContentEighteen" = "Papier potwierdza, że Elena jest prawdziwą właścicielką majątku. Rozgląda się po pokoju, zmieszana. 'Ja... nie dbam o posiadłość. Chcę po prostu mieć rodzinę.'";
"NovelMaidPromptEighteen" = "Jakie jest Twoje życzenie?";
"NovelMaidActionEighteenA" = "Masz teraz mnie";
"NovelMaidActionEighteenB" = "Co zamierzasz zrobić?";
"NovelMaidContentNineteen" = "Spogląda w stronę kominka. 'Jeśli to zniszczę, zostanę po prostu Eleną. Jeśli zatrzymam, wszystko się zmieni. Co powinnam wybrać?'";
"NovelMaidPromptNineteen" = "Doradzić jej?";
"NovelMaidActionNineteenA" = "Zniszcz to i zostań u mojego boku";
"NovelMaidActionNineteenB" = "Zatrzymaj to i odbierz swój tytuł";
"NovelMaidContentTwenty" = "Elena trzyma dokument swojego pochodzenia. 'To nazwisko niesie ze sobą klątwę. Wolę być szczęśliwym nikim niż nieszczęśliwą dziedziczką.'";
"NovelMaidPromptTwenty" = "Twój wybór?";
"NovelMaidActionTwentyA" = "Posłuchaj swojego serca";
"NovelMaidActionTwentyB" = "Przemyśl ostrożnie swoją przyszłość";
"NovelMaidContentTwentyOne" = "Wrzuca papier w gasnące płomienie. Sekret zamienia się w popiół. Elena uśmiecha się, wyglądając na lżejszą niż kiedykolwiek wcześniej.";
"NovelMaidPromptTwentyOne" = "Co przed Wami?";
"NovelMaidActionTwentyOneA" = "Zupełnie nowy rozdział";
"NovelMaidActionTwentyOneB" = "Tylko nasza dwójka";
"NovelMaidContentTwentyTwo" = "Chowa papier w gorsecie. 'W takim razie zostanę Panią tego domu. I będę potrzebować partnera u mojego boku.'";
"NovelMaidPromptTwentyTwo" = "Jesteś gotowy?";
"NovelMaidActionTwentyTwoA" = "Zawsze gotowy";
"NovelMaidActionTwentyTwoB" = "To będzie trudna droga";
"NovelMaidContentTwentyThree" = "Elena nie jest już tylko pokojówką. Jest Twoją równorzędną partnerką i Twoim wspólnym sekretem. Posiadłość pozostaje Twoja, ale jej serce należy do niej.";
"NovelMaidPromptTwentyThree" = "KONIEC";
"NovelMaidActionTwentyThreeA" = "Zagraj ponownie";
"NovelMaidActionTwentyThreeB" = "Wyjdź";
"NovelMaidContentTwentyFour" = "Prawda wychodzi na jaw. Elena staje się głową domu. Relacja uległa zmianie, ale więź, którą ukuliście tej nocy, pozostaje nienaruszona.";
"NovelMaidPromptTwentyFour" = "KONIEC";
"NovelMaidActionTwentyFourA" = "Zagraj ponownie";
"NovelMaidActionTwentyFourB" = "Wyjdź";

"NovelTokyoContentZero" = "Deszcz leje na neonowe ulice Shinjuku. Siedlisz w cichym barze, gdy obok Ciebie siada kobieta w przemoczonym płaszczu. Pachnie jaśminem i prochem strzelniczym.";
"NovelTokyoPromptZero" = "Jak zagajasz rozmowę?";
"NovelTokyoActionZeroA" = "Zamów dla niej drinka";
"NovelTokyoActionZeroB" = "Ciężka noc, co?";
"NovelTokyoContentOne" = "Spogląda na szklankę, a potem na Ciebie. 'Jesteś odważny,' szepcze, przesuwając mały mikrochip po stole.";
"NovelTokyoPromptOne" = "Chwycić mikrochip?";
"NovelTokyoActionOneA" = "Weź go i ukryj";
"NovelTokyoActionOneB" = "Nie chcę żadnych kłopotów";
"NovelTokyoContentTwo" = "Wypuszcza gorzki śmiech. 'Nie masz pojęcia.' Spogląda przez ramię. Do baru właśnie weszło dwóch mężczyzn w garniturach.";
"NovelTokyoPromptTwo" = "Pomóc jej się ukryć?";
"NovelTokyoActionTwoA" = "Chodź za mną tylnym wyjściem";
"NovelTokyoActionTwoB" = "Udawajmy, że jesteśmy razem";
"NovelTokyoContentThree" = "Przyciągasz ją do siebie. Mężczyźni rozglądają się po lokalu i wychodzą. Ona wydaje się uspokojona, choć jej dłonie wciąż drżą. 'Jestem Mia,' szepcze.";
"NovelTokyoPromptThree" = "Zapytać o zagrożenie?";
"NovelTokyoActionThreeA" = "Kim byli ci ludzie, Mia?";
"NovelTokyoActionThreeB" = "Czy jesteśmy bezpieczni?";
"NovelTokyoContentFour" = "Mężczyźni podchodzą bliżej, ale zachowujesz spokój. Przechodzą obok. Ona szepcze: 'Ocaliłeś mnie. Jestem Mia. Ale ten mikrochip... jest warty miliony żyć.'";
"NovelTokyoPromptFour" = "Zapytać o mikrochip?";
"NovelTokyoActionFourA" = "Co na nim jest?";
"NovelTokyoActionFourB" = "Powinniśmy stąd uciekać";
"NovelTokyoContentFive" = "Mia spogląda na drzwi. 'Arasaka Corp tego chce. To nie są zwykłe dane, to cyfrowa dusza.'";
"NovelTokyoPromptFive" = "Wierzysz jej?";
"NovelTokyoActionFiveA" = "Cyfrowa dusza? Serio?";
"NovelTokyoActionFiveB" = "Słyszałem już o tym pogłoski...";
"NovelTokyoContentSix" = "Mia łapie Cię za nadgarstek. 'Nigdzie nie będziemy bezpieczni, dopóki tego nie prześlemy. Musimy dostać się do Dzielnicy Technologicznej.'";
"NovelTokyoPromptSix" = "Towarzyszyć jej?";
"NovelTokyoActionSixA" = "Zabiorę Cię tam";
"NovelTokyoActionSixB" = "Tylko jeśli wyjaśnisz mi więcej";
"NovelTokyoContentSeven" = "Wychodzicie tylną alejką. W ciemnym przejściu pachnie ozonem. Nagle nad Wami zawisa dron, skanując obszar w poszukiwaniu śladów ciepła.";
"NovelTokyoPromptSeven" = "Jak uniknąć drona?";
"NovelTokyoActionSevenA" = "Schowajcie się pod daszkiem";
"NovelTokyoActionSevenB" = "Biegnijcie do metra";
"NovelTokyoContentEight" = "Mia zatrzymuje się w ulewnym deszczu. 'Jeśli mnie złapią, wyczyszczą mi pamięć. I Tobie też za pomoc mi.'";
"NovelTokyoPromptEight" = "Uspokoić ją?";
"NovelTokyoActionEightA" = "Jestem w tym z Tobą";
"NovelTokyoActionEightB" = "Ruszajmy się szybko";
"NovelTokyoContentNine" = "Dron odlatuje. Docieracie do Twojego auta. Mia patrzy na Ciebie z mieszanką strachu i wdzięczności.";
"NovelTokyoPromptNine" = "Odpalić samochód?";
"NovelTokyoActionNineA" = "Wciśnij gaz do dechy!";
"NovelTokyoActionNineB" = "Jedź spokojnie, by nie rzucać się w oczy";
"NovelTokyoContentTen" = "Cudem docieracie na stację. Ogromny tłum daje idealną osłonę. Mia trzyma się blisko, jej ramię opiera się o Twoje.";
"NovelTokyoPromptTen" = "Idziecie dalej?";
"NovelTokyoActionTenA" = "Złapcie ekspresowy pociąg";
"NovelTokyoActionTenB" = "Kierujcie się tunelami";
"NovelTokyoContentEleven" = "Poruszacie się po dzielnicy wieżowców. Holograficzne reklamy oświetlają twarz Mii w odcieniach różu i błękitu.";
"NovelTokyoPromptEleven" = "Przerwać ciszę?";
"NovelTokyoActionElevenA" = "Dlaczego wybrałaś mnie, Mia?";
"NovelTokyoActionElevenB" = "Opowiedz mi o tym chipie";
"NovelTokyoContentTwelve" = "Miasto przypomina niekończący się labirynt. Zatrzymujecie się w ukrytej knajpce z ramenem, by na chwilę odpocząć.";
"NovelTokyoPromptTwelve" = "Obejrzeć ulicę?";
"NovelTokyoActionTwelveA" = "Sprawdź, czy ktoś Was nie śledzi";
"NovelTokyoActionTwelveB" = "Porozmawiaj z Mią";
"NovelTokyoContentThirteen" = "Mia spuszcza wzrok. 'Byłeś jedyną osobą, która nie wyglądała dziś groźnie. Potrzebowałam człowieka, nie najemnika.'";
"NovelTokyoPromptThirteen" = "Odpowiedzieć ciepło?";
"NovelTokyoActionThirteenA" = "Cieszę się, że tam byłem";
"NovelTokyoActionThirteenB" = "Jestem tylko zwykłym gościem z baru";
"NovelTokyoContentFourteen" = "Mia dotyka chipa. 'To zawiera świadomość mojej siostry. Była hakerką, która odkryła za dużo. Zniszczyli jej ciało.'";
"NovelTokyoPromptFourteen" = "Okazać współczucie?";
"NovelTokyoActionFourteenA" = "To straszne...";
"NovelTokyoActionFourteenB" = "Czy da się ją uratować?";
"NovelTokyoContentFifteen" = "Ociera łzę. 'Terminal jest przy starej wieży telewizyjnej. Ale główny most jest zablokowany przez policję.'";
"NovelTokyoPromptFifteen" = "Jak przejdziecie?";
"NovelTokyoActionFifteenA" = "Użyj narzędzi do hakowania";
"NovelTokyoActionFifteenB" = "Przekup strażników";
"NovelTokyoContentSixteen" = "Mia pokazuje mapę. 'Droga przez kanały jest bezpieczniejsza, choć zajmie znacznie więcej czasu.'";
"NovelTokyoPromptSixteen" = "Wybór trasy?";
"NovelTokyoActionSixteenA" = "Zejdźmy do kanałów";
"NovelTokyoActionSixteenB" = "Nie, czas jest kluczowy";
"NovelTokyoContentSeventeen" = "Jest wilgotno i ciemno, ale bezpiecznie. Mia polega na Twoim prowadzeniu. Cujesz ciężar jej zaufania.";
"NovelTokyoPromptSeventeen" = "Pomóc jej przejść?";
"NovelTokyoActionSeventeenA" = "Podaj jej dłoń";
"NovelTokyoActionSeventeenB" = "Prowadź przodem";
"NovelTokyoContentEighteen" = "Na moście panuje chaos. Wykorzystujecie zamieszanie, by się przemknąć. Serce Mii bije tak szybko, że prawie je słyszysz.";
"NovelTokyoPromptEighteen" = "Uspokoić ją?";
"NovelTokyoActionEighteenA" = "Jesteśmy już prawie na miejscu";
"NovelTokyoActionEighteenB" = "Skup się, Mia";
"NovelTokyoContentNineteen" = "Wieża telewizyjna majaczy przed Wami. To relikt przeszłości, otoczony stalowymi konstrukcjami. Mia wygląda na wykończoną.";
"NovelTokyoPromptNineteen" = "Zrobić przerwę?";
"NovelTokyoActionNineteenA" = "Odpocznijcie pięć minut";
"NovelTokyoActionNineteenB" = "Idźcie dalej na samą górę";
"NovelTokyoContentTwenty" = "Docieracie do podstawy wieży. 'Winda nie działa,' wzdycha Mia. 'Musimy iść schodami.'";
"NovelTokyoPromptTwenty" = "Dodać jej otuchy?";
"NovelTokyoActionTwentyA" = "Krok po kroku";
"NovelTokyoActionTwentyB" = "Mogę ponieść Twój sprzęt";
"NovelTokyoContentTwentyOne" = "Odpoczywacie na klatce schodowej. Mia opiera się o Twoje ramię. 'Jeśli nam się uda... co zrobisz jutro?'";
"NovelTokyoPromptTwentyOne" = "Pomyśleć o przyszłości?";
"NovelTokyoActionTwentyOneA" = "Może wyskoczymy na kawę";
"NovelTokyoActionTwentyOneB" = "Będę po prostu szczęśliwy, że odpocznę";
"NovelTokyoContentTwentyTwo" = "Wspinaczka jest wycieńczająca. W połowie drogi na dole wyją syreny. Namierzyli Wasz pojazd.";
"NovelTokyoPromptTwentyTwo" = "Przyspieszyć?";
"NovelTokyoActionTwentyTwoA" = "Zwiększmy tempo!";
"NovelTokyoActionTwentyTwoB" = "Znajdźmy kryjówkę";
"NovelTokyoContentTwentyThree" = "Docieracie do serwerowni. Powietrze jest chłodne i tętni energią. Mia podłącza chip. 'Inicjalizacja...' mówi.";
"NovelTokyoPromptTwentyThree" = "Patrzeć na ekran?";
"NovelTokyoActionTwentyThreeA" = "Pilnuj wejścia";
"NovelTokyoActionTwentyThreeB" = "Zostań przy Mii";
"NovelTokyoContentTwentyFour" = "Konsola jest stara, ale działa. Palce Mii śmigają po klawiaturze. 'Zapora sieciowa jest ogromna!'";
"NovelTokyoPromptTwentyFour" = "Pomóc jej hakować?";
"NovelTokyoActionTwentyFourA" = "Przeciąż zasilanie";
"NovelTokyoActionTwentyFourB" = "Utrzymuj ją w spokoju";
"NovelTokyoContentTwentyFive" = "Drzwi otwierają się z sykiem. Oddział taktyczny Arasaki dotarł na miejsce. Wyciągasz broń. 'Jeszcze tylko dwie minuty!' krzyczy Mia.";
"NovelTokyoPromptTwentyFive" = "Trzymać pozycję?";
"NovelTokyoActionTwentyFiveA" = "Otwórz ogień!";
"NovelTokyoActionTwentyFiveB" = "Zablokuj drzwi";
"NovelTokyoContentTwentySix" = "Oczy Mii lśnią na niebiesko. Jest całkowicie w sieci. Żołnierze przebijają szklany dach.";
"NovelTokyoPromptTwentySix" = "Chronić Mię?";
"NovelTokyoActionTwentySixA" = "Osłoń ją własnym ciałem";
"NovelTokyoActionTwentySixB" = "Wciągnij ją za osłonę";
"NovelTokyoContentTwentySeven" = "Pojawia się jasny błysk światła. Wysyłanie osiąga 100%. Żołnierze zastygają, gdy ich cybernetyka zostaje zablokowana przez sieć.";
"NovelTokyoPromptTwentySeven" = "Sprawdzić co z Mią?";
"NovelTokyoActionTwentySevenA" = "Koniec?";
"NovelTokyoActionTwentySevenB" = "Wszystko w porządku?";
"NovelTokyoContentTwentyEight" = "Wszystko tonie w ciemności. Nagle każdy ekran w Tokio wyświetla jeden komunikat: 'WOLNOŚĆ'. Mia osuwa się w Twoje ramiona.";
"NovelTokyoPromptTwentyEight" = "Obudzić ją?";
"NovelTokyoActionEightA" = "Mia! Powiedz coś!";
"NovelTokyoActionEightB" = "Przytul ją mocno";
"NovelTokyoContentTwentyNine" = "Słońce wschodzi nad odmienionym Tokio. Mia uśmiecha się, jej oczy wracają do normy. 'Jest bezpieczna. Jesteśmy bezpieczni.'";
"NovelTokyoPromptTwentyNine" = "KONIEC";
"NovelTokyoActionTwentyNineA" = "Zagraj ponownie";
"NovelTokyoActionTwentyNineB" = "Wyjdź";

"NovelCampContentZero" = "Ostatnia noc letniego obozu. Trzeszczące ognisko powoli gaśnie, a powietrze pachnie sosną. Yuki, zazwyczaj cicha, łapie Twój wzrok i wskazuje na ciemną ścieżkę nad jezioro.";
"NovelCampPromptZero" = "Pójdziesz za nią w noc?";
"NovelCampActionZeroA" = "Czekałem na tę chwilę";
"NovelCampActionZeroB" = "Jasne, chodźmy";
"NovelCampContentOne" = "Doganiasz ją. Las tętni śpiewem świerszczy. Dłoń Yuki delikatnie muska Twoją podczas marszu. Wygląda na przejętą.";
"NovelCampPromptOne" = "Jak przełamiesz ciszę?";
"NovelCampActionOneA" = "Złap ją mocno za rękę";
"NovelCampActionOneB" = "Zapytaj, o czym myśli";
"NovelCampContentTwo" = "Idziecie ramię w ramię. Światło księżyca ledwo przebija się przez gęste drzewa. Yuki spogląda na Ciebie z ukosa, uśmiechając się lekko. 'Nie myślałam, że naprawdę pójdziesz,' szepcze.";
"NovelCampPromptTwo" = "Co odpowiadasz?";
"NovelCampActionTwoA" = "Nie przegapiłbym tego za nic";
"NovelCampActionTwoB" = "Byłem po prostu ciekawy";
"NovelCampContentThree" = "Docieracie do pomostu. Jezioro przypomina ciemne lustro odbijające rozgwieżdżone niebo. Yuki zdejmuje buty i siada na krawędzi, machając nogami.";
"NovelCampPromptThree" = "Usiąść blisko niej?";
"NovelCampActionThreeA" = "Usiądź tuż obok niej";
"NovelCampActionThreeB" = "Daj jej trochę przestrzeni";
"NovelCampContentFour" = "Pomost skrzypi pod Waszym ciężarem. Chłodna bryza od wody sprawia, że Yuki lekko drży. Pozostaje blisko, gdy podchodzisz.";
"NovelCampPromptFour" = "Zaoferować jej kurtkę?";
"NovelCampActionFourA" = "Owiń ją swoją kurtką";
"NovelCampActionFourB" = "Po prostu usiądźcie i porozmawiajcie";
"NovelCampContentFive" = "Yuki patrzy w gwiazdy. 'Pamiętasz nasz pierwszy dzień tutaj?' pyta. 'Pomogłeś mi z bagażami, gdy wszyscy inni byli zajęci.'";
"NovelCampPromptFive" = "Pamiętasz to?";
"NovelCampActionFiveA" = "Pamiętam każdy szczegół";
"NovelCampActionFiveB" = "Wydaje się, jakby to było wieki temu";
"NovelCampContentSix" = "Śmieje się cicho. 'Byłam wtedy taka przerażona. Ale obecność przy Tobie sprawiła, że poczułam się tu mile widziana.' Spogląda na wodę.";
"NovelCampPromptSix" = "Wyznasz własne uczucia?";
"NovelCampActionSixA" = "Czułem dokładnie to samo";
"NovelCampActionSixB" = "Cieszę się, że mogłem pomóc";
"NovelCampContentSeven" = "Noc jest niezwykle spokojna. Nagle Yuki wstaje. 'Woda wygląda tak kusząco. Może... wskoczymy?' pyta z psotnym uśmiechem.";
"NovelCampPromptSeven" = "Jesteś odważny?";
"NovelCampActionSevenA" = "Wskakujmy!";
"NovelCampActionSevenB" = "Jest za zimno, Yuki";
"NovelCampContentEight" = "Wpatruje się w jezioro, a potem na Ciebie. 'Chcę zrobić coś szalonego tej nocy. Coś, co zapamiętam na całą zimę.'";
"NovelCampPromptEight" = "Zachęcić ją?";
"NovelCampActionEightA" = "Wskakuj ze mną!";
"NovelCampActionEightB" = "Zostańmy tutaj";
"NovelCampContentNine" = "CHLUP! Woda jest lodowata, ale ekscytująca. Wynurzacie się oboje, śmiejąc się i pryskając na siebie wodą jak dzieci.";
"NovelCampPromptNine" = "Podpłynąć bliżej niej?";
"NovelCampActionNineA" = "Przytul ją do siebie";
"NovelCampActionNineB" = "Pryskaj dalej!";
"NovelCampContentTen" = "Zostajecie na drewnianym pomoście. Rozmawiacie godzinami o wszystkim — o szkole, rodzicach i przyszłości. Więź pogłębia się w nocnej ciszy.";
"NovelCampPromptTen" = "Pochylić się bliżej?";
"NovelCampActionTenA" = "Oprzyj swoją głowę na jej głowie";
"NovelCampActionTenB" = "Spójrz jej głęboko w oczy";
"NovelCampContentEleven" = "Atmosfera się zmienia. Yuki cichnie. W słabym świetle jej oczy szukają Twoich. 'Nie chcę jutro wracać do miasta,' szepcze.";
"NovelCampPromptEleven" = "Co odpowiesz?";
"NovelCampActionElevenA" = "Będziemy się tam widywać";
"NovelCampActionElevenB" = "Nie skupiajmy się na jutrze";
"NovelCampContentTwelve" = "Yuki bierze głęboki oddech. 'Jeśli nie powiem tego teraz, to nigdy tego nie zrobię. Podobasz mi się od pierwszego dnia na przystanku.'";
"NovelCampPromptTwelve" = "Jak zareagujesz?";
"NovelCampActionTwelveA" = "Ty też mi się podobałaś";
"NovelCampActionTwelveB" = "W końcu prawda!";
"NovelCampContentThirteen" = "Sięga do kieszeni i wyciąga plecioną bransoletkę przyjaźni. Jest niebiesko-biała, jak kolory jeziora. 'Zrobiłam to dla Ciebie,' mówi nieśmiało.";
"NovelCampPromptThirteen" = "Przyjąć prezent?";
"NovelCampActionThirteenA" = "Pozwól jej zawiązać ją na Twoim nadgarstku";
"NovelCampActionThirteenB" = "Pocałuj ją w zamian";
"NovelCampContentFourteen" = "Bransoletka jest prosta, ale wiesz, że zajęła jej godziny pracy. Czeka na Twoją reakcję, drżąc lekko z emocji.";
"NovelCampPromptFourteen" = "Twój ruch?";
"NovelCampActionFourteenA" = "Podziękuj jej przytuleniem";
"NovelCampActionFourteenB" = "Powiedz jej, że jest wspaniała";
"NovelCampContentFifteen" = "Yuki uśmiecha się promiennie. 'Bałam się, że uznasz to za dziecinne.' Patrzy na księżyc, wyglądając na pewniejszą siebie.";
"NovelCampPromptFifteen" = "Złożyć obietnicę?";
"NovelCampActionFifteenA" = "Obiecaj dzwonić codziennie";
"NovelCampActionFifteenB" = "Obiecaj odwiedzić ją niedługo";
"NovelCampContentSixteen" = "Atmosfera jest gorąca. Yuki patrzy na Twoje usta. Otoczenie znika; jesteście tylko Wy dwoje w letnią noc.";
"NovelCampPromptSixteen" = "Czy to ta chwila?";
"NovelCampActionSixteenA" = "Pochyl się do pocałunku";
"NovelCampActionSixteenB" = "Szepnij coś słodkiego";
"NovelCampContentSeventeen" = "W tym momencie spada gwiazda, zostawiając srebrny ślad. Yuki wstrzymuje oddech. 'Szybko! Pomyśl życzenie!' woła.";
"NovelCampPromptSeventeen" = "O co prosisz?";
"NovelCampActionSeventeenA" = "Życzę sobie wspólnej przyszłości";
"NovelCampActionSeventeenB" = "Życzę sobie, by ta noc trwała wiecznie";
"NovelCampContentEighteen" = "Gwiazda znika tak szybko, jak się pojawiła. Yuki mocno zamyka oczy. 'Pomyślałam coś specjalnego,' mówi, rumieniąc się.";
"NovelCampPromptEighteen" = "Zapytać co to było?";
"NovelCampActionEighteenA" = "Powiedz mi swoje życzenie";
"NovelCampActionEighteenB" = "Chyba wiem, co to było";
"NovelCampContentNineteen" = "Ognisko obozowe całkowicie zgasło. Zaczynacie wracać, trzymając się za ręce. Las wydaje się inny — mniej groźny, bardziej magiczny.";
"NovelCampPromptNineteen" = "Iść powoli?";
"NovelCampActionNineteenA" = "Wybierzcie dłuższą drogę powrotną";
"NovelCampActionNineteenB" = "Cieszcie się tą cichą chwilą";
"NovelCampContentTwenty" = "Mijacie stary dąb, przy którym spotkaliście się po raz pierwszy. Yuki zatrzymuje się na chwilę. 'Wszystko się zmieni, prawda?' pyta cicho.";
"NovelCampPromptTwenty" = "Pocieszyć ją?";
"NovelCampActionTwentyA" = "Zmiany mogą być dobre";
"NovelCampActionTwentyB" = "Nie wszystko musi się zmieniać";
"NovelCampContentTwentyOne" = "Domki obozowe pojawiają się w zasięgu wzroku. Inni obozowicze śpią. Yuki zatrzymuje się przy swoich drzwiach. Waha się, czy puścić Twoją dłoń.";
"NovelCampPromptTwentyOne" = "Ostatnia rzecz?";
"NovelCampActionTwentyOneA" = "Poproś o pocałunek na pożegnanie";
"NovelCampActionTwentyOneB" = "Poproś o jej numer telefonu";
"NovelCampContentTwentyTwo" = "Yuki zwleka przy drzwiach. Lampa na ganku rzuca ciepłe światło na jej twarz. 'Dziękuję za tę noc. To był najlepszy wieczór w moim życiu.'";
"NovelCampPromptTwentyTwo" = "Pożegnać się?";
"NovelCampActionTwentyTwoA" = "Do zobaczenia rano";
"NovelCampActionTwentyTwoB" = "Dobranoc, Yuki";
"NovelCampContentTwentyThree" = "Wschód słońca. Obóz jest pełen ludzi pakujących torby i wsiadających do autobusów. Szukasz Yuki w tłumie, a Twoje serce bije jak szalone.";
"NovelCampPromptTwentyThree" = "Znajdziesz ją?";
"NovelCampActionTwentyThreeA" = "Szukaj w pobliżu autobusu";
"NovelCampActionTwentyThreeB" = "Sprawdź pomost po raz ostatni";
"NovelCampContentTwentyFour" = "Silniki autobusów chodzą na biegu jałowym. Dostrzegasz ją! Stoi przy bramie, rozglądając się nerwowo, dopóki jej wzrok nie spotyka Twojego.";
"NovelCampPromptTwentyFour" = "Pobiegniesz do niej?";
"NovelCampActionTwentyFourA" = "Pobiegnij i przytul ją mocno";
"NovelCampActionTwentyFourB" = "Pomachaj i uśmiechnij się";
"NovelCampContentTwentyFive" = "Docierasz do niej w ostatniej chwili. Szepcze Ci do ucha słowa, które zapamiętasz na zawsze. 'Nie pozwól, by to zostało tylko letnim wspomnieniem.'";
"NovelCampPromptTwentyFive" = "Twoja odpowiedź?";
"NovelCampActionTwentyFiveA" = "Obiecuję";
"NovelCampActionTwentyFiveB" = "Do zobaczenia w przyszły weekend";
"NovelCampContentTwentySix" = "Kierowca trąbi. Yuki musi iść. Przesyła Ci całusa, wsiadając do środka. Stoisz tam, patrząc jak autobus znika w oddali.";
"NovelCampPromptTwentySix" = "Jak się czujesz?";
"NovelCampActionTwentySixA" = "Szczęśliwy i pełen nadziei";
"NovelCampActionTwentySixB" = "Smutny, ale spełniony";
"NovelCampContentTwentySeven" = "Miesiące później. Jesteś w mieście, a Twój telefon wibruje. To zdjęcie od Yuki — ma na sobie bransoletkę, którą się podzieliliście. Lato nigdy naprawdę się nie skończyło.";
"NovelCampPromptTwentySeven" = "KONIEC";
"NovelCampActionTwentySevenA" = "Zagraj ponownie";
"NovelCampActionTwentySevenB" = "Wyjdź";
"NovelCampContentTwentyEight" = "Spoglądasz na bransoletkę na swoim nadgarstku. Jest lekko zużyta, ale wspomnienia pozostają żywe. Czasami jedno lato wystarczy na całe życie.";
"NovelCampPromptTwentyEight" = "KONIEC";
"NovelCampActionTwentyEightA" = "Spróbuj ponownie";
"NovelCampActionTwentyEightB" = "Wyjdź";

