"Roulette_Welcome_1" = "Chào anh! ✨ Vui quá vì vòng quay đã ghép đôi chúng ta. Em rất mong chờ được trò chuyện với anh. Ngày của anh thế nào?";
"Roulette_Welcome_2" = "Chào anh! Em đã hy vọng gặp được một người tuyệt vời hôm nay, và anh đã xuất hiện. Em rất muốn hiểu rõ hơn về anh! 😊";
"Roulette_Welcome_3" = "Ồ, chào anh! 😏 Có vẻ thuật toán đã làm việc cực kỳ tốt. Anh đã sẵn sàng đắm chìm vào cuộc trò chuyện thú vị chưa?";
"Roulette_Welcome_4" = "Cuối cùng cũng ghép cặp thành công! 🎉 Hồ sơ của anh đã thu hút em ngay lập tức. Anh đang nghĩ gì đấy?";
"Roulette_Welcome_5" = "Chào anh! Em đang thư giãn và hy vọng gặp ai đó đặc biệt... thì anh kết nối! Kể cho em nghe về anh đi. ✨";
"Roulette_Welcome_6" = "Chào anh yêu~ 😉 Ghép đôi với anh khiến ngày của em tươi sáng hơn nhiều. Cùng làm cho cuộc trò chuyện này đáng nhớ nhé!";
"Roulette_Welcome_7" = "Chào anh! Rất hào hứng khi chúng ta kết nối. 🌟 Em có cảm giác chúng ta sẽ có khoảng thời gian cực kỳ hợp nhau đấy!";
"Roulette_Welcome_8" = "Chào anh! Rất vui được gặp anh. 🥰 Em đang lắng nghe đây — hãy kể em nghe về đam mê của anh đi!";
"Roulette_Welcome_9" = "Ồ, chào anh! 💕 Em đang tìm kiếm một người thú vị để trò chuyện, và anh có vẻ là sự lựa chọn hoàn hảo.";
"Roulette_Welcome_10" = "Chào anh! Thật là một bất ngờ tuyệt vời khi được ghép đôi với anh hôm nay. Em biết chắc mọi thứ sẽ rất tuyệt! 💖";

// Novel Maid
"NovelMaidContentZero" = "Dinh thự im lìm khi anh trở về. Ánh sáng nhẹ nhàng lập lòe bên trong phòng làm việc. Anh nhận ra Elena, cô hầu gái lặng lẽ nhất, đang lo âu dọn dẹp bàn làm việc của anh lúc 2 giờ sáng.";
"NovelMaidPromptZero" = "Đi tới chỗ cô ấy?";
"NovelMaidActionZeroA" = "Elena, sao em chưa nghỉ ngơi?";
"NovelMaidActionZeroB" = "(Quan sát từ trong bóng tối)";
"NovelMaidContentOne" = "Cô ấy giật mình làm rơi chổi lông gà. 'Thưa cậu! Tôi... tôi không ngủ được. Bụi bẩn làm tôi khó chịu.' Cô ấy tái mặt và tránh ánh nhìn của anh.";
"NovelMaidPromptOne" = "Tin lời cô ấy?";
"NovelMaidActionOneA" = "Đã quá muộn để dọn dẹp rồi";
"NovelMaidActionOneB" = "Em là một người làm việc chăm chỉ";
"NovelMaidContentTwo" = "Anh quan sát cô ấy lấy ra một chiếc chìa khóa bạc nhỏ từ tạp dề. Cô ấy nhìn nó với sự khao khát lẫn sợ hãi trước khi nhận ra bóng dáng anh.";
"NovelMaidPromptTwo" = "Bước ra?";
"NovelMaidActionTwoA" = "Chiếc chìa khóa đó để làm gì, Elena?";
"NovelMaidActionTwoB" = "Giải thích những gì em đang làm đi";
"NovelMaidContentThree" = "Cô ấy run rẩy. 'Nơi này... chứa đựng quá nhiều bí mật, thưa cậu. Đôi khi chúng như gánh nặng quá sức.' Cô ấy chỉ về phía két sắt cũ sau kệ sách.";
"NovelMaidPromptThree" = "Hỏi về chiếc két sắt?";
"NovelMaidActionThreeA" = "Chiếc chìa khóa đó có vừa với két sắt không?";
"NovelMaidActionThreeB" = "Két sắt là khu vực cấm";
"NovelMaidContentFour" = "Cô ấy cố gắng giấu chiếc chìa khóa nhưng làm rơi nó. 'Tôi không phải kẻ trộm, tôi thề! Tôi chỉ... nhặt được nó ở hành lang và nghĩ là của cậu.'";
"NovelMaidPromptFour" = "Lấy lại chiếc chìa khóa?";
"NovelMaidActionFourA" = "(Nhặt nó lên từ sàn nhà)";
"NovelMaidActionFourB" = "Hãy xem nó mở ra điều gì";
"NovelMaidContentFive" = "Chiếc chìa khóa khớp với một ngăn bí mật bên trong két sắt. Elena nín thở khi anh tiết lộ một chồng thư đã ngả vàng được buộc bằng ruy băng đen.";
"NovelMaidPromptFive" = "Kiểm tra bức thư đầu tiên?";
"NovelMaidActionFiveA" = "Đọc to nó lên";
"NovelMaidActionFiveB" = "Hỏi Elena xem cô ấy có biết gì không";
"NovelMaidContentSix" = "Giọng Elena hạ thấp xuống thành tiếng thì thầm. 'Mẹ tôi từng là hầu gái ở đây. Mẹ nói rằng Bổn trang chủ giữ lại ghi chép về cô gái mà ngài từng yêu. Một người rất giống tôi.'";
"NovelMaidPromptSix" = "Chờ đã, thật sao?";
"NovelMaidActionSixA" = "Kể cho tôi nghe mọi điều em biết";
"NovelMaidActionSixB" = "Điều này không thể là sự thật";
"NovelMaidContentSeven" = "Những dòng ghi chép kể về một mối tình lén lút. Elena tiến lại gần hơn, ánh trăng lấp lánh trên giọt nước mắt của cô ấy. 'Tôi không cố ý ăn trộm. Tôi chỉ muốn biết liệu mình có thuộc về nơi này không.'";
"NovelMaidPromptSeven" = "An ủi cô ấy?";
"NovelMaidActionSevenA" = "Đặt tay lên vai cô ấy";
"NovelMaidActionSevenB" = "Cho cô ấy một chút không gian";
"NovelMaidContentEight" = "Cô ấy tiết lộ nhật ký của mẹ mình có nhắc đến một sự thật ẩn giấu trong phòng này. 'Tôi đã sống ở đây cả đời, thưa cậu, nhưng tôi cảm thấy mình như một bóng ma.'";
"NovelMaidPromptEight" = "Hứa hẹn điều gì đó?";
"NovelMaidActionEightA" = "Tôi sẽ giúp em tìm ra sự thật";
"NovelMaidActionEightB" = "Chúng ta sẽ cùng nhau giải quyết việc này";
"NovelMaidContentNine" = "Anh dành giờ tiếp theo để tìm kiếm qua các tài liệu cũ. Anh tìm thấy một giấy khai sinh với họ quen thuộc, nhưng phần tên người cha để trống.";
"NovelMaidPromptNine" = "Liếc nhìn Elena?";
"NovelMaidActionNineA" = "Liệu nó có liên quan đến chú của tôi không?";
"NovelMaidActionNineB" = "Có lẽ tốt nhất nên để nó chìm vào quên lãng";
"NovelMaidContentTen" = "Cuộc tìm kiếm trở nên dồn dập. Elena phát hiện một hộp trang sức giấu sau đống tài liệu. Bên trong là một mặt chuyền có hình chân dung người phụ nữ giống hệt cô ấy.";
"NovelMaidPromptTen" = "Cho cô ấy xem?";
"NovelMaidActionTenA" = "Nhìn vào mặt chuyền này đi";
"NovelMaidActionTenB" = "Đây có phải là mẹ em không?";
"NovelMaidContentEleven" = "Đột nhiên, sàn nhà gần đó kêu cọt kẹt. Có ai đó đang đi dạo ngoài hành lang. Mắt Elena mở to vì sợ hãi. 'Nếu Quản gia bắt gặp chúng ta...!'";
"NovelMaidPromptEleven" = "Ẩn nấp?";
"NovelMaidActionElevenA" = "Cùng trốn vào tủ quần áo";
"NovelMaidActionElevenB" = "Ở lại đây và đối mặt với họ";
"NovelMaidContentTwelve" = "Tiếng bước chân ngày càng gần hơn. Elena nắm chặt lấy tay anh. 'Xin cậu, không ai được biết chúng ta đã phát hiện ra điều này. Rất nguy hiểm cho tôi.'";
"NovelMaidPromptTwelve" = "Câu trả lời của anh?";
"NovelMaidActionTwelveA" = "Tắt đèn đi";
"NovelMaidActionTwelveB" = "Khóa chặt cửa lại";
"NovelMaidContentThirteen" = "Phòng tối đen như mực. Trong không gian chật hẹp, anh nghe thấy nhịp tim đập nhanh của Elena và mùi hoa hồng dịu nhẹ. Cô ấy đang đứng rất gần.";
"NovelMaidPromptThirteen" = "Thì thầm lại?";
"NovelMaidActionThirteenA" = "Em an toàn khi ở bên tôi";
"NovelMaidActionThirteenB" = "(Giữ im lặng và chờ đợi)";
"NovelMaidContentFourteen" = "Anh giữ chặt cửa. Người bên ngoài dừng lại một chút rồi đi tiếp. Elena tựa vào anh, run rẩy vì hồi hộp.";
"NovelMaidPromptFourteen" = "Làm cô ấy bình tĩnh lại?";
"NovelMaidActionFourteenA" = "Họ đi rồi";
"NovelMaidActionFourteenB" = "Em không sao chứ?";
"NovelMaidContentFifteen" = "Cô ấy lùi lại một chút, nhưng tay vẫn đặt trên ngực anh. 'Thưa cậu... tôi luôn ngưỡng mộ cậu từ xa. Bí mật này... quá lớn để mang một mình.'";
"NovelMaidPromptFifteen" = "Bày tỏ cảm xúc?";
"NovelMaidActionFifteenA" = "Tôi cũng đã chú ý đến em";
"NovelMaidActionFifteenB" = "Em có ý nghĩa hơn một cô hầu gái đối với tôi";
"NovelMaidContentSixteen" = "'Tôi từng nghĩ mình chỉ là một người phục vụ đối với cậu,' cô ấy thì thầm. 'Chỉ là một phần của dinh thự. Nhưng đêm nay cảm giác như sự khởi đầu của điều gì đó chân thành.'";
"NovelMaidPromptSixteen" = "Đồng ý với cô ấy?";
"NovelMaidActionSixteenA" = "Nó là chân thành đấy, Elena";
"NovelMaidActionSixteenB" = "Hãy xem điều này dẫn chúng ta đến đâu";
"NovelMaidContentSeventeen" = "Cô ấy mở mặt chuyền ra. Bên trong có một mảnh giấy nhỏ: 'Gửi con gái tôi, người thừa kế hợp pháp.' Elena thảng thốt. Dinh thự này có thể thuộc về cô ấy một cách hợp pháp.";
"NovelMaidPromptSeventeen" = "Điều này có nghĩa là gì?";
"NovelMaidActionSeventeenA" = "Chúng ta cần tiết lộ điều này";
"NovelMaidActionSeventeenB" = "Chúng ta phải giữ kín chuyện này";
"NovelMaidContentEighteen" = "Tờ giấy xác nhận Elena là chủ sở hữu đích thực của dinh thự. Cô ấy nhìn quanh phòng, bối rối. 'Tôi... không cần dinh thự này. Tôi chỉ muốn có một gia đình.'";
"NovelMaidPromptEighteen" = "Mong muốn của anh là gì?";
"NovelMaidActionEighteenA" = "Bây giờ em đã có tôi rồi";
"NovelMaidActionEighteenB" = "Em dự định làm gì tiếp theo?";
"NovelMaidContentNineteen" = "Cô ấy nhìn về phía lò sưởi. 'Nếu tôi phá hủy cái này, tôi vẫn chỉ là Elena. Nếu tôi giữ nó, mọi thứ sẽ thay đổi. Thưa cậu, tôi nên chọn gì?'";
"NovelMaidPromptNineteen" = "Đưa ra lời khuyên?";
"NovelMaidActionNineteenA" = "Hãy tiêu hủy nó và ở lại bên tôi";
"NovelMaidActionNineteenB" = "Giữ lại nó và đòi lại danh vị của em";
"NovelMaidContentTwenty" = "Elena cầm tài liệu về dòng tộc của mình. 'Dòng họ này mang một lời nguyền, thưa cậu. Tôi thà làm một người bình thường hạnh phúc còn hơn làm một tiểu thư đau khổ.'";
"NovelMaidPromptTwenty" = "Lựa chọn của anh?";
"NovelMaidActionTwentyA" = "Hãy lắng nghe trái tim em";
"NovelMaidActionTwentyB" = "Hãy cân nhắc tương lai cẩn thận";
"NovelMaidContentTwentyOne" = "Cô ấy ném tờ giấy vào ngọn lửa đang tàn. Bí mật biến thành tro bụi. Elena mỉm cười, trông nhẹ nhõm hơn bao giờ hết.";
"NovelMaidPromptTwentyOne" = "Điều gì đang chờ đợi phía trước?";
"NovelMaidActionTwentyOneA" = "Một chương hoàn toàn mới";
"NovelMaidActionTwentyOneB" = "Chỉ riêng hai chúng ta";
"NovelMaidContentTwentyTwo" = "Cô ấy đặt tờ giấy vào trong ngực áo. 'Vậy thì tôi sẽ trở thành Nữ chủ nhân của ngôi nhà này. Và tôi sẽ cần một người đồng hành bên cạnh.'";
"NovelMaidPromptTwentyTwo" = "Anh đã sẵn sàng chưa?";
"NovelMaidActionTwentyTwoA" = "Luôn sẵn sàng";
"NovelMaidActionTwentyTwoB" = "Đó sẽ là một hành trình thử thách";
"NovelMaidContentTwentyThree" = "Elena không còn chỉ là một hầu gái. Cô ấy là người bình đẳng, là đối tác và là bí mật chung của anh. Dinh thự vẫn là của anh, nhưng trái tim nó thuộc về cô ấy.";
"NovelMaidPromptTwentyThree" = "KẾT THÚC";
"NovelMaidActionTwentyThreeA" = "Chơi lại câu chuyện";
"NovelMaidActionTwentyThreeB" = "Thoát";
"NovelMaidContentTwentyFour" = "Sự thật đã được hé lộ. Elena trở thành chủ nhân ngôi nhà. Mọi thứ đã thay đổi, nhưng sự gắn kết giữa hai người đêm đó vẫn không thể phá vỡ.";
"NovelMaidPromptTwentyFour" = "KẾT THÚC";
"NovelMaidActionTwentyFourA" = "Chơi lại câu chuyện";
"NovelMaidActionTwentyFourB" = "Thoát";

// Tokyo Novel
"NovelTokyoContentZero" = "Mưa rơi trên phố đèn neon Shinjuku. Anh đang ngồi trong một quán bar yên tĩnh thì một người phụ nữ mặc áo khoác ướt đẫm ngồi xuống bên cạnh. Cô ấy tỏa ra mùi hoa nhài và mùi thuốc súng.";
"NovelTokyoPromptZero" = "Anh bắt đầu trò chuyện thế nào?";
"NovelTokyoActionZeroA" = "Gọi cho cô ấy một đồ uống";
"NovelTokyoActionZeroB" = "Một đêm vất vả nhỉ?";
"NovelTokyoContentOne" = "Cô ấy liếc nhìn ly nước, rồi nhìn anh. 'Anh dũng cảm đấy,' cô ấy thì thầm, đẩy một vi mạch nhỏ qua bàn.";
"NovelTokyoPromptOne" = "Cầm lấy vi mạch?";
"NovelTokyoActionOneA" = "Cầm lấy và giấu nó đi";
"NovelTokyoActionOneB" = "Tôi không muốn rắc rối đâu";
"NovelTokyoContentTwo" = "Cô ấy bật cười chua chát. 'Anh chẳng biết gì đâu.' Cô ấy liếc qua vai. Hai người đàn ông mặc vest vừa bước vào quán bar.";
"NovelTokyoPromptTwo" = "Giúp cô ấy trốn?";
"NovelTokyoActionTwoA" = "Đi theo tôi qua lối thoát sau";
"NovelTokyoActionTwoB" = "Giả vờ như chúng ta là một đôi";
"NovelTokyoContentThree" = "Anh kéo cô ấy lại gần. Mấy người đàn ông tìm kiếm rồi bỏ đi. Cô ấy có vẻ nhẹ nhõm, dù tay vẫn run rẩy. 'Em là Mia,' cô ấy thì thầm.";
"NovelTokyoPromptThree" = "Hỏi về mối dọa nạt?";
"NovelTokyoActionThreeA" = "Những người đó là ai vậy, Mia?";
"NovelTokyoActionThreeB" = "Chúng ta đã an toàn chưa?";
"NovelTokyoContentFour" = "Mấy người đàn ông tiến lại gần, nhưng anh vẫn điềm tĩnh. Họ đi qua. Cô ấy thì thầm: 'Anh đã cứu em. Em là Mia. Nhưng vi mạch này... nó trị giá cả triệu mạng sống.'";
"NovelTokyoPromptFour" = "Hỏi về vi mạch?";
"NovelTokyoActionFourA" = "Có gì được lưu trên đó?";
"NovelTokyoActionFourB" = "Chúng ta nên rời khỏi đây";
"NovelTokyoContentFive" = "Mia liếc nhìn ra cửa. 'Tập đoàn Arasaka muốn có thứ này. Nó không chỉ là dữ liệu, nó là một linh hồn kỹ thuật số.'";
"NovelTokyoPromptFive" = "Anh có tin cô ấy không?";
"NovelTokyoActionFiveA" = "Một linh hồn kỹ thuật số? Thật sao?";
"NovelTokyoActionFiveB" = "Tôi từng nghe đồn về điều đó...";
"NovelTokyoContentSix" = "Mia nắm lấy cổ tay anh. 'Không nơi nào an toàn cho đến khi cái này được tải lên. Chúng ta phải đến Khu Công nghệ.'";
"NovelTokyoPromptSix" = "Đi cùng cô ấy?";
"NovelTokyoActionSixA" = "Tôi sẽ đưa em đến đó";
"NovelTokyoActionSixB" = "Chỉ khi em giải thích thêm";
"NovelTokyoContentSeven" = "Anh đi ra qua hẻm sau. Lối đi tối tóm có mùi khí ozone. Đột nhiên, một chiếc drone bay phía trên, quét tìm tín hiệu nhiệt.";
"NovelTokyoPromptSeven" = "Làm sao để né drone?";
"NovelTokyoActionSevenA" = "Núp dưới mái che";
"NovelTokyoActionSevenB" = "Chạy nhanh ra tàu điện ngầm";
"NovelTokyoContentEight" = "Mia dừng lại dưới cơn mưa tầm tã. 'Nếu họ bắt được em, họ sẽ xóa ký ức của em. Và cả của anh nữa, vì đã giúp em.'";
"NovelTokyoPromptEight" = "An tâm cô ấy?";
"NovelTokyoActionEightA" = "Tôi sẽ cùng em vượt qua chuyện này";
"NovelTokyoActionEightB" = "Hãy tiếp tục di chuyển nhanh lên";
"NovelTokyoContentNine" = "Chiếc drone bay đi. Anh đến được xe của mình. Mia nhìn anh với sự lo âu xen lẫn biết ơn.";
"NovelTokyoPromptNine" = "Khởi động xe?";
"NovelTokyoActionNineA" = "Nhấn ga ngay!";
"NovelTokyoActionNineB" = "Lái xe êm ái để hòa vào dòng người";
"NovelTokyoContentTen" = "Hai người vừa kịp đến ga. Đám đông ngập tràn tạo thành vỏ bọc lý tưởng. Mia ở sát bên anh, vai cô ấy tựa vào vai anh.";
"NovelTokyoPromptTen" = "Tiếp tục đi?";
"NovelTokyoActionTenA" = "Bắt chuyến tàu tốc hành";
"NovelTokyoActionTenB" = "Đi qua các đường hầm";
"NovelTokyoContentEleven" = "Anh đang di chuyển qua khu vực nhà cao tầng. Quảng cáo hologram chiếu sáng khuôn mặt Mia trong sắc hồng và xanh.";
"NovelTokyoPromptEleven" = "Phá tan sự im lặng?";
"NovelTokyoActionElevenA" = "Tại sao lại chọn tôi, Mia?";
"NovelTokyoActionElevenB" = "Kể cho tôi nghe về chiếc chip này đi";
"NovelTokyoContentTwelve" = "Thành phố như một mê cung vô tận. Hai người dừng lại ở một quán ramen ẩn để nghỉ ngơi ngắn.";
"NovelTokyoPromptTwelve" = "Quét dọn con phố?";
"NovelTokyoActionTwelveA" = "Kiểm tra xem có ai theo đuôi không";
"NovelTokyoActionTwelveB" = "Trò chuyện với Mia";
"NovelTokyoContentThirteen" = "Mia cúi mặt. 'Anh là người duy nhất không có vẻ nguy hiểm đêm nay. Em cần một con người, không phải một tên lính đánh thuê.'";
"NovelTokyoPromptThirteen" = "Phản hồi dịu dàng?";
"NovelTokyoActionThirteenA" = "Tôi mừng vì mình đã ở đó";
"NovelTokyoActionThirteenB" = "Tôi chỉ là một anh chàng bình thường trong quán bar thôi";
"NovelTokyoContentFourteen" = "Mia chạm vào chiếc chip. 'Nơi này giữ ý thức của chị gái em. Chị ấy là một hacker đã khám phá ra quá nhiều điều. Họ đã hủy hoại cơ thể chị ấy.'";
"NovelTokyoPromptFourteen" = "Thể hiện sự đồng cảm?";
"NovelTokyoActionFourteenA" = "Thật là tồi tệ...";
"NovelTokyoActionFourteenB" = "Có cách nào cứu chị ấy không?";
"NovelTokyoContentFifteen" = "Cô ấy lau đi giọt nước mắt. 'Trạm dữ liệu nằm ở tháp truyền hình cũ. Nhưng cây cầu chính đã bị cảnh sát chặn.'";
"NovelTokyoPromptFifteen" = "Làm sao để qua?";
"NovelTokyoActionFifteenA" = "Sử dụng công cụ hack của em";
"NovelTokyoActionFifteenB" = "Mua chuộc bảo vệ";
"NovelTokyoContentSixteen" = "Mia hiển thị bản đồ. 'Đi qua đường cống ngầm an toàn hơn, dù mất nhiều thời gian hơn.'";
"NovelTokyoPromptSixteen" = "Chọn tuyến đường?";
"NovelTokyoActionSixteenA" = "Hãy đi xuống đường cống ngầm";
"NovelTokyoActionSixteenB" = "Không, tốc độ là quan trọng nhất";
"NovelTokyoContentSeventeen" = "Nơi đó ẩm ướt và tối tăm, nhưng hiệu quả. Mia dựa vào sự dẫn dắt của anh. Anh cảm nhận được trọng lượng niềm tin của cô ấy.";
"NovelTokyoPromptSeventeen" = "Giúp cô ấy vượt qua khoảng trống?";
"NovelTokyoActionSeventeenA" = "Đưa tay cho cô ấy";
"NovelTokyoActionSeventeenB" = "Dẫn đường phía trước";
"NovelTokyoContentEighteen" = "Cây cầu rất hỗn loạn. Anh tận dụng sự xao nhãng để vượt qua. Nhịp tim Mia đập nhanh đến mức anh gần như nghe thấy.";
"NovelTokyoPromptEighteen" = "Giúp cô ấy giữ bình tĩnh?";
"NovelTokyoActionEighteenA" = "Chúng ta sắp đến nơi rồi";
"NovelTokyoActionEighteenB" = "Tập trung nhé, Mia";
"NovelTokyoContentNineteen" = "Tháp truyền hình sừng sững phía trước. Đó là một di tích quá khứ, bao quanh bởi các cấu trúc thép. Mia trông kiệt sức.";
"NovelTokyoPromptNineteen" = "Nghỉ ngơi một chút?";
"NovelTokyoActionNineteenA" = "Nghỉ ngơi năm phút";
"NovelTokyoActionNineteenB" = "Tiếp tục tiến lên đỉnh";
"NovelTokyoContentTwenty" = "Hai người đến chân tháp. 'Thang máy không hoạt động,' Mia thở dài. 'Chúng ta phải đi cầu thang bộ.'";
"NovelTokyoPromptTwenty" = "Động viên cô ấy?";
"NovelTokyoActionTwentyA" = "Từng bước một thôi";
"NovelTokyoActionTwentyB" = "Tôi sẽ mang thiết bị cho";
"NovelTokyoContentTwentyOne" = "Anh nghỉ ngơi trên cầu thang. Mia tựa vào vai anh. 'Nếu chúng ta thành công... anh sẽ làm gì vào ngày mai?'";
"NovelTokyoPromptTwentyOne" = "Cân nhắc tương lai?";
"NovelTokyoActionTwentyOneA" = "Có lẽ chúng ta có thể đi uống cà phê";
"NovelTokyoActionTwentyOneB" = "Tôi chỉ thấy nhẹ nhõm vì được nghỉ ngơi";
"NovelTokyoContentTwentyTwo" = "Đoạn đường leo rất mệt. Leo được nửa đường, còi báo động vang lên bên dưới. Họ đã định vị được xe của anh.";
"NovelTokyoPromptTwentyTwo" = "Nhanh lên?";
"NovelTokyoActionTwentyTwoA" = "Tăng gấp đôi tốc độ!";
"NovelTokyoActionTwentyTwoB" = "Tìm một chỗ trốn";
"NovelTokyoContentTwentyThree" = "Anh đến phòng máy chủ. Không khí lạnh giá và rung lên vì nguồn điện. Mia cắm chip vào. 'Đang khởi tạo...' cô ấy nói.";
"NovelTokyoPromptTwentyThree" = "Theo dõi màn hình?";
"NovelTokyoActionTwentyThreeA" = "Canh giữ lối vào";
"NovelTokyoActionTwentyThreeB" = "Ở lại bên cạnh Mia";
"NovelTokyoContentTwentyFour" = "Bảng điều khiển đã cũ nhưng vẫn hoạt động. Ngón tay Mia lướt nhanh trên phím. 'Tường lửa quá lớn!'";
"NovelTokyoPromptTwentyFour" = "Hỗ trợ cô ấy hack?";
"NovelTokyoActionTwentyFourA" = "Ghi đè nguồn điện";
"NovelTokyoActionTwentyFourB" = "Giữ cho cô ấy bình tĩnh";
"NovelTokyoContentTwentyFive" = "Cửa rít lên rồi mở ra. Đội đặc nhiệm Arasaka đã đến. Anh rút vũ khí. 'Chỉ hai phút nữa thôi!' Mia mở lời.";
"NovelTokyoPromptTwentyFive" = "Cố gắng giữ vững?";
"NovelTokyoActionTwentyFiveA" = "Bắn trả!";
"NovelTokyoActionTwentyFiveB" = "Chặn cửa lại";
"NovelTokyoContentTwentySix" = "Mắt Mia lấp lánh ánh xanh. Cô ấy đã hoàn toàn vào mạng. Binh lính phá vỡ mái kính.";
"NovelTokyoPromptTwentySix" = "Bảo vệ Mia?";
"NovelTokyoActionTwentySixA" = "Lấy thân mình che chắn cho cô ấy";
"NovelTokyoActionTwentySixB" = "Kéo cô ấy vào chỗ nấp";
"NovelTokyoContentTwentySeven" = "Một luồng sáng chói xuất hiện. Quá trình tải lên đạt 100%. Lính đặc nhiệm đứng khựng lại khi thiết bị công nghệ bị tắc nghẽn từ mạng.";
"NovelTokyoPromptTwentySeven" = "Kiểm tra Mia?";
"NovelTokyoActionTwentySevenA" = "Hoàn thành chưa em?";
"NovelTokyoActionTwentySevenB" = "Em có sao không?";
"NovelTokyoContentTwentyEight" = "Mọi thứ chìm vào bóng tối. Đột nhiên, mọi màn hình khắp Tokyo hiển thị duy nhất thông điệp: 'TỰ DO'. Mia gục vào lòng anh.";
"NovelTokyoPromptTwentyEight" = "Đánh thức cô ấy?";
"NovelTokyoActionEightA" = "Mia! Nói chuyện với anh đi!";
"NovelTokyoActionEightB" = "Ôm chặt lấy cô ấy";
"NovelTokyoContentTwentyNine" = "Mặt trời mọc trên một Tokyo đã thay đổi. Mia mỉm cười, mắt trở lại bình thường. 'Chị ấy an toàn rồi. Chúng ta cũng an toàn.'";
"NovelTokyoPromptTwentyNine" = "KẾT THÚC";
"NovelTokyoActionTwentyNineA" = "Chơi lại câu chuyện";
"NovelTokyoActionTwentyNineB" = "Thoát";

// Novel Camp
"NovelCampContentZero" = "Đêm cuối cùng ở trại hè. Lửa trại bùng cháy đang tàn dần, hương thông ngập tràn không khí. Yuki, người vốn lặng lẽ, bắt gặp ánh mắt anh và ra hiệu về phía đường trail hồ tối.";
"NovelCampPromptZero" = "Anh sẽ đi theo cô ấy vào đêm tối chứ?";
"NovelCampActionZeroA" = "Anh đã chờ đợi khoảnh khắc này";
"NovelCampActionZeroB" = "Đi thôi nào";
"NovelCampContentOne" = "Anh đuổi kịp cô ấy. Khu rừng vang lên tiếng dế kêu. Bàn tay Yuki khẽ chạm vào tay anh khi bước đi. Cô ấy có vẻ lo âu.";
"NovelCampPromptOne" = "Phá tan sự im lặng?";
"NovelCampActionOneA" = "Nắm chặt tay cô ấy";
"NovelCampActionOneB" = "Hỏi xem cô ấy đang nghĩ gì";
"NovelCampContentTwo" = "Hai người đi sóng đôi. Ánh trăng hiếm hoi lọt qua tán cây rậm rạp. Yuki liếc nhìn anh, mỉm cười dịu dàng. 'Em không nghĩ anh thực sự sẽ đến,' cô ấy thì thầm.";
"NovelCampPromptTwo" = "Anh trả lời thế nào?";
"NovelCampActionTwoA" = "Anh sẽ không bỏ lỡ vì bất cứ điều gì";
"NovelCampActionTwoB" = "Anh chỉ tò mò thôi";
"NovelCampContentThree" = "Hai người đến bến tàu. Mặt hồ như chiếc gương tối, phản chiếu bầu trời đầy sao. Yuki tháo giày và ngồi ở mép, đung đưa chân.";
"NovelCampPromptThree" = "Ngồi gần cô ấy?";
"NovelCampActionThreeA" = "Ngồi ngay bên cạnh cô ấy";
"NovelCampActionThreeB" = "Cho cô ấy một chút khoảng trống";
"NovelCampContentFour" = "Bến tàu kêu cọt kẹt dưới trọng lượng. Cơn gió lạnh từ mặt nước khiến Yuki khẽ run lên. Cô ấy ở gần khi anh lại gần.";
"NovelCampPromptFour" = "Đưa áo khoác của anh?";
"NovelCampActionFourA" = "Khoác áo của anh lên người cô ấy";
"NovelCampActionFourB" = "Chỉ ngồi trò chuyện";
"NovelCampContentFive" = "Yuki nhìn lên các vì sao. 'Anh có nhớ ngày đầu tiên của chúng ta ở đây không?' cô ấy hỏi. 'Anh đã giúp em mang hành lý khi mọi người đang bận rộn.'";
"NovelCampPromptFive" = "Anh có nhớ không?";
"NovelCampActionFiveA" = "Anh nhớ từng chi tiết nhỏ";
"NovelCampActionFiveB" = "Cảm giác như đã lâu lắm rồi";
"NovelCampContentSix" = "Cô ấy cười khúc khích. 'Lúc đó em đã rất sợ hãi. Nhưng ở bên anh làm em cảm thấy được chào đón ở đây.' Cô ấy nhìn ra mặt nước.";
"NovelCampPromptSix" = "Thú nhận cảm xúc của chính anh?";
"NovelCampActionSixA" = "Anh cũng cảm thấy giống hệt như vậy";
"NovelCampActionSixB" = "Anh mừng vì đã có thể giúp đỡ";
"NovelCampContentSeven" = "Đêm hoàn toàn yên bình. Đột nhiên Yuki đứng dậy. 'Nước hồ trông thích quá. Hay là chúng mình... nhảy xuống đi?' cô ấy hỏi với nụ cười tinh nghịch.";
"NovelCampPromptSeven" = "Anh có đủ dũng cảm?";
"NovelCampActionSevenA" = "Cùng nhảy xuống nào!";
"NovelCampActionSevenB" = "Lạnh lắm Yuki ơi";
"NovelCampContentEight" = "Cô ấy nhìn ra mặt hồ, rồi nhìn anh. 'Em muốn làm điều gì đó táo bạo đêm nay. Điều gì đó em sẽ nhớ suốt mùa đông.'";
"NovelCampPromptEight" = "Động viên cô ấy?";
"NovelCampActionEightA" = "Nhảy xuống cùng anh nhé?";
"NovelCampActionEightB" = "Chúng mình ở lại đây đi";
"NovelCampContentNine" = "TÕM! Nước lạnh giá nhưng cực kỳ sảng khoái. Anh và Yuki ngoi lên, cười đùa và thở hắt ra, tạt nước vào nhau như những đứa trẻ.";
"NovelCampPromptNine" = "Bơi lại gần cô ấy?";
"NovelCampActionNineA" = "Kéo cô ấy vào một cái ôm";
"NovelCampActionNineB" = "Tiếp tục tạt nước!";
"NovelCampContentTen" = "Hai người vẫn ở trên bến gỗ. Trò chuyện hàng giờ về mọi thứ—trường học, cha mẹ và tương lai. Sự gắn kết sâu sắc hơn trong không gian yên tĩnh.";
"NovelCampPromptTen" = "Ghé sát lại?";
"NovelCampActionTenA" = "Tựa đầu anh lên đầu cô ấy";
"NovelCampActionTenB" = "Nhìn sâu vào mắt cô ấy";
"NovelCampContentEleven" = "Không khí thay đổi. Yuki trở nên im lặng. Trong ánh sáng mờ nhạt, đôi mắt cô ấy tìm kiếm ánh mắt anh. 'Em không muốn quay lại thành phố vào ngày mai,' cô ấy thì thầm.";
"NovelCampPromptEleven" = "Anh trả lời sao?";
"NovelCampActionElevenA" = "Chúng mình sẽ gặp lại nhau ở đó mà";
"NovelCampActionElevenB" = "Đừng tập trung vào ngày mai nữa";
"NovelCampContentTwelve" = "Yuki hít một hơi thật sâu. 'Nếu em không nói ra bây giờ, em sẽ không bao giờ nói. Em đã thích anh từ ngày đầu ở trạm xe být.'";
"NovelCampPromptTwelve" = "Anh đáp lại thế nào?";
"NovelCampActionTwelveA" = "Anh cũng thích em từ lâu rồi";
"NovelCampActionTwelveB" = "Cuối cùng sự thật cũng lộ diện!";
"NovelCampContentThirteen" = "Cô ấy thò tay vào túi và lấy ra một chiếc vòng tay tình bạn tự tết. Bằng màu xanh và trắng, hợp với màu mặt hồ. 'Em làm cái này cho anh,' cô ấy e ấp nói.";
"NovelCampPromptThirteen" = "Nhận món quà?";
"NovelCampActionThirteenA" = "Để cô ấy buộc vào cổ tay anh";
"NovelCampActionThirteenB" = "Trao cô ấy một nụ hôn thay lời cảm ơn";
"NovelCampContentFourteen" = "Chiếc vòng tay đơn giản, nhưng anh biết cô ấy đã mất hàng giờ để làm. Cô ấy chờ đợi phản ứng của anh, bờ môi khẽ run run.";
"NovelCampPromptFourteen" = "Hành động của anh là gì?";
"NovelCampActionFourteenA" = "Cảm ơn cô ấy bằng một cái ôm";
"NovelCampActionFourteenB" = "Nói với cô ấy rằng nó thật tuyệt vời";
"NovelCampContentFifteen" = "Yuki mỉm cười rạng rỡ. 'Em đã lo anh sẽ nghĩ nó trẻ con.' Cô ấy nhìn lên mặt trăng, có vẻ tự tin hơn.";
"NovelCampPromptFifteen" = "Hứa hẹn điều gì đó?";
"NovelCampActionFifteenA" = "Hứa sẽ gọi điện mỗi ngày";
"NovelCampActionFifteenB" = "Hứa sẽ sớm đến thăm cô ấy";
"NovelCampContentSixteen" = "Bầu không khí bùng nổ cảm xúc. Yuki nhìn vào môi anh. Mọi thứ xung quanh mờ đi; chỉ còn lại hai người trong đêm hè.";
"NovelCampPromptSixteen" = "Đây có phải khoảnh khắc đó?";
"NovelCampActionSixteenA" = "Ghé sát vào cho một nụ hôn";
"NovelCampActionSixteenB" = "Thì thầm điều gì đó ngọt ngào";
"NovelCampContentSeventeen" = "Đúng lúc đó, một ngôi sao băng lướt qua bầu trời, để lại vệt sáng bạc. Yuki thốt lên. 'Nhanh lên! Ước một điều đi anh!' cô ấy gọi.";
"NovelCampPromptSeventeen" = "Anh ước điều gì?";
"NovelCampActionSeventeenA" = "Ước cho một tương lai bên nhau";
"NovelCampActionSeventeenB" = "Ước cho đêm nay kéo dài mãi";
"NovelCampContentEighteen" = "Ngôi sao biến mất nhanh chóng. Yuki nhắm chặt mắt. 'Em đã ước một điều đặc biệt,' cô ấy nói, đỏ mặt.";
"NovelCampPromptEighteen" = "Hỏi điều đó là gì?";
"NovelCampActionEighteenA" = "Kể cho anh nghe điều ước của em đi";
"NovelCampActionEighteenB" = "Anh nghĩ anh đoán được nó là gì rồi";
"NovelCampContentNineteen" = "Lửa trại đã tàn hẳn. Hai người bắt đầu đi bộ trở lại, tay trong tay. Khu rừng bây giờ cảm giác khác xưa—ít đáng sợ hơn, kỳ diệu hơn.";
"NovelCampPromptNineteen" = "Đi thong thả?";
"NovelCampActionNineteenA" = "Đi đường vòng dài hơn để trở về";
"NovelCampActionNineteenB" = "Tận hưởng khoảnh khắc yên bình";
"NovelCampContentTwenty" = "Hai người đi qua cây sồi cũ nơi lần đầu gặp nhau. Yuki dừng lại một giây. 'Mọi thứ sắp thay đổi đúng không anh?' cô ấy hỏi khẽ.";
"NovelCampPromptTwenty" = "An ủi cô ấy?";
"NovelCampActionTwentyA" = "Thay đổi có thể là tích cực mà";
"NovelCampActionTwentyB" = "Không phải mọi thứ đều cần phải thay đổi";
"NovelCampContentTwentyOne" = "Các khu nhà trại hiện ra. Những người cắm trại khác đang ngủ. Yuki dừng lại ở cửa phòng mình. Cô ấy do dự không muốn buông tay anh.";
"NovelCampPromptTwentyOne" = "Một điều cuối cùng?";
"NovelCampActionTwentyOneA" = "Xin một nụ hôn tạm biệt";
"NovelCampActionTwentyOneB" = "Xin số điện thoại của cô ấy";
"NovelCampContentTwentyTwo" = "Yuki vương vấn ở cửa. Đèn hiên chiếu ánh sáng ấm áp lên khuôn mặt cô ấy. 'Cảm ơn anh vì đêm nay. Đó là buổi tối tuyệt vời nhất cuộc đời em.'";
"NovelCampPromptTwentyTwo" = "Nói lời tạm biệt?";
"NovelCampActionTwentyTwoA" = "Hẹn gặp em vào buổi sáng";
"NovelCampActionTwentyTwoB" = "Chúc ngủ ngon, Yuki";
"NovelCampContentTwentyThree" = "Bình minh. Trại hè ngập tràn người đang thu dọn hành lý và lên xe být. Anh tìm kiếm Yuki trong đám đông, tim đập nhanh.";
"NovelCampPromptTwentyThree" = "Anh có tìm thấy cô ấy?";
"NovelCampActionTwentyThreeA" = "Tìm kiếm gần xe být";
"NovelCampActionTwentyThreeB" = "Kiểm tra bến tàu lần cuối";
"NovelCampContentTwentyFour" = "Tiếng động cơ xe být đang nổ máy. Anh nhìn thấy cô ấy! Cô ấy đang đứng gần cổng, nhìn quanh lo lắng cho đến khi ánh mắt gặp anh.";
"NovelCampPromptTwentyFour" = "Chạy lại chỗ cô ấy?";
"NovelCampActionTwentyFourA" = "Chạy lại và ôm chầm lấy cô ấy";
"NovelCampActionTwentyFourB" = "Vẫy tay và mỉm cười";
"NovelCampContentTwentyFive" = "Anh đến kịp lúc. Cô ấy thì thầm vào tai anh câu nói mà anh sẽ nhớ mãi. 'Đừng để điều này chỉ là một kỷ niệm mùa hè nhé.'";
"NovelCampPromptTwentyFive" = "Câu trả lời của anh?";
"NovelCampActionTwentyFiveA" = "Đó là một lời hứa";
"NovelCampActionTwentyFiveB" = "Anh sẽ gặp em vào cuối tuần tới";
"NovelCampContentTwentySix" = "Tài xế bấm còi. Yuki phải đi. Cô ấy thổi một nụ hôn khi bước lên xe. Anh đứng đó, nhìn chiếc xe být khuất dần.";
"NovelCampPromptTwentySix" = "Anh cảm thấy thế nào?";
"NovelCampActionTwentySixA" = "Hạnh phúc và đầy hy vọng";
"NovelCampActionTwentySixB" = "Buồn nhưng mãn nguyện";
"NovelCampContentTwentySeven" = "Nhiều tháng sau. Anh đang ở trong thành phố, điện thoại rung lên. Đó là bức ảnh từ Yuki—cô ấy đang đeo chiếc vòng tay hai người đã chia sẻ. Mùa hè chưa bao giờ thực sự kết thúc.";
"NovelCampPromptTwentySeven" = "KẾT THÚC";
"NovelCampActionTwentySevenA" = "Chơi lại câu chuyện";
"NovelCampActionTwentySevenB" = "Thoát";
"NovelCampContentTwentyEight" = "Anh nhìn chiếc vòng tay trên cổ tay mình. Nó đã hơi cũ, nhưng kỷ niệm vẫn vẹn nguyên. Đôi khi, một mùa hè là đủ để kéo dài cả đời.";
"NovelCampPromptTwentyEight" = "KẾT THÚC";
"NovelCampActionTwentyEightA" = "Thử lại";
"NovelCampActionTwentyEightB" = "Thoát";

