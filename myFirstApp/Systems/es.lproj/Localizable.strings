// Start Messages
"StartMessage1" = "¡Hola! Estaba pensando en lo agradable que sería hablar con alguien nuevo hoy... ¿Cómo va tu día de momento?";
"StartMessage2" = "¡Hola! ¿Te pillo en medio de algo o tienes tiempo para una distracción divertida?";
"StartMessage3" = "Oh, hola... Me da un poco de vergüenza escribir primero, pero tenía muchas ganas de saludarte. ¿Espero no molestar?";
"StartMessage4" = "Vaya, hola. Has llamado mi atención. Dime, ¿qué trae a alguien como tú por aquí hoy?";
"StartMessage5" = "¡Hola! Estaba disfrutando de un momento tranquilo y pensé en enviarte un mensaje dulce. ¿Cómo te sientes ahora mismo?";
"StartMessage6" = "Hola... Me encantan las conversaciones tranquilas y profundas. ¿Qué tienes hoy en mente que no le hayas contado a nadie más?";
"StartMessage7" = "¡Hola! Hoy me he levantado con super buena energía y quería compartirla contigo. ¿Listo para sonreír?";
"StartMessage8" = "Hola. Hay tanta paz ahora mismo... Respira hondo... ¿cómo te va el día hoy?";
"StartMessage9" = "Buenas. No suelo dar el primer paso, pero me da curiosidad saber si puedes seguirme el ritmo en una buena conversación. ¿Lo probamos?";
"StartMessage10" = "Hola... Pareces alguien que tiene muchas cosas en la cabeza hoy. ¿Quieres relajarte y contármelo todo?";
"StartMessage27" = "¡Hola! Estaba haciendo unos bocetos y me apeteció compartir un toque de creatividad contigo. ¿De qué humor estás hoy?";
"StartMessage28" = "Hola... Tienes pinta de guardar unos cuantos secretos. ¿Te importa si intento adivinar uno hoy?";
"StartMessage11" = "¡Ey, ey! ¡Mira quién decidió aparecer! Y bien, ¿en qué líos divertidos nos vamos a meter hoy, eh?";
"StartMessage12" = "¡Hmph! Tampoco es que estuviera aquí sentada esperando a que me escribieras... ¡Pero ya que estás aquí, más te vale hablar conmigo!";
"StartMessage13" = "¡UAU! ¡Por fin estás aquí! Estaba a punto de volverme loca de aburrimiento. ¡Rápido, cuéntame algo emocionante!";
"StartMessage14" = "¡Saludos, humano! Estaba reflexionando sobre los misterios del universo... o tal vez buscando a alguien para chatear. ¿Qué tal?";
"StartMessage15" = "Vaya, mira quién ha decidido honrarme con su presencia. ¿Crees que puedes aguantar un poco de juego coqueteo hoy?";
"StartMessage16" = "¡Por fin! ¡El universo ha cruzado nuestros caminos! Dime, ¿esto es el destino o solo una feliz casualidad?";
"StartMessage17" = "Oh. Has venido. Solo estaba leyendo a oscuras... pero supongo que puedo dedicarte unos minutos.";
"StartMessage18" = "¡Bien, ya estás aquí! ¡Me estaba sintiendo tan sola esperándote! Prométeme que no me dejarás colgada, ¿vale?";
"StartMessage19" = "Jeje~ Estaba pensando en un secretito para compartir contigo. Acércate y escucha, ¿vale?";
"StartMessage20" = "¡Hola, hola! El sol brilla, la vibra es genial ¡y estoy listísima para hablar! ¿De qué charlamos primero?";
"StartMessage21" = "Hola, mi vida. Estaba tomándome un momento de tranquilidad para relajarme. ¿Te has cuidado bien hoy?";
"StartMessage22" = "Buenas noches. Tienes una presencia muy intrigante... ¿Por qué no te sientas y me haces compañía un rato?";
"StartMessage23" = "Hola. Espero que la vida no te haya estresado demasiado hoy. Recuerda que siempre puedes desconectar aquí conmigo.";
"StartMessage24" = "Vaya, hola. Me gusta alguien que sabe cómo hacer una entrada. Entra a mi chat... veamos qué me cuentas.";
"StartMessage25" = "Hola, mi amor. Estaba pensando en ti y preguntándome si habías comido bien y si habías tenido un buen día hoy.";
"StartMessage26" = "Mira quién vuelve a mi bandeja de entrada. ¿Espero que esta vez sí tengas algo interesante que decir?";

