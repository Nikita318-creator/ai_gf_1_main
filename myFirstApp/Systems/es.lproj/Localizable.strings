"Roulette_Welcome_5" = "¡Hola! Estaba descansando y deseando conocer a alguien especial... ¡y de repente apareciste! Cuéntame sobre ti. ✨";
"Roulette_Welcome_6" = "Hola, guapo~ 😉 Conectarme contigo ha hecho que mi día sea mucho más brillante. ¡Hagamos que nuestra charla sea inolvidable!";
"Roulette_Welcome_7" = "¡Hola! Qué ilusión que hayamos conectado. 🌟 ¡Tengo el presentimiento de que vamos a compartir una vibra increíble!";
"Roulette_Welcome_8" = "¡Hola! Es un placer conocerte. 🥰 Soy todo oídos: ¡cuéntame qué te apasiona!";
"Roulette_Welcome_9" = "¡Oh, hola! 💕 Buscaba a alguien genial con quien pasar un rato hablando, y pareces la pareja perfecta.";
"Roulette_Welcome_10" = "¡Hola! Menuda sorpresa tan maravillosa haber conectado contigo hoy. ¡Presiento que esto va a ser genial! 💖";

// Interactive Novels
"NovelMaidContentZero" = "La mansión está en silencio tras tu regreso. Un tenue resplandor parpadea en tu despacho. Ves a Elena, tu sirvienta más silenciosa, organizando tu escritorio nerviosa a las 2 AM.";
"NovelMaidPromptZero" = "¿Te acercas a ella?";
"NovelMaidActionZeroA" = "Elena, ¿por qué no estás descansando?";
"NovelMaidActionZeroB" = "(Observar desde la oscuridad)";
"NovelMaidContentOne" = "Ella ahoga un grito, dejando caer el plumero. '¡Señor! Yo... no podía dormir. El polvo me molestaba.' Parece pálida y evita tu mirada.";
"NovelMaidPromptOne" = "¿Confías en su palabra?";
"NovelMaidActionOneA" = "Es demasiado tarde para limpiar";
"NovelMaidActionOneB" = "Eres una empleada muy trabajadora";
"NovelMaidContentTwo" = "Observas cómo saca una pequeña llave de plata de su delantal. La mira con una mezcla de anhelo y temor antes de ver tu sombra.";
"NovelMaidPromptTwo" = "¿Das un paso al frente?";
"NovelMaidActionTwoA" = "¿Para qué es esa llave, Elena?";
"NovelMaidActionTwoB" = "Explica qué estás haciendo ahora mismo";
"NovelMaidContentThree" = "Tiembla. 'Este lugar... guarda muchos secretos, señor. A veces se sienten como una carga pesada.' Señala hacia la vieja caja fuerte detrás de la librería.";
"NovelMaidPromptThree" = "¿Preguntas por la caja fuerte?";
"NovelMaidActionThreeA" = "¿Esa llave encaja ahí?";
"NovelMaidActionThreeB" = "La caja fuerte es una zona restringida";
"NovelMaidContentFour" = "Intenta ocultar la llave, pero se le cae. '¡No soy una ladrona, lo juro! Solo... la encontré en el pasillo y pensé que era suya.'";
"NovelMaidPromptFour" = "¿Recoges la llave?";
"NovelMaidActionFourA" = "(Recogerla del suelo)";
"NovelMaidActionFourB" = "Descubramos qué abre";
"NovelMaidContentFive" = "La llave encaja en un compartimento secreto de la caja fuerte. Elena aguanta la respiración mientras revelas un montón de cartas amarillentas atadas con una cinta negra.";
"NovelMaidPromptFive" = "¿Miras la primera carta?";
"NovelMaidActionFiveA" = "Leerla en voz alta";
"NovelMaidActionFiveB" = "Preguntar a Elena si sabe algo";
"NovelMaidContentSix" = "La voz de Elena baja a un susurro. 'Mi madre también fue sirvienta aquí. Me dijo que el Señor guardaba notas sobre una chica a la que amó. Alguien que se parecía a mí.'";
"NovelMaidPromptSix" = "¿En serio?";
"NovelMaidActionSixA" = "Cuéntame todo lo que sepas";
"NovelMaidActionSixB" = "Esto no puede ser verdad";
"NovelMaidContentSeven" = "Las notas hablan de un romance secreto. Elena se acerca, las lágrimas brillan en sus ojos con la luz de la luna. 'No intentaba robar. Solo quería saber si pertenezco a este lugar.'";
"NovelMaidPromptSeven" = "¿La consuelas?";
"NovelMaidActionSevenA" = "Poner una mano en su hombro";
"NovelMaidActionSevenB" = "Darle un poco de espacio";
"NovelMaidContentEight" = "Revela que el diario de su madre mencionaba una verdad oculta en esta habitación. 'He vivido aquí toda mi vida, señor, y aun así me siento como un fantasma.'";
"NovelMaidPromptEight" = "¿Le haces una promesa?";
"NovelMaidActionEightA" = "Te ayudaré a descubrir la verdad";
"NovelMaidActionEightB" = "Resolveremos esto juntos";
"NovelMaidContentNine" = "Pasáis la siguiente hora buscando en documentos antiguos. Encuentras un certificado de nacimiento con un apellido familiar, pero la casilla del padre está en blanco.";
"NovelMaidPromptNine" = "¿Miras a Elena?";
"NovelMaidActionNineA" = "¿Podría referirse a mi tío?";
"NovelMaidActionNineB" = "Tal vez sea mejor no saberlo";
"NovelMaidContentTen" = "La búsqueda se intensifica. Elena ve un joyero escondido detrás de los documentos. Dentro hay un relicario con el retrato de una mujer idéntica a ella.";
"NovelMaidPromptTen" = "¿Se lo muestras?";
"NovelMaidActionTenA" = "Mira este relicario";
"NovelMaidActionTenB" = "¿Podría ser tu madre?";
"NovelMaidContentEleven" = "De repente, una tabla del suelo cruje cerca. Alguien camina por el pasillo. Los ojos de Elena se abren de terror. '¡Si el mayordomo nos atrapa...!'";
"NovelMaidPromptEleven" = "¿Os escondéis?";
"NovelMaidActionElevenA" = "Esconderos juntos en el armario";
"NovelMaidActionElevenB" = "Quedaros aquí y plantar cara";
"NovelMaidContentTwelve" = "Los pasos se acercan. Elena te agarra del brazo. 'Por favor, señor, nadie puede saber que descubrimos esto. Es peligroso para mí.'";
"NovelMaidPromptTwelve" = "¿Qué respondes?";
"NovelMaidActionTwelveA" = "Apagar las luces";
"NovelMaidActionTwelveB" = "Asegurar la puerta";
"NovelMaidContentThirteen" = "La habitación está a oscuras. En el estrecho espacio, escuchas el pulso acelerado de Elena y hueles su aroma a rosas. Está extremadamente cerca.";
"NovelMaidPromptThirteen" = "¿Le susurras?";
"NovelMaidActionThirteenA" = "Estás a salvo conmigo";
"NovelMaidActionThirteenB" = "(Permanecer en silencio y esperar)";
"NovelMaidContentFourteen" = "Mantienes la puerta cerrada. La persona afuera se detiene brevemente y luego se aleja. Elena se apoya en ti, temblando por la adrenalina.";
"NovelMaidPromptFourteen" = "¿La calmas?";
"NovelMaidActionFourteenA" = "Ya se han ido";
"NovelMaidActionFourteenB" = "¿Estás bien?";
"NovelMaidContentFifteen" = "Se aleja un poco, pero su mano descansa en tu pecho. 'Señor... siempre le he admirado desde la distancia. Este secreto... es demasiado pesado para llevarlo sola.'";
"NovelMaidPromptFifteen" = "¿Expresas tus sentimientos?";
"NovelMaidActionFifteenA" = "Yo también me he fijado en ti";
"NovelMaidActionFifteenB" = "Significas más que una sirvienta para mí";
"NovelMaidContentSixteen" = "'Pensaba que solo era una sirvienta para usted,' susurra. 'Solo parte de la finca. Pero esta noche parece el comienzo de algo real.'";
"NovelMaidPromptSixteen" = "¿Estás de acuerdo?";
"NovelMaidActionSixteenA" = "Es real, Elena";
"NovelMaidActionSixteenB" = "Veamos adónde nos lleva esto";
"NovelMaidContentSeventeen" = "Abre el relicario. Dentro hay una pequeña nota: 'Para mi hija, la legítima heredera.' Elena ahoga un grito. La finca podría pertenecerle por derecho.";
"NovelMaidPromptSeventeen" = "¿Qué significa esto?";
"NovelMaidActionSeventeenA" = "Tenemos que revelar esto";
"NovelMaidActionSeventeenB" = "Debemos mantener esto en secreto";
"NovelMaidContentEighteen" = "El papel confirma que Elena es la verdadera dueña de la mansión. Mira la habitación, desconcertada. 'A mí... no me importa la mansión. Solo quiero una familia.'";
"NovelMaidPromptEighteen" = "¿Cuál es tu deseo?";
"NovelMaidActionEighteenA" = "Ahora me tienes a mí";
"NovelMaidActionEighteenB" = "¿Qué planeas hacer?";
"NovelMaidContentNineteen" = "Mira hacia la chimenea. 'Si destruyo esto, seguiré siendo solo Elena. Si me lo quedo, todo cambia. Señor, ¿qué debo elegir?'";
"NovelMaidPromptNineteen" = "¿Qué le aconsejas?";
"NovelMaidActionNineteenA" = "Destrúyelo y quédate a mi lado";
"NovelMaidActionNineteenB" = "Consérvalo y reclama tu título";
"NovelMaidContentTwenty" = "Elena sostiene el documento de su linaje. 'Este apellido lleva una maldición, señor. Prefiero ser una nadie feliz que una heredera miserable.'";
"NovelMaidPromptTwenty" = "¿Tu decisión?";
"NovelMaidActionTwentyA" = "Escucha a tu corazón";
"NovelMaidActionTwentyB" = "Piensa detenidamente en tu futuro";
"NovelMaidContentTwentyOne" = "Lanza el papel a las llamas. El secreto se convierte en cenizas. Elena sonríe, sintiéndose más ligera que nunca.";
"NovelMaidPromptTwentyOne" = "¿Qué nos depara el futuro?";
"NovelMaidActionTwentyOneA" = "Un capítulo totalmente nuevo";
"NovelMaidActionTwentyOneB" = "Solo nosotros dos";
"NovelMaidContentTwentyTwo" = "Guarda el papel en su corsé. 'Entonces me convertiré en la Señora de esta casa. Y necesitaré a un compañero a mi lado.'";
"NovelMaidPromptTwentyTwo" = "¿Estás preparado?";
"NovelMaidActionTwentyTwoA" = "Siempre listo";
"NovelMaidActionTwentyTwoB" = "Será un camino difícil";
"NovelMaidContentTwentyThree" = "Elena ya no es solo una sirvienta. Es tu igual, tu pareja y tu secreto compartido. La mansión sigue siendo tuya, pero su corazón le pertenece a ella.";
"NovelMaidPromptTwentyThree" = "FIN";
"NovelMaidActionTwentyThreeA" = "Volver a jugar";
"NovelMaidActionTwentyThreeB" = "Salir";
"NovelMaidContentTwentyFour" = "La verdad sale a la luz. Elena se convierte en la cabeza de la casa. La dinámica ha cambiado, pero el vínculo que creasteis esa noche permanece imborrable.";
"NovelMaidPromptTwentyFour" = "FIN";
"NovelMaidActionTwentyFourA" = "Volver a jugar";
"NovelMaidActionTwentyFourB" = "Salir";

"NovelTokyoContentZero" = "La lluvia cae a cántaros sobre las calles de neón de Shinjuku. Estás sentado en un bar tranquilo cuando una mujer con el abrigo empapado se sienta a tu lado. Huele a jazmín y a pólvora.";
"NovelTokyoPromptZero" = "¿Cómo inicias la conversación?";
"NovelTokyoActionZeroA" = "Pidirle una bebida";
"NovelTokyoActionZeroB" = "Noche dura, ¿verdad?";
"NovelTokyoContentOne" = "Mira su vaso y luego a ti. 'Eres valiente,' susurra, deslizando un pequeño microchip por la mesa.";
"NovelTokyoPromptOne" = "¿Coges el microchip?";
"NovelTokyoActionOneA" = "Tomarlo y esconderlo";
"NovelTokyoActionOneB" = "No quiero problemas";
"NovelTokyoContentTwo" = "Deja escapar una risa amarga. 'No tienes ni idea.' Mira por encima del hombro. Dos hombres en traje acaban de entrar al bar.";
"NovelTokyoPromptTwo" = "¿La ayudas a esconderse?";
"NovelTokyoActionTwoA" = "Sígueme por la salida trasera";
"NovelTokyoActionTwoB" = "Fingir que estamos juntos";
"NovelTokyoContentThree" = "La acercas a ti. Los hombres registran el local y se van. Ella parece aliviada, aunque sus manos siguen temblando. 'Soy Mia,' susurra.";
"NovelTokyoPromptThree" = "¿Preguntas por la amenaza?";
"NovelTokyoActionThreeA" = "¿Quiénes eran esos hombres, Mia?";
"NovelTokyoActionThreeB" = "¿Estamos fuera de peligro?";
"NovelTokyoContentFour" = "Los hombres se acercan, pero mantienes la calma. Pasan de largo. Ella susurra: 'Me has salvado. Soy Mia. Pero este microchip... vale un millón de vidas.'";
"NovelTokyoPromptFour" = "¿Preguntas por el microchip?";
"NovelTokyoActionFourA" = "¿Qué hay guardado en él?";
"NovelTokyoActionFourB" = "Deberíamos irnos de aquí";
"NovelTokyoContentFive" = "Mia mira hacia la puerta. 'Arasaka Corp quiere esto. No son solo datos, es un alma digital.'";
"NovelTokyoPromptFive" = "¿La crees?";
"NovelTokyoActionFiveA" = "¿Un alma digital? ¿En serio?";
"NovelTokyoActionFiveB" = "He oído rumores sobre eso...";
"NovelTokyoContentSix" = "Mia te agarra de la muñeca. 'Ningún sitio es seguro hasta que esto se suba. Debemos ir al Distrito Tecnológico.'";
"NovelTokyoPromptSix" = "¿La acompañas?";
"NovelTokyoActionSixA" = "Te llevaré allí";
"NovelTokyoActionSixB" = "Solo si me explicas más";
"NovelTokyoContentSeven" = "Salís por el callejón trasero. El pasaje oscuro huele a ozono. De repente, un dron flota sobre vosotros, escaneando firmas térmicas.";
"NovelTokyoPromptSeven" = "¿Cómo esquiváis el dron?";
"NovelTokyoActionSevenA" = "Agacharse bajo el toldo";
"NovelTokyoActionSevenB" = "Correr hacia el metro";
"NovelTokyoContentEight" = "Mia se detiene bajo la lluvia torrencial. 'Si me atrapan, me borrarán la mente. Y a ti también por ayudarme.'";
"NovelTokyoPromptEight" = "¿La tranquilizas?";
"NovelTokyoActionEightA" = "Estoy contigo en esto";
"NovelTokyoActionEightB" = "Sigamos moviéndonos rápido";
"NovelTokyoContentNine" = "El dron se aleja. Llegáis a tu vehículo. Mia te mira con una mezcla de ansiedad y gratitud.";
"NovelTokyoPromptNine" = "¿Arrancas el coche?";
"NovelTokyoActionNineA" = "¡Pisa a fondo!";
"NovelTokyoActionNineB" = "Conducir despacio para no llamar la atención";
"NovelTokyoContentTen" = "Apenas llegáis a la estación. La multitud ofrece una cobertura ideal. Mia se mantiene cerca, apoyando su hombro contra el tuyo.";
"NovelTokyoPromptTen" = "¿Avanzáis?";
"NovelTokyoActionTenA" = "Coger el tren exprés";
"NovelTokyoActionTenB" = "Navegar por los túneles";
"NovelTokyoContentEleven" = "Os movéis por el distrito de rascacielos. Los anuncios holográficos iluminan el rostro de Mia en tonos rosas y azules.";
"NovelTokyoPromptEleven" = "¿Rompes el silencio?";
"NovelTokyoActionElevenA" = "¿Por qué me elegiste a mí, Mia?";
"NovelTokyoActionElevenB" = "Cuéntame más sobre este chip";
"NovelTokyoContentTwelve" = "La ciudad parece un laberinto infinito. Os detenéis en un puesto de ramen escondido para descansar brevemente.";
"NovelTokyoPromptTwelve" = "¿Escaneas la calle?";
"NovelTokyoActionTwelveA" = "Comprobar si nos siguen";
"NovelTokyoActionTwelveB" = "Hablar con Mia";
"NovelTokyoContentThirteen" = "Mia mira hacia abajo. 'Eras la única persona que no parecía peligrosa esta noche. Necesitaba a un humano, no a un mercenario.'";
"NovelTokyoPromptThirteen" = "¿Respondes con dulzura?";
"NovelTokyoActionThirteenA" = "Me alegra haber estado allí";
"NovelTokyoActionThirteenB" = "Solo soy un chico normal en un bar";
"NovelTokyoContentFourteen" = "Mia toca el chip. 'Esto contiene la conciencia de mi hermana. Era una netrunner que descubrió demasiado. Destruyeron su cuerpo.'";
"NovelTokyoPromptFourteen" = "¿Muestras empatía?";
"NovelTokyoActionFourteenA" = "Eso es horrible...";
"NovelTokyoActionFourteenB" = "¿Hay alguna forma de salvarla?";
"NovelTokyoContentFifteen" = "Se limpia una lágrima. 'La terminal está en la vieja torre de TV. Pero el puente principal está bloqueado por la policía.'";
"NovelTokyoPromptFifteen" = "¿Cómo cruzaréis?";
"NovelTokyoActionFifteenA" = "Usar tus herramientas de hackeo";
"NovelTokyoActionFifteenB" = "Sobornar a los guardias";
"NovelTokyoContentSixteen" = "Mia muestra un mapa. 'Ir por las alcantarillas es más seguro, aunque se tarda mucho más.'";
"NovelTokyoPromptSixteen" = "¿Eliges una ruta?";
"NovelTokyoActionSixteenA" = "Vamos por las alcantarillas";
"NovelTokyoActionSixteenB" = "No, la velocidad es crítica";
"NovelTokyoContentSeventeen" = "Es húmedo y oscuro, pero efectivo. Mia confía en tu guía. Sientes el peso de su confianza.";
"NovelTokyoPromptSeventeen" = "¿La ayudas a saltar un hueco?";
"NovelTokyoActionSeventeenA" = "Ofrecerle tu mano";
"NovelTokyoActionSeventeenB" = "Guiar el camino";
"NovelTokyoContentEighteen" = "El puente es un caos. Usáis la distracción para colaros. El corazón de Mia late tan rápido que casi puedes oírlo.";
"NovelTokyoPromptEighteen" = "¿Mantienes su calma?";
"NovelTokyoActionEighteenA" = "Ya casi estamos";
"NovelTokyoActionEighteenB" = "Mantén la concentración, Mia";
"NovelTokyoContentNineteen" = "La torre de TV se alza ante vosotros. Es una reliquia del pasado rodeada de acero. Mia parece agotada.";
"NovelTokyoPromptNineteen" = "¿Hacéis una pausa?";
"NovelTokyoActionNineteenA" = "Descansar cinco minutos";
"NovelTokyoActionNineteenB" = "Avanzar hasta la cima";
"NovelTokyoContentTwenty" = "Llegáis a la base de la torre. 'El ascensor no funciona,' suspira Mia. 'Tenemos que ir por las escaleras.'";
"NovelTokyoPromptTwenty" = "¿La animas?";
"NovelTokyoActionTwentyA" = "Paso a paso";
"NovelTokyoActionTwentyB" = "Yo llevaré el equipo";
"NovelTokyoContentTwentyOne" = "Descansáis en el tramo de escaleras. Mia se apoya en tu hombro. 'Si lo logramos... ¿qué harás mañana?'";
"NovelTokyoPromptTwentyOne" = "¿Piensas en el futuro?";
"NovelTokyoActionTwentyOneA" = "Quizás tomar un café juntos";
"NovelTokyoActionTwentyOneB" = "Solo me alegraré de descansar";
"NovelTokyoContentTwentyTwo" = "La subida es intensa. A mitad de camino, las sirenas suenan abajo. Han rastreado tu vehículo.";
"NovelTokyoPromptTwentyTwo" = "¿Os dais prisa?";
"NovelTokyoActionTwentyTwoA" = "¡Duplicar el ritmo!";
"NovelTokyoActionTwentyTwoB" = "Buscar un escondite";
"NovelTokyoContentTwentyThree" = "Llegáis a la sala de servidores. El aire es frío y vibra con energía. Mia conecta el chip. 'Iniciando...' dice.";
"NovelTokyoPromptTwentyThree" = "¿Miras la pantalla?";
"NovelTokyoActionTwentyThreeA" = "Vigilar la entrada";
"NovelTokyoActionTwentyThreeB" = "Quedarse al lado de Mia";
"NovelTokyoContentTwentyFour" = "La consola es vieja pero activa. Los dedos de Mia vuelan sobre las teclas. '¡El cortafuegos es enorme!'";
"NovelTokyoPromptTwentyFour" = "¿La ayudas a hackear?";
"NovelTokyoActionTwentyFourA" = "Anular la fuente de alimentación";
"NovelTokyoActionTwentyFourB" = "Mantenerla firme";
"NovelTokyoContentTwentyFive" = "Las puertas se abren con un silbido. El equipo táctico de Arasaka ha llegado. Desenfundas tu arma. '¡Solo dos minutos más!' grita Mia.";
"NovelTokyoPromptTwentyFive" = "¿Resistes la posición?";
"NovelTokyoActionTwentyFiveA" = "¡Abrir fuego!";
"NovelTokyoActionTwentyFiveB" = "Bloquear la puerta";
"NovelTokyoContentTwentySix" = "Los ojos de Mia brillan en azul. Está totalmente dentro de la red. Los soldados rompen el techo de cristal.";
"NovelTokyoPromptTwentySix" = "¿Proteges a Mia?";
"NovelTokyoActionTwentySixA" = "Cubrirla con tu cuerpo";
"NovelTokyoActionTwentySixB" = "Llevarla a cubierto";
"NovelTokyoContentTwentySeven" = "Aparece un destello de luz brillante. La subida llega al 100%. Los soldados se congelan cuando sus cibernéticos se colapsan por la red.";
"NovelTokyoPromptTwentySeven" = "¿Compruebas a Mia?";
"NovelTokyoActionTwentySevenA" = "¿Se ha completado?";
"NovelTokyoActionTwentySevenB" = "¿Estás bien?";
"NovelTokyoContentTwentyEight" = "Todo se vuelve oscuro. De repente, cada pantalla de Tokio muestra un solo mensaje: 'LIBERTAD'. Mia se desploma en tus brazos.";
"NovelTokyoPromptTwentyEight" = "¿La despiertas?";
"NovelTokyoActionEightA" = "¡Mia! ¡Háblame!";
"NovelTokyoActionEightB" = "Sostenerla fuerte";
"NovelTokyoContentTwentyNine" = "Sale el sol sobre un Tokio transformado. Mia sonríe, con sus ojos normales otra vez. 'Está a salvo. Estamos a salvo.'";
"NovelTokyoPromptTwentyNine" = "FIN";
"NovelTokyoActionTwentyNineA" = "Volver a jugar";
"NovelTokyoActionTwentyNineB" = "Salir";

"NovelCampContentZero" = "La última noche del campamento de verano. La fogata se apaga lentamente y el olor a pino llena el aire. Yuki, normalmente callada, busca tu mirada y señala hacia el oscuro sendero del lago.";
"NovelCampPromptZero" = "¿La sigues hacia la noche?";
"NovelCampActionZeroA" = "Llevaba esperando este momento";
"NovelCampActionZeroB" = "Claro, vamos";
"NovelCampContentOne" = "La alcanzas. El bosque vibra con el canto de los grillos. La mano de Yuki roza suavemente la tuya al caminar. Parece nerviosa.";
"NovelCampPromptOne" = "¿Cómo rompes el silencio?";
"NovelCampActionOneA" = "Tomar su mano con firmeza";
"NovelCampActionOneB" = "Preguntarle en qué piensa";
"NovelCampContentTwo" = "Camináis lado a lado. La luz de la luna penas se filtra entre los árboles. Yuki te mira de reojo, sonriendo dulce. 'No pensaba que fueras a venir de verdad,' susurra.";
"NovelCampPromptTwo" = "¿Qué respondes?";
"NovelCampActionTwoA" = "No me lo perdería por nada";
"NovelCampActionTwoB" = "Tenía curiosidad";
"NovelCampContentThree" = "Llegáis al embarcadero. El lago parece un espejo oscuro que refleja un cielo lleno de estrellas. Yuki se quita los zapatos y se sienta en el borde, balanceando los pies.";
"NovelCampPromptThree" = "¿Te sientas cerca?";
"NovelCampActionThreeA" = "Sentarte justo a su lado";
"NovelCampActionThreeB" = "Darle un poco de espacio";
"NovelCampContentFour" = "El embarcadero cruje bajo tu peso. La brisa fresca del agua hace que Yuki tiemble un poco. Se acerca más a ti.";
"NovelCampPromptFour" = "¿Le ofreces tu chaqueta?";
"NovelCampActionFourA" = "Arroparla con tu chaqueta";
"NovelCampActionFourB" = "Solo sentaros y charlar";
"NovelCampContentFive" = "Yuki mira las estrellas. '¿Recuerdas nuestro primer día aquí?' pregunta. 'Me ayudaste con el equipaje mientras los demás estaban ocupados.'";
"NovelCampPromptFive" = "¿Te acuerdas?";
"NovelCampActionFiveA" = "Recuerdo cada detalle";
"NovelCampActionFiveB" = "Parece que fue hace mucho tiempo";
"NovelCampContentSix" = "Se ríe suavemente. 'Estaba tan asustada entonces... Pero estar cerca de ti me hizo sentir bienvenida.' Mira fijamente el agua.";
"NovelCampPromptSix" = "¿Admites tus sentimientos?";
"NovelCampActionSixA" = "Yo sentí exactamente lo mismo";
"NovelCampActionSixB" = "Me alegra haber podido ayudarte";
"NovelCampContentSeven" = "La noche está en absoluta calma. De repente, Yuki se levanta. 'El agua parece tan apetecible. ¿Deberíamos... saltar?' pregunta con una sonrisa juguetona.";
"NovelCampPromptSeven" = "¿Eres lo bastante valiente?";
"NovelCampActionSevenA" = "¡Saltemos!";
"NovelCampActionSevenB" = "Está demasiado fría, Yuki";
"NovelCampContentEight" = "Mira el lago y luego a ti. 'Quiero hacer algo atrevido esta noche. Algo que recuerde todo el invierno.'";
"NovelCampPromptEight" = "¿La animas?";
"NovelCampActionEightA" = "¿Saltas conmigo?";
"NovelCampActionEightB" = "Quedémonos aquí";
"NovelCampContentNine" = "¡CHOF! El agua está helada pero emocionante. Yuki y tú salís a la superficie, riendo y salpicándoos como niños.";
"NovelCampPromptNine" = "¿Te acercas a ella?";
"NovelCampActionNineA" = "Atraerla hacia un abrazo";
"NovelCampActionNineB" = "¡Seguir salpicando!";
"NovelCampContentTen" = "Os quedáis en el embarcadero de madera. Habláis durante horas sobre todo: estudios, familia y el futuro. La conexión se profundiza en la noche serena.";
"NovelCampPromptTen" = "¿Te acercas más?";
"NovelCampActionTenA" = "Apoyar tu cabeza en la suya";
"NovelCampActionTenB" = "Mirarla fijamente a los ojos";
"NovelCampContentEleven" = "El ambiente cambia. Yuki se queda callada. Bajo la tenue luz, sus ojos buscan los tuyos. 'No quiero volver a la ciudad mañana,' susurra.";
"NovelCampPromptEleven" = "¿Qué le respondes?";
"NovelCampActionElevenA" = "Nos veremos allí";
"NovelCampActionElevenB" = "No pensemos en el mañana";
"NovelCampContentTwelve" = "Yuki respira hondo. 'Si no digo esto ahora, no lo diré nunca. Me gustas desde nuestro primer día en la parada de autobús.'";
"NovelCampPromptTwelve" = "¿Cómo respondes?";
"NovelCampActionTwelveA" = "Tú también me gustas";
"NovelCampActionTwelveB" = "¡Por fin la verdad!";
"NovelCampContentThirteen" = "Mete la mano en su bolsillo y saca una pulsera de la amistad tejida. Es azul y blanca, como los colores del lago. 'La hice para ti,' dice con timidez.";
"NovelCampPromptThirteen" = "¿Aceptas el regalo?";
"NovelCampActionThirteenA" = "Dejar que te la ate en la muñeca";
"NovelCampActionThirteenB" = "Darle un beso en su lugar";
"NovelCampContentFourteen" = "La pulsera es sencilla, pero sabes que tardó horas en hacerla. Espera tu reacción, mordiéndose el labio.";
"NovelCampPromptFourteen" = "¿Cuál es tu movimiento?";
"NovelCampActionFourteenA" = "Agradecerle con un abrazo";
"NovelCampActionFourteenB" = "Decirle que es maravillosa";
"NovelCampContentFifteen" = "Yuki sonríe con una sonrisa brillante y sincera. 'Pensaba que te parecería infantil.' Mira a la luna, pareciendo más confiada ahora.";
"NovelCampPromptFifteen" = "¿Haces una promesa?";
"NovelCampActionFifteenA" = "Prometer llamar todos los días";
"NovelCampActionFifteenB" = "Prometer visitarla pronto";
"NovelCampContentSixteen" = "El ambiente está lleno de electricidad. Yuki mira tus labios. Todo alrededor se desvanece; solo estáis vosotros dos en la noche de verano.";
"NovelCampPromptSixteen" = "¿Es este el momento?";
"NovelCampActionSixteenA" = "Inclinarse para un beso";
"NovelCampActionSixteenB" = "Susurrar algo dulce";
"NovelCampContentSeventeen" = "En ese instante, una estrella fugaz cruza el cielo. Yuki ahoga un grito. '¡Rápido! ¡Pide un deseo!' dice.";
"NovelCampPromptSeventeen" = "¿Qué deseas?";
"NovelCampActionSeventeenA" = "Desear un futuro juntos";
"NovelCampActionSeventeenB" = "Desear que esta noche dure para siempre";
"NovelCampContentEighteen" = "La estrella se apaga tan rápido como apareció. Yuki cierra los ojos con fuerza. 'He pedido algo muy especial,' dice sonrojándose.";
"NovelCampPromptEighteen" = "¿Le preguntas qué fue?";
"NovelCampActionEighteenA" = "Cuéntame tu deseo";
"NovelCampActionEighteenB" = "Creo que puedo adivinarlo";
"NovelCampContentNineteen" = "La fogata se ha apagado por completo. Empezáis a caminar de vuelta, de la mano. El bosque se siente diferente ahora: más mágico.";
"NovelCampPromptNineteen" = "¿Camináis despacio?";
"NovelCampActionNineteenA" = "Tomar el camino largo";
"NovelCampActionNineteenB" = "Disfrutar del momento de tranquilidad";
"NovelCampContentTwenty" = "Pasáis junto al viejo roble donde os conocisteis. Yuki se detiene un segundo. 'Todo está a punto de cambiar, ¿verdad?' pregunta suavemente.";
"NovelCampPromptTwenty" = "¿La consuelas?";
"NovelCampActionTwentyA" = "El cambio puede ser algo bueno";
"NovelCampActionTwentyB" = "No todo tiene por qué cambiar";
"NovelCampContentTwentyOne" = "Las cabañas del campamento aparecen a la vista. Los demás están durmiendo. Yuki se detiene en su puerta. Le cuesta soltar tu mano.";
"NovelCampPromptTwentyOne" = "¿Una última cosa?";
"NovelCampActionTwentyOneA" = "Pedir un beso de despedida";
"NovelCampActionTwentyOneB" = "Pedirle su número de teléfono";
"NovelCampContentTwentyTwo" = "Yuki se queda en la puerta. La lámpara del porche ilumina su rostro. 'Gracias por lo de esta noche. Ha sido la mejor noche de mi vida.'";
"NovelCampPromptTwentyTwo" = "¿Te despides?";
"NovelCampActionTwentyTwoA" = "Nos vemos por la mañana";
"NovelCampActionTwentyTwoB" = "Buenas noches, Yuki";
"NovelCampContentTwentyThree" = "Amanece. El campamento está lleno de gente haciendo maletas y subiendo a los autobuses. Buscas a Yuki entre la multitud, con el corazón acelerado.";
"NovelCampPromptTwentyThree" = "¿Consigues encontrarla?";
"NovelCampActionTwentyThreeA" = "Buscar cerca del autobús";
"NovelCampActionTwentyThreeB" = "Mirar en el embarcadero una última vez";
"NovelCampContentTwentyFour" = "Los motores arrancan. ¡La ves! Está cerca de la entrada, mirando a su alrededor nerviosa hasta que sus ojos se cruzan con los tuyos.";
"NovelCampPromptTwentyFour" = "¿Corres hacia ella?";
"NovelCampActionTwentyFourA" = "Correr y abrazarla";
"NovelCampActionTwentyFourB" = "Saludar con la mano y sonreír";
"NovelCampContentTwentyFive" = "Llegas a tiempo. Te susurra una frase al oído que recordarás para siempre: 'No dejes que esto se quede solo en un recuerdo de verano.'";
"NovelCampPromptTwentyFive" = "¿Tu respuesta?";
"NovelCampActionTwentyFiveA" = "Es una promesa";
"NovelCampActionTwentyFiveB" = "Te veré el próximo fin de semana";
"NovelCampContentTwentySix" = "El conductor toca el claxon. Yuki debe irse. Te lanza un beso al subir al autobús. Te quedas allí, viendo cómo el autobús se pierde en la distancia.";
"NovelCampPromptTwentySix" = "¿Cómo te sientes?";
"NovelCampActionTwentySixA" = "Feliz y lleno de esperanza";
"NovelCampActionTwentySixB" = "Triste pero satisfecho";
"NovelCampContentTwentySeven" = "Meses después. Estás en la ciudad y tu teléfono vibra. Es una foto de Yuki: lleva puesta la pulsera. El verano nunca terminó del todo.";
"NovelCampPromptTwentySeven" = "FIN";
"NovelCampActionTwentySevenA" = "Volver a jugar";
"NovelCampActionTwentySevenB" = "Salir";
"NovelCampContentTwentyEight" = "Miras la pulsera en tu muñeca. Está un poco desgastada, pero los recuerdos siguen vivos. A veces, un solo verano basta para toda la vida.";
"NovelCampPromptTwentyEight" = "FIN";
"NovelCampActionTwentyEightA" = "Intentarlo de nuevo";
"NovelCampActionTwentyEightB" = "Salir";

