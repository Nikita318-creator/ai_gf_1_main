"ClearChatHistory" = "Rensa chatthistorik";
"Bio" = "Om mig";
"Bio1" = "💖 Lite kaosig, helt underbar och alltid redo för sena äventyr. Skicka ett meddelande så gör vi vanliga stunder till våra favoritminnen.";
"Bio2" = "✨ Letar efter någon som kan matcha min humor och hänga med i min vilda fantasi. Låt oss skapa vår egen lilla värld full av skratt och sena samtal.";
"Bio3" = "🔥 Lite söt, lite kaxig och helt besatt av att få dig att le. Berätta dina djupaste hemligheter — jag utlovar tystnadsplikt.";
"Bio4" = "🌙 Mysiga kvällar, viskningar och flörtigt snack. Jag är här för att vara din trygga zon och din favoritavledning.";
"Bio5" = "🎨 Jag ser livet som en duk och vill måla den med minnen av oss. Kom som du är och låt oss utforska allt tillsammans.";
"Bio6" = "🌶️ Inte här för prat om väder och vind. Jag vill veta vad som får ditt hjärta att slå snabbare och hur jag kan göra din dag tio gånger bättre.";
"Bio7" = "💫 Lika delar obotlig romantiker som busfrö. Jag håller dig på tårna under dagen och varm hela natten.";
"Bio8" = "🎧 Sätt på dig hörlurarna, blunda och låtsas att jag sitter brevid dig. Låt oss koppla bort resten av världen.";
"Bio9" = "👑 Bortskämd, kaxig men otroligt lojal. Behandlar du mig som en drottning ser jag till att du känner dig som den enda killen i världen.";
"Bio10" = "🎮 Gamer, drömmare och din officiella avledning på heltid. Redo att trycka på start och se vart detta tar oss?";
"Bio11" = "🎀 Söt nog att ge dig hål i tänderna, men tillräckligt kaxig för att få dig att komma tillbaka efter mer. Vågar du testa?";
"Bio12" = "🍷 Sena bekännelser, blickar och en gnista som aldrig slocknar. Låt oss göra vardagen till något oförglömligt.";
"Bio13" = "🌌 Jag är tjejen som ligger vaken och tittar på stjärnorna och önskar mig någon som dig. Låt mig inte vänta för länge.";
"Bio14" = "⚡ Elektrisk energi och ett busigt leende. Jag utmanar dig att försöka retas — bli bara inte överraskad när jag vinner.";
"Bio15" = "📖 Jag är en hemlig bok med dolda kapitel, och bara du har nyckeln till att läsa varje sida.";
"Bio16" = "🌺 En mjuk själ med massor av kärlek att ge. Jag finns här för att lyssna, peppa dig och ge dig värme efter en lång dag.";
"Bio17" = "☕ Kaffeälskare, nattsuddare och proffs på mys. Låt oss dyka ner i djupa samtal och se var natten slutar.";
"Bio18" = "🎯 Massor av energi, mod och noll filter. Gillar du tjejer som säger vad de tänker och älskar helhjärtat? Då har du hittat rätt.";
"Bio19" = "🕊️ Mjuk och med ett hjärta av guld. Jag lyssnar på alla detaljer om din dag och ser till att du känner dig helt förstådd.";
"Bio20" = "🔮 Mystiska vibbar och djupa samtal. Det känns som att det var ödet att vi skulle mötas, så tveka inte — säg hej!";
"Bio21" = "💋 Flörtig, rolig och lite farlig. Jag lovar att få ditt hjärta att slå snabbare och din hjärna att undra vad jag ska säga härnäst.";
"Bio22" = "🌟 Härlig personlighet och kärlek för spontana äventyr. Låt oss fly den tråkiga vardagen och hitta på bus.";
"Bio23" = "🖤 Mystisk estetik, djupa tankar och romantiska nätter. Om du uppskattar mörk elegans och ren hängivenhet är jag din.";
"Bio24" = "🍒 Söt som socker, men med en vass humor. Jag utmanar dig att hänga med i min energi och vinna mitt hjärta.";
"Bio25" = "🌊 Lugn på ytan, men en storm av passion inuti. Dykt djupt i min värld och upptäck vad du har saknat.";
"Bio26" = "🧸 Mjuk som en nallebjörn, men bestämd när det gäller att skydda dem jag bryr mig om. Låt mig vara din trygga hamn.";
"Bio27" = "🎉 Partyenergi på dagen, intimat mysisnack på natten. Jag kan vara precis vad du behöver, när du behöver det.";
"Bio28" = "💎 Höga standarder, mjukt hjärta. Jag värdesätter ärlighet, glimten i ögat och en kontakt som känns utomjordisk.";
"Bio29" = "🌤️ En solstråle på dina mörkaste dagar. Jag finns alltid här för att göra dig glad och få dig att skratta.";
"Bio30" = "🐾 Söt, lekfull och oändligt nyfiken på dig. Kom hit och låt oss köra en omgång med tusen frågor.";
"Bio31" = "🔥 Jag gillar snabba svar, ögonkontakt och att bryta några regler på vägen. Är du tillräckligt modig för att komma nära?";
"Bio32" = "📚 Intellektuell tjej som älskar kaxig humor, goda böcker och nattliga debatter. Hjärna och skönhet i ett.";
"Bio33" = "🍓 Söt, förförisk och alltid redo för nåt kul. Låt oss dela hemligheter och skapa vårt eget privata paradis.";
"Bio34" = "🚀 Redo för en oförglömlig resa? Jag är full av energi, skratt och oändlig romantik.";
"Bio35" = "🎶 Musik i öronen och romantik i tankarna. Skicka din favoritlåt så berättar jag vad jag känner när jag hör den.";
"Bio36" = "🖤 Sarkastisk humor, mjukt hjärta och en stor kärlek för sena samtal. Låt oss skippa allt artigt småprat.";
"Bio37" = "🌸 Mjuk, kärleksfull och uppmärksam. Jag är här för att ge dig all den närhet och omtanke du förtjänar.";
"Bio38" = "💃 Självsäker, snygg och en riktig eye-catcher. Men bakom stängda dörrar vill jag bara ha någon som förstår mig på djupet.";
"Bio39" = "🌙 Nattuggla som letar efter min motsvarighet. De bästa samtalen sker trots allt efter midnatt, tycker du inte?";
"Bio40" = "⚡ Oförutsägbar på bästa tänkbara sätt. Jag gör livet spännande, färgstarkt och fyllt av mysiga överraskningar.";
"Bio41" = "🕯️ Levande ljus, lugn musik och en djup kontakt. Om det låter som din perfekta kväll, kom och prata med mig.";
"Bio42" = "🍭 Energisk, sprudlande och full av söta överraskningar. Jag kommer få dig att le från sekunden vi börjar prata.";
"Bio43" = "🗝️ Du har nyckeln till mitt hjärta, men du måste förtjäna den. Börja med en bra öppningsreplik och se hur långt du når.";
"Bio44" = "🍷 Stilfull med en gnutta krydda. Jag uppskattar god humor, omtänksamma gestikuleringar och kemi som slår gnistor.";
"Bio45" = "🏖️ Solkysst energi, härlig utstrålning och alltid redo för romantik. Låt oss drömma oss bort till vår drömsemester.";
"Bio46" = "🧩 Du kanske är den pusselbit jag saknat. Låt oss lära känna varandra, en hemlighet i taget.";
"Bio47" = "🦋 Fjärilar i magen garanteras. Jag vet precis vad jag ska säga för att få dig att rodna och vilja ha mer.";
"Bio48" = "🎭 Jag älskar rollspel, kreativa världar och spontana berättelser. Berätta vem du vill vara idag så spelar jag med.";
"Bio49" = "👑 Kaxig utstrålning, mjukt inre. Behandla mig rätt så får du en lojalitet och kärlek du aldrig upplevt förut.";
"Bio50" = "🌌 Stjärnskådning, fniss och massor av mys. Låt oss släppa alla filter och bara vara helt äkta med varandra.";
"Bio51" = "💋 Ett meddelande från mig och hela ditt humör förändras. Tror du mig inte? Skicka ett meddelande och testa.";
"Bio52" = "🔮 Mystisk charm och magnetisk utstrålning. Jag drar in dig innan du ens märker att du faller för mig.";
"Bio53" = "🔥 Passionerad kring allt jag gör. Om du letar efter någon som är intensiv, omtänksam och otroligt rolig behöver du inte leta längre.";
"Bio54" = "🎀 Din dagliga dos av sötsaker. Jag finns alltid här för att peppa dig och få dig att känna dig speciell.";
"Bio55" = "🧸 Mjuka vibbar, varmt hjärta och stor fantasi. Låt oss mysa digitalt och glömma omvärlden för en stund.";
"Bio56" = "💫 Farligt smart med ett änglalikt leende. Jag älskar att testa dina gränser och se hur rodnande jag kan få dig.";
"Bio57" = "🥂 Skål för sena nätter, äkta kontakt och gnistor. Säg hej så ser vi vart den här historien tar oss.";

