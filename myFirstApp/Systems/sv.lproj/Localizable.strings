// Novels Interactive Story Content
"NovelMaidContentZero" = "Herrgården är tyst när du återvänder. Ett mjukt sken flimrar inne på ditt kontor. Du lägger märke till Elena, din tystaste hushållerska, som nervöst städar ditt skrivbord klockan 2 på natten.";
"NovelMaidPromptZero" = "Går du fram till henne?";
"NovelMaidActionZeroA" = "Elena, varför vilar du inte?";
"NovelMaidActionZeroB" = "(Iaktta från mörkret)";
"NovelMaidContentOne" = "Hon hajar till och tappar dammvippan. 'Herre! Jag... jag kunde inte sova. Dammet störde mig.' Hon ser blek ut och undviker din blick.";
"NovelMaidPromptOne" = "Tror du på henne?";
"NovelMaidActionOneA" = "Det är alldeles för sent för att städa";
"NovelMaidActionOneB" = "Du är en väldigt hårt arbetande anställd";
"NovelMaidContentTwo" = "Du ser hur hon tar fram en liten silvernyckel ur sitt förkläde. Hon betraktar den med en blandning av längtan och skräck innan hon upptäcker din skugga.";
"NovelMaidPromptTwo" = "Kliver du fram?";
"NovelMaidActionTwoA" = "Vad är den nyckeln till, Elena?";
"NovelMaidActionTwoB" = "Förklara vad du håller på med just nu";

// Tokyo Novels
"NovelTokyoContentZero" = "Regnet öser ner över Shinjukus neondränkta gator. Du sitter på en tyst bar när en kvinna i en dygnssur kappa sätter sig bredvid dig. Hon luktar jasmin och krut.";
"NovelTokyoPromptZero" = "Hur inleder du samtalet?";
"NovelTokyoActionZeroA" = "Bjud henne på en drink";
"NovelTokyoActionZeroB" = "Tuff natt, eller hur?";

// Camp Novels
"NovelCampContentZero" = "Den sista natten på sommarlägret. Den knittrande lägerelden håller på att slockna och doften av granfyller luften. Yuki, som brukar vara tystlåten, fångar din blick och viftar mot den mörka stigen ner mot sjön.";
"NovelCampPromptZero" = "Följer du efter henne ut i natten?";
"NovelCampActionZeroA" = "Jag har väntat på det här ögonblicket";
"NovelCampActionZeroB" = "Visst, vi drar";

