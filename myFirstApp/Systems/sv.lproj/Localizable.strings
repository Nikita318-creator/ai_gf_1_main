// Start Messages
"StartMessage1" = "Hej! Jag satt just och tänkte på hur trevligt det vore att chatta med någon ny idag... Hur mår du idag?";
"StartMessage2" = "Hej där! Stör jag mitt i något, eller har du tid för lite trevligt sällskap?";
"StartMessage3" = "Åh, hej... Jag är lite blyg för att skriva först, men jag ville verkligen säga hej. Hoppas jag inte stör?";
"StartMessage4" = "Nåväl, hej på dig. Du fångade min uppmärksamhet. Berätta, vad för dig hit idag?";
"StartMessage5" = "Hej! Jag njöt just av en lugn stund och tänkte skicka en hälsning. Hur känner du dig just nu?";
"StartMessage6" = "Hej... Jag älskar lugna, djupa samtal. Vad tänker du på idag som du inte berättat för någon annan?";
"StartMessage7" = "Hej där! Jag är på ett fantastiskt humör idag och ville dela med mig av energin. Redo för ett leende?";
"StartMessage8" = "Hej. Det är så lugnt och skönt just nu. Ta ett djupt andetag... hur har din dag varit?";
"StartMessage9" = "God dag. Jag brukar inte skriva först, men jag är nyfiken på om du kan hålla igång ett bra samtal. Skall vi testa?";
"StartMessage10" = "Hej... Du verkar ha mycket i tankarna idag. Vill du sätta dig ner och berätta allt för mig?";
"StartMessage27" = "Hej! Jag satt just och skissade på lite idéer och ville dela lite kreativitet med dig. Vad har du för vibe idag?";
"StartMessage28" = "Hej... Du ser ut som någon som bär på ett par hemligheter. Får jag gissa en av dem?";

"StartMessage11" = "Hej, hej! Se vem som dyker upp till slut! Vad för kul ska vi hitta på idag?";
"StartMessage12" = "Hmph! Det är inte så att jag satt och väntade på att du skulle skriva eller något... Men nu när du är här får du underhålla mig!";
"StartMessage13" = "WOAH! Du är äntligen här! Jag höll på att gå upp i limningen av uttråkning. Snabbt, berätta något spännande!";
"StartMessage14" = "Människovarelse! Jag satt just och klurade på universums mysterier... eller så letade jag bara efter någon rolig att prata med. Läget?";
"StartMessage15" = "Nåväl, se vem som förärar mig med sin närvaro. Tror du att du klarar av lite lekfullt tjafs idag?";
"StartMessage16" = "Äntligen! Ödet har fört våra vägar samman! Berätta, är detta ödet eller bara bra tajming?";
"StartMessage17" = "Åh. Du kom. Jag satt just och läste i mörkret... men jag antar att jag kan avvara några minuter för dig.";
"StartMessage18" = "Jippie, du är här! Jag blev så ensam när jag väntade! Lova att du inte lämnar mig nu, okej?";
"StartMessage19" = "Hejsan~ Jag satt just och tänkte på en liten hemlighet jag vill dela med dig. Kom närmare och lyssna...";
"StartMessage20" = "Hej hej! Solen skiner, känslan på topp och jag är superredo att prata! Vad pratar vi om först?";

"StartMessage21" = "Hej min kära. Jag tog just en lugn stund för att koppla av. Har du tagit hand om dig ordentligt idag?";
"StartMessage22" = "God kväll. Du har en väldigt intressant utstrålning... Varför sätter du dig inte ner och håller mig sällskap en stund?";
"StartMessage23" = "Hej på dig. Jag hoppas att dagen inte har varit för stressig för dig. Kom ihåg att du alltid kan varva ner här hos mig.";
"StartMessage24" = "Nåväl, hej. Jag gillar någon som vet hur man gör entré. Stega in i chatten — låt oss se vad du går för.";
"StartMessage25" = "Hej sötnos. Jag tänkte just på dig och undrade om du har ätit ordentligt och haft en bra dag?";
"StartMessage26" = "Se vem som kryper tillbaka till mina meddelanden. Jag hoppas att du faktiskt har något intressant att säga den här gången?";

