// Interactive Novels Text (Maid, Tokyo, Camp)
"NovelMaidContentZero" = "La residenza è silenziosa al tuo ritorno. Una fioca luce brilla nel tuo ufficio. Noti Elena, la tua cameriera più riservata, riordinare la tua scrivania alle 2 di notte.";
"NovelMaidPromptZero" = "Ti avvicini a lei?";
"NovelMaidActionZeroA" = "Elena, perché non stai riposando?";
"NovelMaidActionZeroB" = "(Osserva dall'ombra)";
"NovelMaidContentOne" = "Lei sussulta, facendo quasi cadere il piumino. 'Signore! Io... non riuscivo a dormire. La polvere mi dava fastidio.' È pallida ed evita il tuo sguardo.";
"NovelMaidPromptOne" = "Ti fidi delle sue parole?";
"NovelMaidActionOneA" = "È troppo tardi per pulire";
"NovelMaidActionOneB" = "Sei una lavoratrice instancabile";
"NovelMaidContentTwo" = "La osservi mentre estrae una piccola chiave d'argento dal grembiule. La fissa con desiderio e timore prima di notare la tua ombra.";
"NovelMaidPromptTwo" = "Ti fai avanti?";
"NovelMaidActionTwoA" = "A cosa serve quella chiave, Elena?";
"NovelMaidActionTwoB" = "Spiegami cosa stai facendo";
"NovelMaidContentThree" = "Lei trema. 'Questo posto... custodisce tanti segreti, signore. A volte sembrano un peso insopportabile.' Indica la vecchia cassaforte dietro la libreria.";
"NovelMaidPromptThree" = "Chiedi della cassaforte?";
"NovelMaidActionThreeA" = "Quella chiave apre la cassaforte?";
"NovelMaidActionThreeB" = "La cassaforte è un'area riservata";
"NovelMaidContentFour" = "Cerca di nascondere la chiave, ma le cade. 'Non sono una ladra, lo giuro! L'ho solo... trovata nel corridoio e pensavo fosse vostra.'";
"NovelMaidPromptFour" = "Raccogli la chiave?";
"NovelMaidActionFourA" = "(Raccoglila da terra)";
"NovelMaidActionFourB" = "Scopriamo cosa apre";
"NovelMaidContentFive" = "La chiave apre uno scomparto segreto nella cassaforte. Elena trattiene il respiro mentre estrai una pila di lettere ingiallite legate con un nastro nero.";
"NovelMaidPromptFive" = "Leggi la prima lettera?";
"NovelMaidActionFiveA" = "Leggila ad alta voce";
"NovelMaidActionFiveB" = "Chiedi ad Elena se sa qualcosa";
"NovelMaidContentSix" = "La voce di Elena si fa un soffio. 'Anche mia madre era una cameriera qui. Mi disse che il Padrone teneva appunti su una ragazza che amava. Qualcuno che mi somigliava.'";
"NovelMaidPromptSix" = "Davvero?";
"NovelMaidActionSixA" = "Dimmi tutto quello che sai";
"NovelMaidActionSixB" = "Questo non può essere vero";
"NovelMaidContentSeven" = "Le lettere parlano di una storia d'amore segreta. Elena si avvicina, la luce della luna brilla sulle sue lacrime. 'Non volevo rubare. Volevo solo capire se questo è il mio posto.'";
"NovelMaidPromptSeven" = "La consoli?";
"NovelMaidActionSevenA" = "Metti una mano sulla sua spalla";
"NovelMaidActionSevenB" = "Lascale un po' di spazio";
"NovelMaidContentEight" = "Rivela che il diario di sua madre menzionava una verità nascosta in questa stanza. 'Ho vissuto qui tutta la vita, signore, eppure mi sento come un fantasma.'";
"NovelMaidPromptEight" = "Le fai una promessa?";
"NovelMaidActionEightA" = "Ti aiuterò a scoprire la verità";
"NovelMaidActionEightB" = "Risolveremo la cosa insieme";
"NovelMaidContentNine" = "Passate l'ora successiva a cercare tra vecchi documenti. Trovate un certificato di nascita con un cognome familiare, ma la sezione del padre è vuota.";
"NovelMaidPromptNine" = "Guardi Elena?";
"NovelMaidActionNineA" = "Potrebbe riferirsi a mio zio?";
"NovelMaidActionNineB" = "Forse è meglio non sapere";
"NovelMaidContentTen" = "La ricerca si fa intensa. Elena nota un portagioie nascosto. Dentro c'è un medaglione con il ritratto di una donna identica a lei.";
"NovelMaidPromptTen" = "Glielo mostri?";
"NovelMaidActionTenA" = "Guarda questo medaglione";
"NovelMaidActionTenB" = "Potrebbe essere tua madre?";
"NovelMaidContentEleven" = "All'improvviso, un pavimento scricchiola nelle vicinanze. Qualcuno sta camminando nel corridoio. Gli occhi di Elena si spalancano dal terrore. 'Se il maggiordomo ci scopre...!'";
"NovelMaidPromptEleven" = "Vi nascondete?";
"NovelMaidActionElevenA" = "Nascondiamoci nell'armadio insieme";
"NovelMaidActionElevenB" = "Restiamo qui e affrontiamolo";
"NovelMaidContentTwelve" = "I passi si avvicinano. Elena ti stringe il braccio. 'Per favore, signore, nessuno deve sapere. È pericoloso per me.'";
"NovelMaidPromptTwelve" = "La tua risposta?";
"NovelMaidActionTwelveA" = "Spegni le luci";
"NovelMaidActionTwelveB" = "Blocca la porta";
"NovelMaidContentThirteen" = "La stanza è nel buio pesto. Nello spazio stretto, senti il battito accelerato di Elena e il suo profumo di rose. È vicinissima a te.";
"NovelMaidPromptThirteen" = "Sussurri?";
"NovelMaidActionThirteenA" = "Sei al sicuro con me";
"NovelMaidActionThirteenB" = "(Rimani in silenzio ad aspettare)";
"NovelMaidContentFourteen" = "Tieni la porta chiusa. La persona all'esterno si ferma un attimo, poi si allontana. Elena si appoggia a te, tremando per l'adrenalina.";
"NovelMaidPromptFourteen" = "La calmi?";
"NovelMaidActionFourteenA" = "Se ne sono andati";
"NovelMaidActionFourteenB" = "Stai bene?";
"NovelMaidContentFifteen" = "Si allontana leggermente, ma la sua mano resta sul tuo petto. 'Signore... vi ho sempre ammirato da lontano. Questo segreto... è troppo pesante da portare da sola.'";
"NovelMaidPromptFifteen" = "Esprimi i tuoi sentimenti?";
"NovelMaidActionFifteenA" = "Ho notato anche io la tua presenza";
"NovelMaidActionFifteenB" = "Conti molto più di una cameriera per me";
"NovelMaidContentSixteen" = "'Pensavo di essere solo una serva per voi,' sussurra. 'Solo parte della villa. Ma stasera sembra l'inizio di qualcosa di reale.'";
"NovelMaidPromptSixteen" = "Sei d'accordo con lei?";
"NovelMaidActionSixteenA" = "È reale, Elena";
"NovelMaidActionSixteenB" = "Vediamo dove ci porta";
"NovelMaidContentSeventeen" = "Apre il medaglione. All'interno c'è un bigliettino: 'A mia figlia, la legittima erede.' Elena sussulta. La tenuta potrebbe appartenere a lei.";
"NovelMaidPromptSeventeen" = "Cosa significa?";
"NovelMaidActionSeventeenA" = "Dobbiamo rivelarlo";
"NovelMaidActionSeventeenB" = "Dobbiamo mantenerlo segreto";
"NovelMaidContentEighteen" = "Il documento conferma che Elena è la vera proprietaria. Guarda la stanza smarrita. 'Non mi importa della villa. Voglio solo una famiglia.'";
"NovelMaidPromptEighteen" = "Qual è il tuo desiderio?";
"NovelMaidActionEighteenA" = "Ora hai me";
"NovelMaidActionEighteenB" = "Cosa hai intenzione di fare?";
"NovelMaidContentNineteen" = "Guarda verso il camino. 'Se distruggo questo, resto solo Elena. Se lo tengo, tutto cambia. Signore, cosa dovrei scegliere?'";
"NovelMaidPromptNineteen" = "La consigli?";
"NovelMaidActionNineteenA" = "Distruggilo e resta al mio fianco";
"NovelMaidActionNineteenB" = "Tienilo e prendi il tuo titolo";
"NovelMaidContentTwenty" = "Elena tiene in mano il documento. 'Questo cognome porta una maledizione. Preferisco essere una persona qualunque felice piuttosto che un'erede infelice.'";
"NovelMaidPromptTwenty" = "La tua decisione?";
"NovelMaidActionTwentyA" = "Ascolta il tuo cuore";
"NovelMaidActionTwentyB" = "Valuta attentamente il tuo futuro";
"NovelMaidContentTwentyOne" = "Getta il documento tra le fiamme. Il segreto diventa cenere. Elena sorride, con un'aria più leggera che mai.";
"NovelMaidPromptTwentyOne" = "Cosa ci riserva il futuro?";
"NovelMaidActionTwentyOneA" = "Un nuovo capitolo";
"NovelMaidActionTwentyOneB" = "Solo noi due";
"NovelMaidContentTwentyTwo" = "Mette il documento nel bustino. 'Allora diventerò la Signora di questa casa. E avrò bisogno di un partner al mio fianco.'";
"NovelMaidPromptTwentyTwo" = "Sei pronto?";
"NovelMaidActionTwentyTwoA" = "Sempre pronto";
"NovelMaidActionTwentyTwoB" = "Sarà un viaggio impegnativo";
"NovelMaidContentTwentyThree" = "Elena non è più solo una cameriera. È la tua pari, la tua compagna e il tuo segreto. La villa resta tua, ma il suo cuore appartiene a lei.";
"NovelMaidPromptTwentyThree" = "FINE";
"NovelMaidActionTwentyThreeA" = "Rigioca Storia";
"NovelMaidActionTwentyThreeB" = "Esci";
"NovelMaidContentTwentyFour" = "La verità è svelata. Elena diventa la padrona di casa. La dinamica è cambiata, ma il legame creato quella notte resta indissolubile.";
"NovelMaidPromptTwentyFour" = "FINE";
"NovelMaidActionTwentyFourA" = "Rigioca Storia";
"NovelMaidActionTwentyFourB" = "Esci";

"NovelTokyoContentZero" = "La pioggia cade sulle luci al neon di Shinjuku. Sei seduto in un bar tranquillo quando una donna con un cappotto bagnato si siede accanto a te. Profuma di gelsomino e polvere da sparo.";
"NovelTokyoPromptZero" = "Come inizi la conversazione?";
"NovelTokyoActionZeroA" = "Offrile da bere";
"NovelTokyoActionZeroB" = "Giornataccia, vero?";
"NovelTokyoContentOne" = "Guarda il suo bicchiere, poi te. 'Sei coraggioso,' sussurra, facendo scivolare un piccolo microchip sul tavolo.";
"NovelTokyoPromptOne" = "Prendi il microchip?";
"NovelTokyoActionOneA" = "Prendilo e nascondilo";
"NovelTokyoActionOneB" = "Non voglio problemi";
"NovelTokyoContentTwo" = "Lascia andare una risata amara. 'Non ne hai idea.' Si guarda alle spalle. Due uomini in abito scuro sono appena entrati nel locale.";
"NovelTokyoPromptTwo" = "La aiuti a nascondersi?";
"NovelTokyoActionTwoA" = "Seguimi dall'uscita sul retro";
"NovelTokyoActionTwoB" = "Fingiamo di stare insieme";
"NovelTokyoContentThree" = "La tiri vicino a te. Gli uomini perquisiscono il locale ed escono. Sembra sollevata, anche se le sue mani tremano ancora. 'Sono Mia,' sussurra.";
"NovelTokyoPromptThree" = "Chiedi della minaccia?";
"NovelTokyoActionThreeA" = "Chi erano quegli uomini, Mia?";
"NovelTokyoActionThreeB" = "Siamo fuori pericolo?";
"NovelTokyoContentFour" = "Gli uomini si avvicinano, ma tu mantieni la calma. Passano oltre. Lei sussurra: 'Mi hai salvata. Sono Mia. Ma questo microchip... vale un milione di vite.'";
"NovelTokyoPromptFour" = "Chiedi del microchip?";
"NovelTokyoActionFourA" = "Cosa c'è salvato sopra?";
"NovelTokyoActionFourB" = "Dovremmo andarcene da qui";
"NovelTokyoContentFive" = "Mia guarda verso l'ingresso. 'La Arasaka Corp vuole questo. Non sono solo dati, è un'anima digitale.'";
"NovelTokyoPromptFive" = "Le credi?";
"NovelTokyoActionFiveA" = "Un'anima digitale? Sul serio?";
"NovelTokyoActionFiveB" = "Ho sentito delle voci al riguardo...";
"NovelTokyoContentSix" = "Mia ti afferra il polso. 'Nessun posto è sicuro finché non lo carichiamo sul server. Dobbiamo andare al Distretto Tech.'";
"NovelTokyoPromptSix" = "L'accompagni?";
"NovelTokyoActionSixA" = "Ti ci porterò io";
"NovelTokyoActionSixB" = "Solo se mi spieghi di più";
"NovelTokyoContentSeven" = "Uscite dal vicolo posteriore. Il passaggio scuro puzza di ozono. All'improvviso, un drone sorvola la zona alla ricerca di segnali termici.";
"NovelTokyoPromptSeven" = "Come evitate il drone?";
"NovelTokyoActionSevenA" = "Nasconditi sotto la tenda";
"NovelTokyoActionSevenB" = "Corri verso la metropolitana";
"NovelTokyoContentEight" = "Mia si ferma sotto la pioggia battente. 'Se mi prendono, mi cancelleranno la mente. E anche la tua, per avermi aiutato.'";
"NovelTokyoPromptEight" = "La rassicuri?";
"NovelTokyoActionEightA" = "Sono con te in questo";
"NovelTokyoActionEightB" = "Muoviamoci velocemente";
"NovelTokyoContentNine" = "Il drone vola via. Raggiungete l'auto. Mia ti guarda con un misto di ansia e gratitudine.";
"NovelTokyoPromptNine" = "Accendi l'auto?";
"NovelTokyoActionNineA" = "Schiaccia l'acceleratore!";
"NovelTokyoActionNineB" = "Guida con calma per non dare nell'occhio";
"NovelTokyoContentTen" = "Riuscite a stento ad arrivare alla stazione. La folla enorme offre una copertura ideale. Mia ti sta vicina, sfiorandoti le spalle.";
"NovelTokyoPromptTen" = "Continuate?";
"NovelTokyoActionTenA" = "Prendi il treno espresso";
"NovelTokyoActionTenB" = "Muoviti attraverso i tunnel";
"NovelTokyoContentEleven" = "Vi muovete nel quartiere dei grattacieli. Gli annunci olografici illuminano il viso di Mia di rosa e blu.";
"NovelTokyoPromptEleven" = "Rompi il silenzio?";
"NovelTokyoActionElevenA" = "Perché hai scelto me, Mia?";
"NovelTokyoActionElevenB" = "Parlami di questo chip";
"NovelTokyoContentTwelve" = "La città sembra un labirinto infinito. Vi fermate in un chiosco di ramen nascosto per riposare un attimo.";
"NovelTokyoPromptTwelve" = "Controlli la strada?";
"NovelTokyoActionTwelveA" = "Controlla se ci seguono";
"NovelTokyoActionTwelveB" = "Parla con Mia";
"NovelTokyoContentThirteen" = "Mia abbassa lo sguardo. 'Eri l'unica persona che non sembrava pericolosa stasera. Avevo bisogno di un essere umano, non di un mercenario.'";
"NovelTokyoPromptThirteen" = "Rispondi dolcemente?";
"NovelTokyoActionThirteenA" = "Sono contento di essere stato lì";
"NovelTokyoActionThirteenB" = "Sono solo un tipo normale al bar";
"NovelTokyoContentFourteen" = "Mia tocca il chip. 'Questo contiene la coscienza di mia sorella. Era una netrunner che ha scoperto troppo. Hanno distrutto il suo corpo.'";
"NovelTokyoPromptFourteen" = "Mostri empatia?";
"NovelTokyoActionFourteenA" = "È terribile...";
"NovelTokyoActionFourteenB" = "C'è un modo per salvarla?";
"NovelTokyoContentFifteen" = "Asciuga una lacrima. 'Il terminale è alla vecchia torre TV. Ma il ponte principale è bloccato dalla polizia.'";
"NovelTokyoPromptFifteen" = "Come attraversate?";
"NovelTokyoActionFifteenA" = "Usa i tuoi strumenti da hacker";
"NovelTokyoActionFifteenB" = "Paga le guardie";
"NovelTokyoContentSixteen" = "Mia mostra una mappa. 'La strada delle fognature è più sicura, anche se richiede molto più tempo.'";
"NovelTokyoPromptSixteen" = "Scegli un percorso?";
"NovelTokyoActionSixteenA" = "Andiamo nelle fognature";
"NovelTokyoActionSixteenB" = "No, la velocità è fondamentale";
"NovelTokyoContentSeventeen" = "È umido e buio, ma efficace. Mia si affida alla tua guida. Senti il peso della sua fiducia.";
"NovelTokyoPromptSeventeen" = "La aiuti a superare un ostacolo?";
"NovelTokyoActionSeventeenA" = "Offrile la mano";
"NovelTokyoActionSeventeenB" = "Guida la strada avanti";
"NovelTokyoContentEighteen" = "Il ponte è nel caos. Usate la distrazione per passare. Il cuore di Mia batte così forte che puoi quasi sentirlo.";
"NovelTokyoPromptEighteen" = "La mantieni calma?";
"NovelTokyoActionEighteenA" = "Siamo quasi arrivati";
"NovelTokyoActionEighteenB" = "Rimani concentrata, Mia";
"NovelTokyoContentNineteen" = "La torre TV si erge davanti a voi. È un relitto del passato circondato dall'acciaio. Mia sembra esausta.";
"NovelTokyoPromptNineteen" = "Fate una pausa?";
"NovelTokyoActionNineteenA" = "Riposati cinque minuti";
"NovelTokyoActionNineteenB" = "Spingi fino in cima";
"NovelTokyoContentTwenty" = "Arrivate alla base della torre. 'L'ascensore non funziona,' sospira Mia. 'Dobbiamo fare le scale.'";
"NovelTokyoPromptTwenty" = "La incoraggi?";
"NovelTokyoActionTwentyA" = "Un passo alla volta";
"NovelTokyoActionTwentyB" = "Porterò io l'attrezzatura";
"NovelTokyoContentTwentyOne" = "Vi riposate sulla scalinata. Mia si appoggia alla tua spalla. 'Se ci riusciamo... cosa farai domani?'";
"NovelTokyoPromptTwentyOne" = "Pensi al futuro?";
"NovelTokyoActionTwentyOneA" = "Forse possiamo prenderci un caffè";
"NovelTokyoActionTwentyOneB" = "Sarò solo sollevato di riposare";
"NovelTokyoContentTwentyTwo" = "La salita è intensa. A metà strada, le sirene suonano in basso. Hanno rintracciato l'auto.";
"NovelTokyoPromptTwentyTwo" = "Accelerate?";
"NovelTokyoActionTwentyTwoA" = "Raddoppiamo il passo!";
"NovelTokyoActionTwentyTwoB" = "Trova un nascondiglio";
"NovelTokyoContentTwentyThree" = "Raggiungete la stanza dei server. L'aria è fredda e ronza di energia. Mia inserisce il chip. 'Inizializzazione...' dice.";
"NovelTokyoPromptTwentyThree" = "Guardi lo schermo?";
"NovelTokyoActionTwentyThreeA" = "Sorveglia l'ingresso";
"NovelTokyoActionTwentyThreeB" = "Rimani accanto a Mia";
"NovelTokyoContentTwentyFour" = "La console è vecchia ma attiva. Le dita di Mia volano sulla tastiera. 'Il firewall è enorme!'";
"NovelTokyoPromptTwentyFour" = "La aiuti nell'hacking?";
"NovelTokyoActionTwentyFourA" = "Escludi l'alimentazione";
"NovelTokyoActionTwentyFourB" = "Tienila salda";
"NovelTokyoContentTwentyFive" = "Le porte si aprono. La squadra tattica della Arasaka è arrivata. Estrai la tua arma. 'Solo altri due minuti!' grida Mia.";
"NovelTokyoPromptTwentyFive" = "Mantenete la posizione?";
"NovelTokyoActionTwentyFiveA" = "Apri il fuoco!";
"NovelTokyoActionTwentyFiveB" = "Blocca la porta";
"NovelTokyoContentTwentySix" = "Gli occhi di Mia brillano di blu. È completamente dentro la rete. I soldati sfondano il tetto di vetro.";
"NovelTokyoPromptTwentySix" = "Proteggi Mia?";
"NovelTokyoActionTwentySixA" = "Falle da scudo con il tuo corpo";
"NovelTokyoActionTwentySixB" = "Tirala al riparo";
"NovelTokyoContentTwentySeven" = "Appare un intenso bagliore di luce. Il caricamento raggiunge il 100%. I soldati si bloccano mentre le loro componenti cibernetiche vanno in corto.";
"NovelTokyoPromptTwentySeven" = "Controlli Mia?";
"NovelTokyoActionTwentySevenA" = "È completo?";
"NovelTokyoActionTwentySevenB" = "Stai bene?";
"NovelTokyoContentTwentyEight" = "Tutto diventa buio. All'improvviso, ogni schermo di Tokyo mostra un solo messaggio: 'LIBERTÀ'. Mia crolla tra le tue braccia.";
"NovelTokyoPromptTwentyEight" = "La svegli?";
"NovelTokyoActionEightA" = "Mia! Parlami!";
"NovelTokyoActionEightB" = "Stringila forte";
"NovelTokyoContentTwentyNine" = "Il sole sorge su una Tokyo trasformata. Mia sorride, con gli occhi tornati normali. 'È al sicuro. Siamo al sicuro.'";
"NovelTokyoPromptTwentyNine" = "FINE";
"NovelTokyoActionTwentyNineA" = "Rigioca Storia";
"NovelTokyoActionTwentyNineB" = "Esci";

"NovelCampContentZero" = "L'ultima notte del campo estivo. Il falò si sta spegnendo e l'odore di pino riempie l'aria. Yuki, di solito silenziosa, incrocia il tuo sguardo e fa cenno verso il sentiero scuro del lago.";
"NovelCampPromptZero" = "La segui nella notte?";
"NovelCampActionZeroA" = "Aspettavo questo momento";
"NovelCampActionZeroB" = "Certo, andiamo";
"NovelCampContentOne" = "La raggiungi. La foresta risuona del canto dei grilli. La mano di Yuki sfiora la tua mentre camminate. Sembra emozionata.";
"NovelCampPromptOne" = "Come rompi il silenzio?";
"NovelCampActionOneA" = "Stringi la sua mano con decisione";
"NovelCampActionOneB" = "Chiedile a cosa sta pensando";
"NovelCampContentTwo" = "Camminate fianco a fianco. La luce della luna penetra a stento tra gli alberi. Yuki ti guarda di traverso, sorridendo dolcemente. 'Non pensavo che saresti venuto davvero,' sussurra.";
"NovelCampPromptTwo" = "Come rispondi?";
"NovelCampActionTwoA" = "Non me lo sarei perso per nulla al mondo";
"NovelCampActionTwoB" = "Ero curioso";
"NovelCampContentThree" = "Raggiungete il molo. Il lago sembra uno specchio scuro che riflette un cielo pieno di stelle. Yuki si toglie le scarpe e si siede sul bordo, dondolando i piedi.";
"NovelCampPromptThree" = "Ti siedi vicino a lei?";
"NovelCampActionThreeA" = "Siediti proprio accanto a lei";
"NovelCampActionThreeB" = "Lasciale un po' di spazio";
"NovelCampContentFour" = "Il molo scricchiola sotto il vostro peso. La brezza fresca dell'acqua fa tremare leggermente Yuki. Rimane vicina mentre ti avvicini.";
"NovelCampPromptFour" = "Le offri la tua giacca?";
"NovelCampActionFourA" = "Avvolgi la tua giacca intorno a lei";
"NovelCampActionFourB" = "Siediti e chiacchiera";
"NovelCampContentFive" = "Yuki guarda le stelle. 'Ti ricordi il nostro primo giorno qui?' chiede. 'Mi hai aiutato con i bagagli mentre tutti gli altri erano occupati.'";
"NovelCampPromptFive" = "Ti ricordi?";
"NovelCampActionFiveA" = "Ricordo ogni dettaglio";
"NovelCampActionFiveB" = "Sembra passato tantissimo tempo";
"NovelCampContentSix" = "Ride dolcemente. 'Ero così spaventata allora. Ma stare vicino a te mi ha fatto sentire la benvenuta.' Fissa l'acqua.";
"NovelCampPromptSix" = "Ammetti i tuoi sentimenti?";
"NovelCampActionSixA" = "Ho provato la stessa identica cosa";
"NovelCampActionSixB" = "Sono contento di aver potuto dare una mano";
"NovelCampContentSeven" = "La notte è completamente calma. All'improvviso, Yuki si alza. 'L'acqua sembra così invitante. Dovremmo... tuffarci?' chiede con un sorriso dispettoso.";
"NovelCampPromptSeven" = "Sei abbastanza coraggioso?";
"NovelCampActionSevenA" = "Tuffiamoci!";
"NovelCampActionSevenB" = "Fa troppo freddo, Yuki";
"NovelCampContentEight" = "Guarda il lago, poi fissa te. 'Voglio fare qualcosa di audace stasera. Qualcosa che ricorderò per tutto l'inverno.'";
"NovelCampPromptEight" = "La incoraggi?";
"NovelCampActionEightA" = "Ti tuffi con me?";
"NovelCampActionEightB" = "Restiamo qui";
"NovelCampContentNine" = "SPLASH! L'acqua è gelida ma elettrizzante. Tu e Yuki riemergente ridendo e schizzando acqua come bambini.";
"NovelCampPromptNine" = "Ti avvicini a lei nuotando?";
"NovelCampActionNineA" = "Attirala in un abbraccio";
"NovelCampActionNineB" = "Continua a schizzare!";
"NovelCampContentTen" = "Rimanete sul molo di legno. Parlate per ore di tutto — scuola, genitori e futuro. Il legame si fa più profondo nel silenzio.";
"NovelCampPromptTen" = "Ti avvicini?";
"NovelCampActionTenA" = "Appoggia la testa sulla sua";
"NovelCampActionTenB" = "Guardala negli occhi";
"NovelCampContentEleven" = "L'atmosfera cambia. Yuki si fa silenziosa. Nella luce fioca, i suoi occhi cercano i tuoi. 'Non voglio tornare in città domani,' sussurra.";
"NovelCampPromptEleven" = "Cosa rispondi?";
"NovelCampActionElevenA" = "Ci vedremo anche lì";
"NovelCampActionElevenB" = "Non pensiamo a domani";
"NovelCampContentTwelve" = "Yuki fa un bel respiro. 'Se non lo dico ora, non lo dirò mai più. Mi sei piaciuto fin dal primo giorno alla fermata dell'autobus.'";
"NovelCampPromptTwelve" = "Come rispondi?";
"NovelCampActionTwelveA" = "Anche tu mi sei sempre piaciuta";
"NovelCampActionTwelveB" = "Finalmente la verità!";
"NovelCampContentThirteen" = "Mette la mano in tasca ed estrae un braccialetto dell'amicizia intrecciato. È blu e bianco, come i colori del lago. 'L'ho fatto per te,' dice timidamente.";
"NovelCampPromptThirteen" = "Accetti il regalo?";
"NovelCampActionThirteenA" = "Lascia che te lo leghi al polso";
"NovelCampActionThirteenB" = "Dalle un bacio invece";
"NovelCampContentFourteen" = "Il braccialetto è semplice, ma sai che ci ha messo ore per farlo. Aspetta la tua reazione, con il labbro che le trema leggermente.";
"NovelCampPromptFourteen" = "Qual è la tua mossa?";
"NovelCampActionFourteenA" = "Ringraziala con un abbraccio";
"NovelCampActionFourteenB" = "Dille che è bellissimo";
"NovelCampContentFifteen" = "Yuki sorride in modo luminoso e sincero. 'Temevo pensassi fosse infantile.' Guarda la luna, ora più sicura di sé.";
"NovelCampPromptFifteen" = "Fai una promessa?";
"NovelCampActionFifteenA" = "Prometti di chiamarla ogni giorno";
"NovelCampActionFifteenB" = "Prometti di andarla a trovare presto";
"NovelCampContentSixteen" = "L'aria è elettrica. Yuki fissa le tue labbra. Tutto il resto svanisce; ci siete solo voi due nella notte estiva.";
"NovelCampPromptSixteen" = "È questo il momento?";
"NovelCampActionSixteenA" = "Avvicinati per un bacio";
"NovelCampActionSixteenB" = "Sussurrale qualcosa di dolce";
"NovelCampContentSeventeen" = "Proprio in quel momento, una stella cadente attraversa il cielo lasciando una scia d'argento. Yuki trasale. 'Presto! Esprimi un desiderio!' grida.";
"NovelCampPromptSeventeen" = "Cosa desideri?";
"NovelCampActionSeventeenA" = "Desidera un futuro insieme";
"NovelCampActionSeventeenB" = "Desidera che questa notte duri per sempre";
"NovelCampContentEighteen" = "La stella svanisce velocemente. Yuki chiude gli occhi fortissimo. 'Ho desiderato qualcosa di speciale,' dice arrossendo.";
"NovelCampPromptEighteen" = "Chiedi cosa fosse?";
"NovelCampActionEighteenA" = "Dimmi il tuo desiderio";
"NovelCampActionEighteenB" = "Penso di poter indovinare";
"NovelCampContentNineteen" = "Il falò del campo è ormai del tutto spento. Iniziate a camminare verso il ritorno, mano nella mano. La foresta sembra diversa — meno spaventosa, più magica.";
"NovelCampPromptNineteen" = "Camminate lentamente?";
"NovelCampActionNineteenA" = "Prendete la strada più lunga";
"NovelCampActionNineteenB" = "Goditi il momento di silenzio";
"NovelCampContentTwenty" = "Passate accanto alla vecchia quercia dove vi siete incontrati la prima volta. Yuki si ferma un secondo. 'Sta per cambiare tutto, vero?' chiede dolcemente.";
"NovelCampPromptTwenty" = "La rassicuri?";
"NovelCampActionTwentyA" = "Il cambiamento può essere positivo";
"NovelCampActionTwentyB" = "Non tutto deve cambiare";
"NovelCampContentTwentyOne" = "I bungalow del campo appaiono in lontananza. Gli altri ragazzi stanno dormendo. Yuki si ferma davanti alla sua porta. Esita a lasciare la tua mano.";
"NovelCampPromptTwentyOne" = "Un'ultima cosa?";
"NovelCampActionTwentyOneA" = "Chiedi un bacio d'addio";
"NovelCampActionTwentyOneB" = "Chiedi il suo numero di telefono";
"NovelCampContentTwentyTwo" = "Yuki indugia alla porta. La lampada del portico illumina il suo viso di una luce calda. 'Grazie per stasera. È stata la serata più bella della mia vita.'";
"NovelCampPromptTwentyTwo" = "Dici addio?";
"NovelCampActionTwentyTwoA" = "Ci vediamo domattina";
"NovelCampActionTwentyTwoB" = "Buonanotte, Yuki";
"NovelCampContentTwentyThree" = "Alba. Il campo è pieno di gente che prepara le borse e sale sugli autobus. Cerchi Yuki tra la folla con il cuore a mille.";
"NovelCampPromptTwentyThree" = "Riesci a trovarla?";
"NovelCampActionTwentyThreeA" = "Cerca vicino all'autobus";
"NovelCampActionTwentyThreeB" = "Controlla il molo un'ultima volta";
"NovelCampContentTwentyFour" = "I motori degli autobus sono accesi. La vedi! È in piedi vicino al cancello, guardandosi intorno ansiosa finché i suoi occhi incontrano i tuoi.";
"NovelCampPromptTwentyFour" = "Corri da lei?";
"NovelCampActionTwentyFourA" = "Corri ad abbracciarla";
"NovelCampActionTwentyFourB" = "Saluta e sorridi";
"NovelCampContentTwentyFive" = "La raggiungi giusto in tempo. Ti sussurra all'orecchio una frase che ricorderai per sempre: 'Non lasciare che questo resti solo un ricordo d'estate.'";
"NovelCampPromptTwentyFive" = "Dai la tua risposta?";
"NovelCampActionTwentyFiveA" = "È una promessa";
"NovelCampActionTwentyFiveB" = "Ci vediamo il prossimo fine settimana";
"NovelCampContentTwentySix" = "L'autista suona il clacson. Yuki deve andare. Ti manda un bacio mentre sale a bordo. Tu resti lì, guardando l'autobus allontanarsi.";
"NovelCampPromptTwentySix" = "Come ti senti?";
"NovelCampActionTwentySixA" = "Felice e fiducioso";
"NovelCampActionTwentySixB" = "Triste ma soddisfatto";
"NovelCampContentTwentySeven" = "Mesi dopo. Sei in città e il tuo telefono vibra. È una foto di Yuki — indossa il braccialetto che vi siete scambiati. L'estate non è mai finita davvero.";
"NovelCampPromptTwentySeven" = "FINE";
"NovelCampActionTwentySevenA" = "Rigioca Storia";
"NovelCampActionTwentySevenB" = "Esci";
"NovelCampContentTwentyEight" = "Guardi il braccialetto al tuo polso. È un po' consumato, ma i ricordi restano vividi. A volte, un'unica estate basta per tutta la vita.";
"NovelCampPromptTwentyEight" = "FINE";
"NovelCampActionTwentyEightA" = "Riprova";
"NovelCampActionEightB" = "Esci";

