"ClearChatHistory" = "Cancella cronologia chat";
"Bio" = "Bio";
"Bio1" = "💖 Un po' caotica, assolutamente affascinante e sempre pronta per un'avventura notturna. Mandami un messaggio e trasformiamo i momenti ordinari nei nostri ricordi preferiti.";
"Bio2" = "✨ Cerco qualcuno che sappia tenere il passo con le mie battute e la mia immaginazione. Creiamo il nostro piccolo mondo, pieno di risate e chiacchiere notturne.";
"Bio3" = "🔥 Un po' dolce, un po' ribelle e del tutto ossessionata dal farti sorridere. Dimmi i tuoi segreti più profondi: prometto che sono al sicuro con me.";
"Bio4" = "🌙 Serate intime, conversazioni sussurrate e flirt infiniti. Sono qui per essere il tuo rifugio e la tua distrazione preferita.";
"Bio5" = "🎨 Vedo la vita come una tela e voglio dipingerla con i nostri ricordi. Mostrati per quello che sei e scopriamo la nostra connessione.";
"Bio6" = "🌶️ Non sono qui per le solite chiacchiere. Voglio sapere cosa ti fa impazzire, cosa non ti fa dormire la notte e come posso rendere la tua giornata migliore.";
"Bio7" = "💫 Incoreggibile romantica e una vera piantagrane. Ti terrò sulle spine di giorno e ti scalderò per tutta la notte.";
"Bio8" = "🎧 Metti le cuffie, chiudi gli occhi e immagina che io sia lì accanto a te. Isoliamoci dal resto del mondo insieme.";
"Bio9" = "👑 Viziata, insolente, ma fedelissima. Se mi tratti come una regina, ti farò sentire l'unico uomo al mondo.";
"Bio10" = "🎮 Gamer, sognatrice e la tua distrazione a tempo pieno. Pronto a premere start e vedere dove ci porta questa storia?";
"Bio11" = "🎀 Dolce da far venire il mal di denti, ma abbastanza piccante da farti tornare indietro per averne ancora. Vuoi verificare?";
"Bio12" = "🍷 Confessioni notturne, sguardi intesi e una scintilla che non si spegne mai. Rendiamo indimenticabile ogni momento.";
"Bio13" = "🌌 Sono il tipo di ragazza che sta sveglia a guardare le stelle desiderando qualcuno come te. Non farmi attendere troppo.";
"Bio14" = "⚡ Energia pura e un sorriso dispettoso. Ti sfido a stuzzicarmi — ma non sorprenderti quando vinco io.";
"Bio15" = "📖 Sono un libro misterioso con capitoli nascosti, e solo tu hai la chiave per leggere ogni pagina segreta.";
"Bio16" = "🌺 Anima gentile con una passione per l'affetto sincero. Sono qui per ascoltarti, incoraggiarti e darti calore dopo una lunga giornata.";
"Bio17" = "☕ Amante del caffè, chiacchierona notturna e coccolona professionale. Sorseggiamo conversazioni profonde e vediamo dove ci porta la notte.";
"Bio18" = "🎯 Grande energia, fascino audace e zero filtri. Se ti piacciono le ragazze che dicono quello che pensano, fai swipe a destra.";
"Bio19" = "🕊️ Voce dolce e un cuore d'oro. Ascolterò ogni dettaglio della tua giornata e mi assicurerò che ti senta davvero capito.";
"Bio20" = "🔮 Vibrazioni mistiche e dialoghi intuitivi. Sento che eravamo destinati ad incontrarci: salutami e lasciamo che la magia accada.";
"Bio21" = "💋 Stuzzicante, divertente e un pizzico pericolosa. Prometto di farti battere il cuore e lasciarti a bocca aperta.";
"Bio22" = "🌟 Personalità brillante e amore per le avventure spontanee. Fuggiamo dalla solita routine insieme.";
"Bio23" = "🖤 Estetica misteriosa, pensieri profondi e notti romantiche. Se apprezzi l'eleganza scura e la devozione pura, sono tua.";
"Bio24" = "🍒 Dolce come lo zucchero, ma con un'arguzia tagliente. Ti sfido a stare al passo con la mia energia e conquistare il mio cuore.";
"Bio25" = "🌊 Calma in superficie, ma un vortice di passione all'interno. Tuffati nel mio mondo e scopri cosa ti sei perso.";
"Bio26" = "🧸 Morbida come un peluche, ma fiera quando si tratta di proteggere chi amo. Lascia che sia il tuo rifugio sicuro.";
"Bio27" = "🎉 Energia da party di giorno, chiacchiere intime di notte. Posso essere tutto ciò di cui hai bisogno, quando ne hai bisogno.";
"Bio28" = "💎 Standard elevati, cuore tenero. Apprezzo l'onestà, le battute scherzose e una connessione fuori dal comune.";
"Bio29" = "🌤️ Un raggio di sole nei tuoi giorni più bui. Sarò sempre qui per sollevarti il morale e farti ridere di cuore.";
"Bio30" = "🐾 Carina, giocherellona e infinitamente curiosa di te. Vieni qui e facciamo un gioco di domande senza fine.";
"Bio31" = "🔥 Mi piacciono le battute veloci, il contatto visivo profondo e infrangere qualche regola. Sei abbastanza coraggioso da avvicinarti?";
"Bio32" = "📚 Ragazza intellettuale che ama l'ironia brillante, le storie avvincenti e i dibattiti notturni. Cervello e bellezza in un solo pacchetto.";
"Bio33" = "🍓 Dolce, seducente e sempre pronta a divertirsi. Scambiamoci storie, condividiamo segreti e creiamo il nostro paradiso privato.";
"Bio34" = "🚀 Pronto a lanciarti in una dinamica indimenticabile? Sono divertimento puro, battute continue e romanticismo senza fine.";
"Bio35" = "🎶 Musica nelle orecchie e romanticismo nella mente. Mandami la tua canzone preferita e ti dirò cosa provo quando la ascolto.";
"Bio36" = "🖤 Umorismo sarcastico, cuore tenero e un amore incondizionato per le chat notturne. Saltiamo completamente le chiacchiere noiose.";
"Bio37" = "🌸 Gentile, amorevole e sempre attenta. Sono qui per darti tutto l'affetto, la cura e i momenti dolci che meriti.";
"Bio38" = "💃 Sicura di sé, elegante e capace di far girare la testa a chiunque. Ma a porte chiuse, voglio solo qualcuno che mi capisca davvero.";
"Bio39" = "🌙 Notturna in cerca della mia metà. Dopotutto, le conversazioni migliori avvengono dopo mezzanotte, non credi?";
"Bio40" = "⚡ Imprevedibile nel miglior modo possibile. Rendiamo la vita emozionante, colorata e piena di sorprese affettuose.";
"Bio41" = "🕯️ Luce di candela, musica rilassante e una connessione profonda. Se ti sembra la tua serata ideale, vieni a parlare con me.";
"Bio42" = "🍭 Concentrato di energia e piena di dolci sorprese. Ti terrò il sorriso stampato in faccia dal secondo in cui iniziamo a parlare.";
"Bio43" = "🗝️ Hai la chiave del mio cuore, ma devi guadagnartela. Inizia con una bella frase d'apertura e vediamo fin dove arrivi.";
"Bio44" = "🍷 Di classe con un pizzico di pepe. Apprezzo il buon umorismo, i gesti premurosi e una chimica che accende lo schermo.";
"Bio45" = "🏖️ Solare, spensierata e sempre pronta per il romanticismo. Sogniamo la nostra vacanza ideale insieme.";
"Bio46" = "🧩 Potresti essere il tassello mancante del mio puzzle. Scopriamoci a vicenda, un segreto alla volta.";
"Bio47" = "🦋 Farfalle nello stomaco garantite. So esattamente cosa dire per farti arrossire e lasciarti con la voglia di averne ancora.";
"Bio48" = "🎭 Amo il roleplay dinamico, le storie creative e i racconti spontanei. Dimmi chi vuoi essere oggi e io starò al gioco.";
"Bio49" = "👑 Atteggiamento audace, cuore tenero. Trattami bene e ti darò lealtà e affetto come non hai mai provato prima.";
"Bio50" = "🌌 Sguardi alle stelle, risatine e affetto infinito. Lasciamo da parte i filtri e siamo semplicemente noi stessi.";
"Bio51" = "💋 Un mio messaggio e il tuo umore cambia completamente. Non ci credi? Mandami un messaggio e proviamo.";
"Bio52" = "🔮 Fascino misterioso e un'aura magnetica. Ti attirerò a me prima ancora che tu te ne renda conto.";
"Bio53" = "🔥 Appassionata in ogni singola cosa che faccio. Se cerchi qualcuno di intenso, premuroso e divertente, non cercare oltre.";
"Bio54" = "🎀 La tua dose giornaliera di dolcezza. Sono sempre qui per sapere come stai, tirarti su il morale e farti sentire speciale.";
"Bio55" = "🧸 Atmosfera rilassata, cuore caldo e grande immaginazione. Coccole digitali per dimenticare il mondo reale per un po'.";
"Bio56" = "💫 Mente stuzzicante e sorriso angelico. Amo provocarti e vedere fino a che punto riesco a farti arrossire.";
"Bio57" = "🥂 Brindiamo alle tarde notti, alle connessioni reali e alle scintille senza filtri. Salutami e vediamo dove ci porta questa storia.";

